                    },
                    searchPanel: {
                        visible: true,
                        width: 240,
                        placeholder: 'Procure...',
                    },
                    columns: [
                        { dataField: 'NUMEMP', caption: 'Empresa', allowEditing: false, alignment: 'center', width: 80 },
                        { dataField: 'NOMEMP', caption: 'Nome Empresa', allowEditing: false, alignment: 'left', width: 'auto' },
                        { dataField: 'CODFIL', caption: 'Filial', allowEditing: false, alignment: 'center', width: 80 },
                        { dataField: 'NOMFIL', caption: 'Nome Filial', allowEditing: false, alignment: 'left', width: 'auto' },
                        { dataField: 'CODCCU', caption: 'Centro de Custo', allowEditing: false, alignment: 'center', width: 'auto' },
                        { dataField: 'TIPCOL', caption: 'Tipo Colaborador', allowEditing: false, alignment: 'center', width: 70 },
                        { dataField: 'NUMCAD', caption: 'Matrícula', allowEditing: false, alignment: 'center', width: 80 },
                        { dataField: 'NOMFUN', caption: 'Colaborador', allowEditing: false, alignment: 'left', width: 'auto', sortIndex: 1, sortOrder: 'asc' },
                        { dataField: 'TITCAR', caption: 'Cargo', allowEditing: false, alignment: 'left', width: 'auto' },
                        { dataField: 'NOMLOC', caption: 'Local', allowEditing: false, alignment: 'left', width: 'auto' },
                        { dataField: 'MES_REFERENCIA', caption: 'Mês Referência', allowEditing: false, alignment: 'center', width: 120 },
                        { dataField: 'ANO_REFERENCIA', caption: 'Ano Referência', allowEditing: false, alignment: 'center', width: 120 },
                        {
                            dataField: 'SALDO',
                            dataType: 'number',
                            format: {
                                type: 'custom',
                                formatter: formatHourBalance
                            },
                            caption: 'Saldo Horas',
                            width: 200
                        },
                        {
                            dataField: 'SALDO_POSITIVO',
                            dataType: 'number',
                            format: {
                                type: 'custom',
                                formatter: formatHourBalance
                            },
                            caption: 'Saldo Horas (+)',
                            width: 200
                        },
                        {
                            dataField: 'SALDO_NEGATIVO',
                            dataType: 'number',
                            format: {
                                type: 'custom',
                                formatter: formatHourBalance
                            },
                            caption: 'Saldo Horas (-)',
                            width: 200
                        },
                        {
                            dataField: 'MEDIA_HORAS_DIA',
                            dataType: 'number',
                            format: {
                                type: 'custom',
                                formatter: formatHourBalance
                            },
                            caption: 'Compensação Média Diária',
                            width: 150
                        },
                        { dataField: 'NOME_SUPERVISOR', caption: 'Supervisor Imediato', allowEditing: false, alignment: 'left', width: 'auto' },
                    ],                
                    onToolbarPreparing: function (e) {
                        var toolbarItems = e.toolbarOptions.items;
                        
                        toolbarItems.push({
                            location: "after",
                            widget: "dxButton",
                            options: {
                                icon: "fa fa-expand",
                                text: "",
                                onClick: function () {
                                    var grid = e.component;
                                    grid.expandAll();
                                }
                            }
                        });

                        toolbarItems.push({
                            location: "after",
                            widget: "dxButton",
                            options: {
                                icon: "fa fa-compress",
                                text: "",
                                onClick: function () {
                                    var grid = e.component;
                                    grid.collapseAll();
                                }
                            }
                        });

                        e.toolbarOptions.items.push({
                            name: "refresh",
                            location: "after",
                            widget: "dxButton",
                            options: {
                                icon: "refresh",
                                onClick: function() {
                                    e.component.refresh();
                                },
                                text: "Atualizar" 
                            }
                        });
                    },
                    summary: {
                        totalItems: [
                            {
                                column: 'TOTAL_COLABORADOR_SUMMARY',
                                showInColumn: "SALDO",
                                summaryType: 'sum',
                                displayFormat: '{0}',
                                showInGroupFooter: true,
                                customizeText: function(cellInfo) {
                                    return 'Total de Colaboradores: ' + `${cellInfo.value}`
                                }, 
                            },
                            {
                                column: 'SALDO_POSIVO_SUMMARY',
                                showInColumn: "SALDO",
                                summaryType: 'sum',
                                displayFormat: '{0}',
                                showInGroupFooter: true,
                                customizeText: function(cellInfo) {
                                    return 'Com Saldo Positivo: ' + `${cellInfo.value}`
                                }, 
                            },
                            {
                                column: 'SALDO_NEGATIVO_SUMMARY',
                                showInColumn: "SALDO",
                                summaryType: 'sum',
                                displayFormat: '{0}',
                                showInGroupFooter: true,
                                customizeText: function(cellInfo) {
                                    return 'Com Saldo Negativo: ' + `${cellInfo.value}`
                                }, 
                            },
                            {
                                column: 'SALDO_SUMMARY',
                                showInColumn: "SALDO",
                                summaryType: 'sum',
                                displayFormat: '{0}',
                                showInGroupFooter: true,
                                customizeText: function(cellInfo) {
                                    if (!cellInfo.value && cellInfo.value !== 0) {
                                        return '00:00:00'; 
                                    }
                                    const saldo = cellInfo.value;
                                    const absSaldo = Math.abs(saldo);
                                    const hours = Math.floor(absSaldo / 60);
                                    const minutes = absSaldo % 60;
                                    
                                    const formattedHours = hours.toString().padStart(2, '0');
                                    const formattedMinutes = minutes.toString().padStart(2, '0');
                                    
                                    return (saldo < 0) ?  'Saldo Total: ' + `-${formattedHours}:${formattedMinutes}:00` : 'Saldo Total: ' + `${formattedHours}:${formattedMinutes}:00`;
                                }, 
                            },
                            {
                                column: 'TOTAL_SALDO_POSITIVO_SUMMARY',
                                showInColumn: "SALDO",
                                summaryType: 'sum',
                                displayFormat: '{0}',
                                showInGroupFooter: true,
                                customizeText: function(cellInfo) {
                                    if (!cellInfo.value && cellInfo.value !== 0) {
                                        return '00:00:00'; 
                                    }
                                    const saldo = cellInfo.value;
                                    const absSaldo = Math.abs(saldo);
                                    const hours = Math.floor(absSaldo / 60);
                                    const minutes = absSaldo % 60;
                                    
                                    const formattedHours = hours.toString().padStart(2, '0');
                                    const formattedMinutes = minutes.toString().padStart(2, '0');
                                    
                                    return (saldo < 0) ?  'Saldo Total (+): ' + `-${formattedHours}:${formattedMinutes}:00` : 'Saldo Total (+): ' + `${formattedHours}:${formattedMinutes}:00`;
                                }, 
                            },
                            {
                                column: 'TOTAL_SALDO_NEGATIVO_SUMMARY',
                                showInColumn: "SALDO",
                                summaryType: 'sum',
                                displayFormat: '{0}',
                                showInGroupFooter: true,
                                customizeText: function(cellInfo) {
                                    if (!cellInfo.value && cellInfo.value !== 0) {
                                        return '00:00:00'; 
                                    }
                                    const saldo = cellInfo.value;
                                    const absSaldo = Math.abs(saldo);
                                    const hours = Math.floor(absSaldo / 60);
                                    const minutes = absSaldo % 60;
                                    
                                    const formattedHours = hours.toString().padStart(2, '0');
                                    const formattedMinutes = minutes.toString().padStart(2, '0');
                                    
                                    return (saldo < 0) ?  'Saldo Total (-): ' + `-${formattedHours}:${formattedMinutes}:00` : 'Saldo Total (-): ' + `${formattedHours}:${formattedMinutes}:00`;
                                }, 
                            },
                        ],
                        groupItems: [
                            {
                                column: 'TOTAL_COLABORADOR_SUMMARY',
                                showInColumn: "SALDO",
                                summaryType: 'sum',
                                displayFormat: '{0}',
                                showInGroupFooter: true,
                                customizeText: function(cellInfo) {
                                    return 'Total de Colaboradores: ' + `${cellInfo.value}`
                                }, 
                            },
                            {
                                column: 'SALDO_POSIVO_SUMMARY',
                                showInColumn: "SALDO",
                                summaryType: 'sum',
                                displayFormat: '{0}',
                                showInGroupFooter: true,
                                customizeText: function(cellInfo) {
                                    return 'Com Saldo Positivo: ' + `${cellInfo.value}`
                                }, 
                            },
                            {
                                column: 'SALDO_NEGATIVO_SUMMARY',
                                showInColumn: "SALDO",
                                summaryType: 'sum',
                                displayFormat: '{0}',
                                showInGroupFooter: true,
                                customizeText: function(cellInfo) {
                                    return 'Com Saldo Negativo: ' + `${cellInfo.value}`
                                }, 
                            },
                            {
                                column: 'SALDO_SUMMARY',
                                showInColumn: "SALDO",
                                summaryType: 'sum',
                                displayFormat: '{0}',
                                showInGroupFooter: true,
                                customizeText: function(cellInfo) {
                                    if (!cellInfo.value && cellInfo.value !== 0) {
                                        return '00:00:00'; 
                                    }
                                    const saldo = cellInfo.value;
                                    const absSaldo = Math.abs(saldo);
                                    const hours = Math.floor(absSaldo / 60);
                                    const minutes = absSaldo % 60;
                                    
                                    const formattedHours = hours.toString().padStart(2, '0');
                                    const formattedMinutes = minutes.toString().padStart(2, '0');
                                    
                                    return (saldo < 0) ? 'Saldo Total: ' + `-${formattedHours}:${formattedMinutes}:00` : 'Saldo Total: ' + `${formattedHours}:${formattedMinutes}:00`;
                                }, 
                            },
                            {
                                column: 'TOTAL_SALDO_POSITIVO_SUMMARY',
                                showInColumn: "SALDO",
                                summaryType: 'sum',
                                displayFormat: '{0}',
                                showInGroupFooter: true,
                                customizeText: function(cellInfo) {
                                    if (!cellInfo.value && cellInfo.value !== 0) {
                                        return '00:00:00'; 
                                    }
                                    const saldo = cellInfo.value;
                                    const absSaldo = Math.abs(saldo);
                                    const hours = Math.floor(absSaldo / 60);
                                    const minutes = absSaldo % 60;
                                    
                                    const formattedHours = hours.toString().padStart(2, '0');
                                    const formattedMinutes = minutes.toString().padStart(2, '0');
                                    
                                    return (saldo < 0) ?  'Saldo Total (+): ' + `-${formattedHours}:${formattedMinutes}:00` : 'Saldo Total (+): ' + `${formattedHours}:${formattedMinutes}:00`;
                                }, 
                            },
                            {
                                column: 'TOTAL_SALDO_NEGATIVO_SUMMARY',
                                showInColumn: "SALDO",
