<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Recursos Humanos</h1>
    </div>
    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Banco Horas</p>

                    <div id="form-container">
                        <div id="form-filtro"></div> 
                    </div>
                    <!-- Grid Container for the DataGrid -->
                    <div id="gridContainer"></div>

                    <!-- Container for the Totals Grid - aligned to right -->
                    <div class="row mt-3">
                        <div class="col-md-3 offset-md-9">
                            <div id="gridTotalsContainer"></div>
                        </div>
                    </div>
                </div>
