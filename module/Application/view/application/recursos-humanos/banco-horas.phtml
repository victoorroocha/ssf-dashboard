<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Recursos Humanos</h1>
    </div>

    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Banco Horas</p>

                    <div id="form-container">
                        <div id="form-filtro"></div> 
                    </div>
                    <!-- Grid Container for the DataGrid -->
                    <div id="gridContainer"></div>

                    <!-- Container for the Totals Grid - aligned to right -->
                    <div class="row mt-3">
                        <div class="col-md-3 offset-md-9">
                            <div id="gridTotalsContainer"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /.container-fluid -->

<script>
    $(document).ready(function() {
        var dataGrid = null;
        let totalsGrid = null;

        // Inicializa o formulário
        const formInstance = $("#form-filtro").dxForm({
            formData: {},
            colCount: 1,
            items: [
                {
                    itemType: "group",
                    colCount: 2,
                    items: [
                        {
                            dataField: "colaborador",
                            editorType: "dxSelectBox",
                            label: { visible: false },
                            editorOptions: getSelectBoxOptions("/recursos-humanos/get-lookup-colaborador", "DSC", "ID", "Selecione o Colaborador")
                        },
                        {
                            dataField: "supervisor",
                            editorType: "dxSelectBox",
                            label: { visible: false },
                            editorOptions: getSelectBoxOptions("/recursos-humanos/get-lookup-supervisor", "DSC", "ID", "Selecione o Supervisor")
                        }
                    ]
                },
                {
                    itemType: "group",
                    colCount: 3,
                    items: [
                        {
                            dataField: "centroCusto",
                            editorType: "dxSelectBox",
                            label: { visible: false },
                            editorOptions: getSelectBoxOptions("/recursos-humanos/get-lookup-centro-custo", "DSC", "ID", "Selecione o Centro de Custo")
                        },
                        {
                            dataField: "filial",
                            editorType: "dxSelectBox",
                            label: { visible: false },
                            editorOptions: getSelectBoxOptions("/recursos-humanos/get-lookup-filial", "DSC", "ID", "Selecione a Filial")
                        },  
                        {
                            dataField: "local",
                            editorType: "dxSelectBox",
                            label: { visible: false },
                            editorOptions: getSelectBoxOptions("/recursos-humanos/get-lookup-local", "DSC", "ID", "Selecione a Local")
                        }
                    ]
                },
                {
                    itemType: "group",
                    colCount: 2,
                    items: [
                        {
                            dataField: "dataInicial",
                            label: { visible: false },
                            editorType: "dxDateBox",
                            editorOptions: {
                                displayFormat: "MM/yyyy",         
                                dateSerializationFormat: "yyyy-MM-dd", 
                                placeholder: "Mês/Ano inicial",
                                type: "date",                      
                                calendarOptions: {
                                    zoomLevel: "year", 
                                    maxZoomLevel: "year",
                                    minZoomLevel: "month",
                                }
                            },
                            validationRules: [{
                                type: 'required',
                                message: 'Período é obrigatório.',
                            }],
                        },
                        {
                            dataField: "dataFinal",
                            label: { visible: false },
                            editorType: "dxDateBox",
                            editorOptions: {
                                displayFormat: "MM/yyyy",
                                dateSerializationFormat: "yyyy-MM-dd",
                                placeholder: "Mês/Ano final",
                                type: "date",
                                calendarOptions: {
                                    zoomLevel: "year", 
                                    maxZoomLevel: "year",
                                    minZoomLevel: "month",
                                }
                            },
                        }
                    ]
                },
                {
                    itemType: "button",
                    buttonOptions: {
                        text: "FILTRAR",
                        type: "success",
                        onClick: function() {
                             // Instância do formulário
                             var formInstance = $("#form-filtro").dxForm("instance");
                             var button = this; // Referência ao botão

                            // Validação do formulário
                            var validationResult = formInstance.validate();  // Valida o formulário

                            // Verifica se o formulário é válido
                            if (validationResult.isValid) {
                                // Desabilita o botão
                                button.option("disabled", true);
                                
                                // Opcional: Mostrar um indicador de carregamento
                                button.option("text", "Processando...");

                                // Se o formulário for válido, captura os dados
                                const formData = formInstance.option("formData");

                                // Chamar a função que atualiza a grid com os filtros
                                atualizarGrid(formData).finally(function() {
                                    // Reabilita o botão independente do resultado
                                    button.option("disabled", false);
                                    button.option("text", "FILTRAR");
                                });

                            } else {
                                // Se o formulário for inválido
                                DevExpress.ui.notify("Por favor, corrija os erros de validação.", "error", 3000);
                            }

                        }
                    }
                }
            ]
        }).dxForm("instance");

        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: "raw",
                    load: function() {
                        return $.ajax({
                            url: url,
                            method: "GET",
                            dataType: "json"
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, "error", 3000);
                                return [];
                            }
                        }).catch(error => {
                            DevExpress.ui.notify("Erro ao buscar dados!", "error", 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true,
            };
        }

        // Função que será chamada ao clicar no botão FILTRAR
        function atualizarGrid(filtros) {
            // Destroi sempre a grid antes de inicia-la novamente.
            if (dataGrid != null) {
                if (dataGrid.instance) {
                    dataGrid.dispose();
                }
            }
            if (totalsGrid != null && totalsGrid.instance) {
                totalsGrid.dispose();
            }

            return new Promise((resolve, reject) => {
                dataGrid = $('#gridContainer').dxDataGrid({
                    dataSource: new DevExpress.data.CustomStore({
                        loadMode: "processed",
                        load: function(loadOptions) {
                            let params = filtros;

                            return $.ajax({
                                url: '/recursos-humanos/list-banco-horas',
                                method: 'GET',
                                dataType: 'json',
                                data: params, 
                            }).then(response => {
                                if (response.success) {
                                    resolve(); // Resolve a Promise quando a requisição for bem-sucedida
                                    return {
                                        data: response.data,
                                        totalCount: response.totalCount 
                                    };
                                } else {
                                    reject(); // Rejeita a Promise em caso de erro
                                    DevExpress.ui.notify(response.message, "error", 3000);
                                    return { data: [], totalCount: 0 };
                                }
                            }).catch(error => {
                                reject(); // Rejeita a Promise em caso de erro
                                console.log('error', error);
                                if (error.responseJSON) {
                                    DevExpress.ui.notify(error.responseJSON.message, "error", 3000);
                                    return { data: [], totalCount: 0 };
                                } else {
                                    DevExpress.ui.notify("Erro ao buscar dados!", "error", 3000);
                                    return { data: [], totalCount: 0 };
                                }
                            });
                        }
                    }),
                    height: 600,
                    width: '100%',
                    columnAutoWidth: true,
                    elementAttr: {
                        class: "grid-personalizada"
                    },
                    showBorders: true,
                    columnChooser: {
                        enabled: true,
                        mode: "dragAndDrop",
                        position: { 
                            my: "right", 
                            at: "right", 
                            of: ".dx-datagrid-column-chooser-button" 
                        }
                    },
                    groupPanel: {
                        visible: true,
                    },
                    toolbar: {
                        items: [
                            {
                                location: "after",
                                widget: "dxButton",
                                options: {
                                    icon: "fa fa-expand",
                                    text: "",
                                    onClick: function () {
                                        var grid = $("#gridContainer").dxDataGrid("instance");
                                        grid.expandAll();
                                    }
                                }
                            },
                            {
                                location: "after",
                                widget: "dxButton",
                                options: {
                                    icon: "fa fa-compress",
                                    text: "",
                                    onClick: function () {
                                        var grid = $("#gridContainer").dxDataGrid("instance");
                                        grid.collapseAll();
                                    }
                                }
                            },
                            {
                                name: "refresh",
                                location: "after",
                                widget: "dxButton",
                                options: {
                                    icon: "refresh",
                                    onClick: function() {
                                        $("#gridContainer").dxDataGrid("instance").refresh();
                                    },
                                    text: "Atualizar"
                                }
                            }
                        ]
                    },
                    editing: {
                        mode: 'batch',
                        allowUpdating: false,
                        allowDeleting: false,
                    },
                    selection: {
                        mode: 'multiple',
                        showCheckBoxesMode: 'none'
                    },
                    hoverStateEnabled: true,
                    pager: {
                        visible: false
                    },
                    paging: {
                        pageSize: 500
                    },
                    headerFilter: {
                        visible: true,
                    },
                    filterRow: {
                        visible: true,
                        applyFilter: 'auto',
                    },
                    export: {
                        enabled: true,
                        fileName: "Saldo Banco de Horas",
                        allowExportSelectedData: false,
                    },
                    searchPanel: {
                        visible: true,
                        width: 240,
                        placeholder: 'Procure...',
                    },
                    columns: [
                        { dataField: 'NUMEMP', caption: 'Empresa', allowEditing: false, alignment: 'center', width: 80 },
                        { dataField: 'NOMEMP', caption: 'Nome Empresa', allowEditing: false, alignment: 'left', width: 'auto' },
                        { dataField: 'TIPCOL', caption: 'Tipo Colaborador', allowEditing: false, alignment: 'center', width: 70 },
                        { dataField: 'NUMCAD', caption: 'Matrícula', allowEditing: false, alignment: 'center', width: 80 },
                        { dataField: 'NOMFUN', caption: 'Colaborador', allowEditing: false, alignment: 'left', width: 'auto', sortIndex: 1, sortOrder: 'asc' },
                        { dataField: 'TITCAR', caption: 'Cargo', allowEditing: false, alignment: 'left', width: 'auto' },
                        { dataField: 'NOMLOC', caption: 'Local', allowEditing: false, alignment: 'left', width: 'auto' },
                        { dataField: 'MES_REFERENCIA', caption: 'Mês Referência', allowEditing: false, alignment: 'center', width: 120 },
                        { dataField: 'ANO_REFERENCIA', caption: 'Ano Referência', allowEditing: false, alignment: 'center', width: 120 },
                        { 
                            caption: "Saldo",
                            alignment: 'center', width: 100, 
                            calculateCellValue: function(rowData) {
                                if (!rowData || rowData.SALDO === undefined || rowData.SALDO === null) {
                                    return '00:00:00'; 
                                }

                                const saldo = rowData.SALDO;
                                const absSaldo = Math.abs(saldo);
                                const hours = Math.floor(absSaldo / 60);
                                const minutes = absSaldo % 60;
                                
                                // Formatação com padding zero
                                const formattedHours = hours.toString().padStart(2, '0');
                                const formattedMinutes = minutes.toString().padStart(2, '0');
                                
                                if (saldo < 0) {
                                    return `-${formattedHours}:${formattedMinutes}:00`;
                                } else {
                                    return `${formattedHours}:${formattedMinutes}:00`;
                                }
                            }
                        },
                        { dataField: 'NOME_SUPERVISOR', caption: 'Supervisor Imediato', allowEditing: false, alignment: 'left', width: 'auto' },
                    ],                
                    onToolbarPreparing: function (e) {
                        var toolbarItems = e.toolbarOptions.items;
                        
                        toolbarItems.push({
                            location: "after",
                            widget: "dxButton",
                            options: {
                                icon: "fa fa-expand",
                                text: "",
                                onClick: function () {
                                    var grid = e.component;
                                    grid.expandAll();
                                }
                            }
                        });

                        toolbarItems.push({
                            location: "after",
                            widget: "dxButton",
                            options: {
                                icon: "fa fa-compress",
                                text: "",
                                onClick: function () {
                                    var grid = e.component;
                                    grid.collapseAll();
                                }
                            }
                        });

                        e.toolbarOptions.items.push({
                            name: "refresh",
                            location: "after",
                            widget: "dxButton",
                            options: {
                                icon: "refresh",
                                onClick: function() {
                                    e.component.refresh();
                                },
                                text: "Atualizar" 
                            }
                        });
                    },
                    onContentReady: function(e) {
                        calculateTotals(e.component);
                    }
                }).dxDataGrid('instance');
            });
        }

        function calculateTotals(mainGrid) {
            const data = mainGrid.getVisibleRows().map(row => row.data);

            // Agrupar os dados por NUMCAD, mantendo apenas o registro com a data mais recente (CMPLAN)
            const colaboradoresUnicos = data.reduce((acc, current) => {
                // Se o NUMCAD já existe no acumulador
                if (acc[current.NUMCAD]) {
                    // Compara as datas usando Moment.js (formato DD/MM/YY)
                    const currentDate = moment(current.CMPLAN, 'DD/MM/YY');
                    const existingDate = moment(acc[current.NUMCAD].CMPLAN, 'DD/MM/YY');
                    
                    // Mantém o registro com a data mais recente
                    if (currentDate.isAfter(existingDate)) {
                        acc[current.NUMCAD] = current;
                    }
                } else {
                    // Se o NUMCAD não existe, adiciona ao acumulador
                    acc[current.NUMCAD] = current;
                }
                return acc;
            }, {});

            // Converter o objeto de volta para array
            const colaboradoresFiltrados = Object.values(colaboradoresUnicos);

            // Calcular totais (exemplo - adapte conforme suas necessidades)
            const totalColaboradores = colaboradoresFiltrados.length;
            // Filtrar apenas os que têm saldo positivo
            const totalColaboradoresPositivos = colaboradoresFiltrados.filter(item => parseInt(item.SALDO) > 0).length;
            const totalColaboradoresNegativos = colaboradoresFiltrados.filter(item => parseInt(item.SALDO) < 0).length;
            
            const totalMinutes = colaboradoresFiltrados.reduce(
                (sum, item) => sum + parseInt(item.SALDO || 0), 
                0
            );
            const absTotalMinutes = Math.abs(totalMinutes);
            const hours = Math.floor(absTotalMinutes / 60);
            const minutes = absTotalMinutes % 60;
            const saldoTotal = `${totalMinutes < 0 ? '-' : ''}${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:00`;
            
            // Dados para a grid de totais
            const totalsData = [
                { description: 'Total de Colaboradores', value: totalColaboradores },
                { description: 'Com Saldo Positivo', value: totalColaboradoresPositivos },
                { description: 'Com Saldo Negativo', value: totalColaboradoresNegativos },
                { description: 'Saldo Total', value: saldoTotal }
            ];
            
            // Criar a grid de totais
            totalsGrid = $('#gridTotalsContainer').dxDataGrid({
                dataSource: totalsData,
                showBorders: true,
                showColumnHeaders: false,
                width: '100%',
                columns: [
                    { 
                        dataField: 'description', 
                        width: '70%',
                        cellTemplate: function(container, options) {
                            $('<div>')
                                .text(options.value)
                                .css('font-weight', 'bold')
                                .appendTo(container);
                        }
                    },
                    { 
                        dataField: 'value',
                        width: '30%',
                        alignment: 'right'
                    }
                ],
                onContentReady: function(e) {
                    // Ajustar altura da grid para se adequar ao conteúdo
                    e.component.option('height', 'auto');
                }
            }).dxDataGrid('instance');
        }
    });


    // Função para formatar a data
    function formatarData(data) {
        const date = new Date(data);
        const dia = ('0' + date.getDate()).slice(-2);
        const mes = ('0' + (date.getMonth() + 1)).slice(-2);
        const ano = date.getFullYear();
        return `${dia}/${mes}/${ano}`;
    }    

</script>
