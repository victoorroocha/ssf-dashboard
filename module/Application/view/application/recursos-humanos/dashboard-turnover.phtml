        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: "raw",
                    load: function() {
                        return $.ajax({
                            url: url,
                            method: "GET",
                            dataType: "json"
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, "error", 3000);
                                return [];
                            }
                        }).catch(error => {
                            DevExpress.ui.notify("Erro ao buscar dados!", "error", 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true,
                onValueChanged: function(e) {
                    atualizarInfosDashboad();
                }
            };
        }

        // Inicializa o Range Selector
        const today = moment();
        const startYear = 2025; // definido para pegar historico de 2023 pra k.
        const startOfMonth = today.clone().startOf('year');  // Primeiro dia do mês atual
        const endOfMonth = today.clone().endOf('year');     // Último dia do mês atual

        // Define valores iniciais nas variáveis globais
        formSelections.dataInicio = moment(startOfMonth.toDate()).format("YYYY-MM-DD"); 
        formSelections.dataFim = moment(endOfMonth.toDate()).format("YYYY-MM-DD");

        const rangeSelectorInstance = $("#range-selector").dxRangeSelector({
            width: '100%',
            scale: {
                startValue: moment(`${startYear}-01-01`).toDate(),
                endValue: today.clone().endOf('year').toDate(),
                minorTickInterval: "month",
                tickInterval: "month",
                useTicks: true,
                label: { format: "MMM yyyy" }
            },
            value: [startOfMonth.toDate(), endOfMonth.toDate()],  // Intervalo: primeiro dia do mês até o último dia
            sliderMarker: { format: "monthAndYear" },
            behavior: { callValueChanged: "onMovingComplete" }, // Alterado para "onMovingComplete"
            applyValueMode: "onHandleRelease",
            onInitialized: function(e) {
                atualizarInfosDashboad();
            },
            onValueChanged: function(e) {
                const startDate = moment(e.value[0]);
                const endDate = moment(e.value[1]).subtract(1, 'days'); // quando faz o changed sempre pega dia 01 do proximo mes ao selecionado. Tratei pra subtrair um dia, pegando o ultimo dia do mes selecionado.

                formSelections.dataInicio = moment(startDate.toDate()).format("YYYY-MM-DD");
                formSelections.dataFim = moment(endDate.toDate()).format("YYYY-MM-DD");
                
                atualizarInfosDashboad();
            }
        }).dxRangeSelector("instance");

    });

    // Função para atualizar informações do dashboard
    function atualizarInfosDashboad() {
        // Mostra o loading
        $('#globalLoading').show();

        const dataInicio = moment(formSelections.dataInicio, 'YYYY-MM-DD');
        const dataFim = moment(formSelections.dataFim, 'YYYY-MM-DD');

        let textoPeriodo = '';
        if (dataInicio.isSame(dataFim, 'month')) {
            textoPeriodo = dataInicio.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase());
        } else {
            textoPeriodo = `${dataInicio.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase())} à ${dataFim.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase())}`;
        }

        $('#periodo-apuracao').text(textoPeriodo);

        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/recursos-humanos/list-info-dashboard-turnover',
                method: 'GET',
                dataType: 'json',
                data: formSelections,
                success: function(response) {
                    if (response.success && response.data && response.data.infoCardsTurnover) {
                        const info = response.data.infoCardsTurnover;
                        if (info !== null) {
                            $('#valor-admitidos').text(info.ADMITIDOS || 0);
                            $('#valor-demissoes').text(info.DEMITIDOS || 0);
                            $('#valor-ativos').text(info.ATIVOS || 0);
                            $('#valor-tempo-medio').text(parseFloat(info.TEMPO_MEDIO_EMPRESA || 0).toFixed(1));
                            $('#valor-turnover').text(parseFloat(info.PERC_TURNOVER || 0).toFixed(1));
                        }
                    }

                    if (response.success && response.data && response.data.turnoverPorMes) {
                        const turnoverPorMes = response.data.turnoverPorMes;

                        // ==== Criação dos gráficos ====
                        criarGrafico("#grafico1", turnoverPorMes, "perc_turnover", "Turnover", "#1976d2", "%");
                        criarGrafico("#grafico2", turnoverPorMes, "ativos", "Ativos", "#616161");
                        criarGrafico("#grafico3", turnoverPorMes, "admitidos", "Admitidos", "#2e7d32");
                        criarGrafico("#grafico4", turnoverPorMes, "demitidos", "Demitidos", "#c62828");
                    }

                },
                error: function(error) {
                    DevExpress.ui.notify("Erro na requisição", "error", 3000);
                },
                complete: function() {
                    // Esconde o loading quando tudo estiver pronto
                    $('#globalLoading').hide();
                }
            });
        });
    }
    // Função auxiliar para criar gráfico com o mesmo padrão
    function criarGrafico(id, dataSource, valueField, name, color, sufixo = '') {
        $(id).dxChart({
            dataSource: dataSource,
            rotated: false,
            commonSeriesSettings: {
                argumentField: "mes",
                type: "line",
                label: {
                    visible: true,
                    backgroundColor: "transparent",
                    font: {
                        color: color,
                        weight: 600
                    },
                    customizeText: function (e) {
                        return sufixo === '%' 
                            ? (e.value).toFixed(1) + sufixo 
                            : e.value;
                    }
                }
            },
            series: [{
                valueField: valueField,
                name: name,
                color: color
            }],
            argumentAxis: {
                visible: true,
                label: { visible: false },
                tick: { visible: false },
                line: { visible: false },
                grid: { visible: false }
            },
            valueAxis: {
                visible: true,
                label: { visible: false },
                tick: { visible: false },
                line: { visible: false },
                grid: { visible: false }
            },
            legend: { visible: false },
            tooltip: {
                enabled: true,
                customizeTooltip: function (arg) {
                    return { text: arg.valueText + (sufixo || '') + ' ' + name };
                }
            },
            size: { height: "100%", width: "100%" }
        });
    }


