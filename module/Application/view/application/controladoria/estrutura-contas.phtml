<style>
    .dx-treelist .dx-treelist-expanded,
    .dx-treelist .dx-treelist-collapsed {
        filter: drop-shadow(0 0 1px #000);
    }
</style>

<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Controladoria</h1>
    </div>

    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Estrutura Contas</p>

                    <div id="treeListContainer"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /.container-fluid -->


<script>
    $(document).ready(function() {
        $('#treeListContainer').dxTreeList({
            dataSource: new DevExpress.data.CustomStore({
                key: 'id',
                loadMode: 'processed',
                load: function () {
                    return $.ajax({
                        url: '/controladoria/listar-plano-conta',
                        method: 'GET',
                        dataType: 'json',
                    }).then(response => {
                        if (response.success) {
                            return response.data;
                        } else {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                            return [];
                        }
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao carregar menus!', 'error', 3000);
                        return [];
                    });
                },
                insert: function (values) {
                    return $.ajax({
                        url: '/controladoria/inserir-plano-conta',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(values),
                        dataType: 'json',
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        }
                        return response;
                    });
                },
                update: function (key, values) {
                    return $.ajax({
                        url: '/controladoria/atualizar-plano-conta',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key, ...values }),
                        dataType: 'json',
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        }
                        return response;
                    });
                },
                remove: function (key) {
                    return $.ajax({
                        url: '/controladoria/excluir-plano-conta',
                        method: 'DELETE',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key }),
                        dataType: 'json',
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        }
                        return response;
                    });
                },
            }),
            keyExpr: 'id',
            parentIdExpr: 'parent_id',
            hoverStateEnabled: true,
            rowAlternationEnabled: false,
            showBorders: true,
            columnLines: true,
            rowLines: true,
            wordWrapEnabled: true,
            columnAutoWidth: true,
            headerFilter: { visible: true },
            searchPanel: { visible: true, width: 250, placeholder: "Buscar conta..." },
            expandNodesOnLoading: true, 
            autoExpandAll: false,
            editing: {
                allowAdding: true,
                allowUpdating: true,
                allowDeleting: true,
                mode: 'batch',
                useIcons: true,
                texts: {
                    confirmDeleteMessage: "Tem certeza que deseja excluir este Plano de Contas? Esta ação não pode ser desfeita."
                }
            },
            rowDragging: {
                allowDropInsideItem: true,
                allowReordering: true,
                onDragChange(e) {
                    const visibleRows = e.component.getVisibleRows();
                    const sourceNode = e.component.getNodeByKey(e.itemData.id);
                    let targetNode = visibleRows[e.toIndex].node;

                    while (targetNode && targetNode.data) {
                        if (targetNode.data.id === sourceNode.data.id) {
                            e.cancel = true;
                            break;
                        }
                        targetNode = targetNode.parent;
                    }
                },
                onReorder(e) {
                    const sourceData = e.itemData;
                    const visibleRows = e.component.getVisibleRows();
                    let targetData = visibleRows[e.toIndex].node.data;

                    if (e.dropInsideItem) {
                        sourceData.parent_id = targetData.id;
                    } else {
                        sourceData.parent_id = targetData ? targetData.parent_id : e.component.option('rootValue');
                    }

                    $.ajax({
                        url: '/controladoria/atualizar-plano-conta',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify(sourceData),
                        dataType: 'json',
                    }).then(response => {
                        if (response.success) {
                            e.component.refresh();
                        } else {
                            DevExpress.ui.notify('Erro ao atualizar dados após reordenar.', 'error', 3000);
                        }
                    });
                },
            },
            // toolbar: {
            //     items: [
            //         'addRowButton',
            //         'searchPanel',
            //         {
            //             location: "after",
            //             widget: "dxButton",
            //             options: {
            //                 icon: "fa fa-expand",
            //                 text: "",
            //                 onClick: function () {
            //                     var grid = $("#treeListContainer").dxTreeList("instance");
            //                     grid.expandAll();
            //                 }
            //             }
            //         },
            //         {
            //             location: "after",
            //             widget: "dxButton",
            //             options: {
            //                 icon: "fa fa-compress",
            //                 text: "",
            //                 onClick: function () {
            //                     var grid = $("#treeListContainer").dxTreeList("instance");
            //                     grid.collapseAll();
            //                 }
            //             }
            //         },
            //         {
            //             location: 'after',
            //             widget: 'dxButton',
            //             options: {
            //                 icon: 'refresh',
            //                 onClick: function () {
            //                     $('#treeListContainer').dxTreeList('instance').refresh();
            //                 },
            //                 hint: 'Recarregar',
            //             }
            //         },
            //         {
            //             location: 'after',
            //             widget: 'dxButton',
            //             options: {
            //                 icon: 'exportxlsx',
            //                 onClick: function () {
            //                     $('#treeListContainer').dxTreeList('instance').exportToExcel();
            //                 },
            //                 hint: 'Exportar para Excel',
            //             }
            //         },
            //         {
            //             location: 'after',
            //             widget: 'dxButton',
            //             options: {
            //                 icon: 'xlsxfile',
            //                 hint: 'Exportar Excel',
            //                 onClick: function () {
            //                     var treeList = $("#treeListContainer").dxTreeList("instance");
            //                     DevExpress.excelExporter.exportTreeList({
            //                         component: treeList,
            //                         worksheet: new ExcelJS.Workbook().addWorksheet('Plano de Contas')
            //                     }).then(function(workbook) {
            //                         return workbook.xlsx.writeBuffer();
            //                     }).then(function(buffer) {
            //                         saveAs(new Blob([buffer], {type: "application/octet-stream"}), "plano_de_contas.xlsx");
            //                     });
            //                 }
            //             }
            //         },
            //         {
            //             location: 'after',
            //             widget: 'dxButton',
            //             options: {
            //                 icon: 'exportpdf',
            //                 onClick: function () {
            //                     DevExpress.ui.notify('Exportação para PDF ainda não implementada.', 'info', 2000);
            //                 },
            //                 hint: 'Exportar para PDF',
            //             }
            //         },
            //     ]
            // },
            export: {
                enabled: true,
                fileName: "plano_de_contas",
                allowExportSelectedData: true
            },
            columns: [
                // { dataField: 'codigo', caption: 'Código', alignment: 'left', width: 180 },
                { dataField: 'clacta', caption: 'Classificação', width: 200 },
                { dataField: 'ctared', caption: 'Conta', alignment: 'center', width: 100 },
                { dataField: 'descta', caption: 'Descrição' },
                {
                    dataField: 'natcta',
                    caption: 'Natureza Conta',
                    alignment: 'center',
                    width: 150,
                    lookup: {
                        dataSource: [
                            { value: 'D', text: 'Débito' },
                            { value: 'C', text: 'Crédito' }
                        ],
                        valueExpr: 'value',
                        displayExpr: 'text'
                    }
                },
                {
                    dataField: 'anasin',
                    caption: 'Tipo Conta',
                    alignment: 'center',
                    width: 150,
                    lookup: {
                        allowClearing: true,
                        dataSource: [
                            { value: 'S', text: 'Sintética' },
                            { value: 'A', text: 'Analítica' }
                        ],
                        valueExpr: 'value',
                        displayExpr: 'text'
                    }
                },
                {
                    dataField: 'id_pacote_contas',
                    caption: 'Pacote de Contas',
                    lookup: {
                        allowClearing: true,
                        dataSource: new DevExpress.data.CustomStore({
                            key: 'id',
                            loadMode: 'raw',
                            load: function() {
                                return $.ajax({
                                    url: '/controladoria/get-lookup-pacote-contas',
                                    method: 'GET',
                                    dataType: 'json'
                                }).then(response => {
                                    return response.success ? response.data : [];
                                });
                            }
                        }),
                        valueExpr: 'id',
                        displayExpr: 'nome'
                    }
                },
            ],
            onRowUpdating: function (e) {
                e.newData = { ...e.oldData, ...e.newData };
            },
            onEditorPreparing: function (e) {
                if (e.parentType === "dataRow") {
                    if (e.dataField === "clacta") {
                        e.editorOptions.onValueChanged = function (args) {
                            const clactaValue = args.value;
                            const treeList = $('#treeListContainer').dxTreeList('instance');
                            const rowIndex = e.row.rowIndex;

                            treeList.cellValue(rowIndex, 'clacta', clactaValue);

                            if (clactaValue) {
                                $.ajax({
                                    url: '/controladoria/buscar-detalhes-clacta',
                                    method: 'GET',
                                    data: { clacta: clactaValue },
                                    dataType: 'json',
                                    success: function (response) {
                                        if (response.success) {
                                            treeList.cellValue(rowIndex, 'ctared', response.data.CTARED);
                                            treeList.cellValue(rowIndex, 'descta', response.data.DESCTA);
                                            treeList.cellValue(rowIndex, 'natcta', response.data.NATCTA);
                                            treeList.cellValue(rowIndex, 'anasin', response.data.ANASIN);
                                        } else {
                                            DevExpress.ui.notify(response.message, 'warning', 3000);
                                        }
                                    },
                                    error: function () {
                                        DevExpress.ui.notify('Erro ao buscar dados do Oracle', 'error', 3000);
                                    }
                                });
                            }
                        };
                    }
                }
            },
            onRowPrepared: function (e) {
                if (e.rowType === 'data') {
                    const anasin = (e.data.anasin || '').toUpperCase();
                    const natcta = (e.data.natcta || '').toUpperCase();
                    const codigo = e.data.codigo || '';
                    const nivel = (codigo.match(/\./g) || []).length + 1;

                    e.rowElement.css({
                        'background-color': '',
                        'font-weight': '',
                        'color': ''
                    });

                    if (anasin === 'S') {
                        let bgColor = '#f5f5f5';
                        if (nivel === 1) bgColor = '#d0d0d0';       
                        else if (nivel === 2) bgColor = '#e0e0e0';  
                        else if (nivel === 3) bgColor = '#f5f5f5';  
                        else bgColor = '#ebebeb';

                        e.rowElement.css({
                            'background-color': bgColor,
                            'font-weight': 'bold',
                            'color': '#000000'
                        });
                    } else {
                        e.rowElement.css('background-color', '#ffffff');

                        if (natcta === 'C') {
                            e.rowElement.css('color', '#198754');
                        } else if (natcta === 'D') {
                            e.rowElement.css('color', '#dc3545');
                        } else {
                            e.rowElement.css('color', '#000000');
                        }
                    }
                }
            },
            onToolbarPreparing: function (e) {
                var toolbarItems = e.toolbarOptions.items;


                e.toolbarOptions.items.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-expand",
                        hint: "Expandir tudo",
                        onClick() {
                            const tree = $("#treeListContainer").dxTreeList("instance");

                            function getAllKeys(node) {
                                let keys = [];
                                if (node.key !== undefined) keys.push(node.key);

                                if (node.children) {
                                    node.children.forEach(c => {
                                        keys = keys.concat(getAllKeys(c)); // recursivo: pega todos os níveis
                                    });
                                }

                                return keys;
                            }

                            const root = tree.getRootNode();
                            const allKeys = getAllKeys(root);
                            tree.option("expandedRowKeys", allKeys);
                        },
                        text: "Expandir tudo" 
                    }
                });

                e.toolbarOptions.items.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-compress",
                        hint: "Recolher tudo",
                        onClick() {
                            $("#treeListContainer").dxTreeList("instance")
                                .option("expandedRowKeys", []);
                        },
                        text: "Recolher tudo" 
                    }
                });

                e.toolbarOptions.items.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "exportxlsx",
                        hint: "Exportar Excel",
                        onClick() {
                            const treeList = $("#treeListContainer").dxTreeList("instance");
                            const rootItems = treeList.getRootNode().children;

                            // Funções de mapeamento (lookup -> texto)
                            function mapTipo(anasin) {
                                if (anasin === "S") return "Sintética";
                                if (anasin === "A") return "Analítica";
                                return "";
                            }
                            function mapNatureza(natcta) {
                                if (natcta === "C") return "Crédito";
                                if (natcta === "D") return "Débito";
                                return "";
                            }

                            function expandNodes(nodes, result, level = 0) {
                                nodes.forEach(n => {
                                    result.push({
                                        Nivel: level + 1,
                                        Codigo: n.data.codigo ?? "",
                                        Classificacao: n.data.clacta ?? "",
                                        Conta: n.data.ctared ?? "",
                                        Descricao: n.data.descta ?? "",
                                        Natureza: mapNatureza(n.data.natcta),
                                        Tipo: mapTipo(n.data.anasin),
                                        Grupo: n.data.dsc_grupo_contas ?? "",
                                        Pacote: n.data.dsc_pacote_contas ?? "",
                                    });

                                    if (n.children?.length) expandNodes(n.children, result, level + 1);
                                });
                            }

                            let rows = [];
                            expandNodes(rootItems, rows);

                            // Criar planilha
                            const workbook = new ExcelJS.Workbook();
                            const sheet = workbook.addWorksheet("Plano de Contas");

                            sheet.columns = [
                                { header: "Código", key: "Codigo", width: 20 },
                                { header: "Classificação", key: "Classificacao", width: 25 },
                                { header: "Conta Reduzida", key: "Conta", width: 18 },
                                { header: "Descrição", key: "Descricao", width: 60 },
                                { header: "Natureza", key: "Natureza", width: 12 },
                                { header: "Tipo da Conta", key: "Tipo", width: 14 },
                                { header: "Grupo de Contas", key: "Grupo", width: 30 },
                                { header: "Pacote de Contas", key: "Pacote", width: 30 },
                            ];

                            rows.forEach(r => {
                                const row = sheet.addRow(r);

                                // Bold para níveis de Sintética, igual no grid ⬇
                                if (r.Tipo === "Sintética") { 
                                    row.font = { bold: true };

                                    // cores por nível igual ao grid (opcional)
                                    if (r.Nivel === 1) row.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD0D0D0' } };
                                    else if (r.Nivel === 2) row.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFE0E0E0' } };
                                    else if (r.Nivel === 3) row.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFF5F5F5' } };
                                    else row.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFEBEBEB' } };
                                }
                            });

                            workbook.xlsx.writeBuffer().then(buffer =>
                                saveAs(new Blob([buffer]), "plano_de_contas.xlsx")
                            );
                        },
                        text: "Exportar Excel" 
                    }
                });


                e.toolbarOptions.items.push({
                    name: "refresh",
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "refresh",
                        onClick: function() {
                            e.component.refresh();
                        },
                        text: "Atualizar" 
                    }
                });
            }, 
        });

    });
</script>

