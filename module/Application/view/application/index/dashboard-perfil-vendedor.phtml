<script>
    var grafico1 = null;

    $(document).ready(function () {
        document.getElementById('btnExportPDF').addEventListener('click', async function () {
            // abre o overlay
            const loading      = document.getElementById('globalLoading');
            const spinnerGen   = document.getElementById('spinnerGeneric');
            const spinnerPDF   = document.getElementById('spinnerPDF');
            const loadingText  = document.getElementById('loadingText');

            // 1) Mostrar overlay
            loading.style.display = 'flex';

            // 2) Estado PDF: ocultar spinner genérico, mostrar PDF, texto
            spinnerGen.style.display  = 'none';
            spinnerPDF.style.display  = 'block';
            loadingText.textContent   = 'Gerando PDF…';

            try {
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF('p', 'mm', 'a4');
            const pageWidth  = pdf.internal.pageSize.getWidth();
            const pageHeight = pdf.internal.pageSize.getHeight();

            // marcação e grupos (igual ao seu código atual)
            const printArea = document.getElementById('print-area');
            const marker    = printArea.querySelector('#page2-marker');
            if (!marker) throw new Error('Marker não encontrado');
            const grupo1 = [], grupo2 = [];
            let el = marker.previousElementSibling;
            while (el) { grupo1.unshift(el); el = el.previousElementSibling; }
            el = marker.nextElementSibling;
            while (el) { grupo2.push(el); el = el.nextElementSibling; }

            // função para capturar
            async function capturarEAdicionar(grupo, novaPagina, topMarginPx = 0, leftMarginPx = 0, rightMarginPx = 0) {
                const tmp = document.createElement('div');
                tmp.style.position = 'absolute';
                tmp.style.left     = '-9999px';
                tmp.style.top      = '0';
                tmp.style.paddingLeft  = `${leftMarginPx}px`;
                tmp.style.paddingRight = `${rightMarginPx}px`;
                document.body.appendChild(tmp);

                if (topMarginPx > 0) {
                const spacer = document.createElement('div');
                spacer.style.height = `${topMarginPx}px`;
                tmp.appendChild(spacer);
                }

                grupo.forEach(node => tmp.appendChild(node.cloneNode(true)));
                const canvas = await html2canvas(tmp, { scale: 2, useCORS: true });
                document.body.removeChild(tmp);

                const imgData = canvas.toDataURL('image/png');
                const props   = pdf.getImageProperties(imgData);
                const availWidthMm = pageWidth - (leftMarginPx * 25.4/96) - (rightMarginPx * 25.4/96);
                const pdfW    = availWidthMm;
                const pdfH    = (props.height * pdfW) / props.width;
                if (novaPagina) pdf.addPage();
                const leftMarginMm = leftMarginPx * 25.4 / 96;
                pdf.addImage(imgData, 'PNG', leftMarginMm, 0, pdfW, pdfH);
            }

            // suas margens
            const margemTopo1 = 80, margemEsq1 = 20, margemDir1 = 20;
            const margemTopo2 = 80, margemEsq2 = 20, margemDir2 = 20;

            await capturarEAdicionar(grupo1, false, margemTopo1, margemEsq1, margemDir1);
            await capturarEAdicionar(grupo2, true,  margemTopo2, margemEsq2, margemDir2);

            // 6) Gera o download
            pdf.save('dashboard-recursos-humanos.pdf');

            } catch (err) {
                console.error(err);
                alert('Erro ao gerar PDF: ' + err.message);
            } finally {
                // 3) Reset para estado genérico
                spinnerPDF.style.display   = 'none';
                spinnerGen.style.display   = 'block';
                loadingText.textContent    = 'Carregando Informações...';

                // 4) Esconde overlay
                loading.style.display = 'none';
            }
        });
    });


    // Função para atualizar os gráficos
    function atualizarInfosDashboad() {
         // Mostra o loading
        // $('#globalLoading').show();

        const dataInicio = moment(formSelections.dataInicio, 'YYYY-MM-DD');
        const dataFim = moment(formSelections.dataFim, 'YYYY-MM-DD');

        let textoPeriodo = '';

        if (dataInicio.isSame(dataFim, 'month')) {
            textoPeriodo = dataInicio.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase());
        } else {
            textoPeriodo = `${dataInicio.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase())} à ${dataFim.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase())}`;
        }

        $('#periodo-apuracao').text(textoPeriodo);

        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/filtrar-dados',
                method: 'GET',
                dataType: 'json',
                data: formSelections,
                success: function(response) {
                    if (response.success) {
                    } else {
                        DevExpress.ui.notify("Erro ao carregar dados", "error", 3000);
                    }
                },
                error: function(error) {
                    DevExpress.ui.notify("Erro na requisição", "error", 3000);
                },
                complete: function() {
                    // Esconde o loading quando tudo estiver pronto
                    // $('#globalLoading').hide();
                }
            });
        });
    }

    
</script>