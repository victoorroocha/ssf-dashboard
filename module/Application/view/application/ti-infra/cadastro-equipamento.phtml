                    },
                    {       
                        name: "view_images",
                        icon: "fa fa-image",
                        text: "",
                        hint: "Visualizar imagens",
                        visible: function(e) {
                            // Mostra apenas se tiver imagens
                            return e.row.data.quantidade_imagens > 0;
                        },
                        onClick: function(e) {
                            const equipmentId = e.row.data.id;
                            DevExpress.ui.notify('Carregando imagens...', 'info', 1000);
                            
                            loadEquipmentImages(equipmentId).then(images => {
                                if (images.length > 0) {
                                    showImagesPopup(images);
                                } else {
                                    DevExpress.ui.notify('Nenhuma imagem encontrada!', 'warning', 3000);
                                }
                            });
                        }
                    },
                    {
                        name: "link_fabricante",
                        icon: "fa fa-link",
                        text: "", // Sem texto, só ícone
                        hint: "Abrir Link do Fabricante",
                        visible: function(e) {
                            return e.row.data.link_fabricante && 
                                e.row.data.link_fabricante.trim() !== '';
                        },
                        onClick: function(e) {
                            const link = e.row.data.link_fabricante;
                            if (link) {
                                const formattedLink = link.startsWith('http://') || link.startsWith('https://') 
                                    ? link 
                                    : 'https://' + link;
                                window.open(formattedLink, '_blank');
                            }
                        }
                    }
                ]
            },
            { dataField: 'nome', caption: 'Nome do Equipamento' },
            { dataField: 'hostname', caption: 'Hostname', width: 120, alignment: 'center' },
            { dataField: 'serie', caption: 'Série', width: 180, alignment: 'center' },
            { 
                dataField: 'tipo_equipamento_id', 
                caption: 'Tipo de Equipamento', 
                alignment: 'center',
                lookup: {
                    dataSource: createSafeLookupDataSource('/ti-infra/listar-tipo-equipamento', 'nome', 'id'),
                    displayExpr: 'nome', 
                    valueExpr: 'id' 
                } 
            },
            { dataField: 'patrimonio', caption: 'Patrimônio', alignment: 'center', width: 150},
            { dataField: 'partnumber', caption: 'Part Number', alignment: 'center', width: 150 },
            { dataField: 'num_solicitacao', caption: 'Nº Solicitação', alignment: 'center', width: 100 },
            { dataField: 'num_ordem_compra', caption: 'Nº Ordem Compra', alignment: 'center', width: 100 },
            { dataField: 'num_nota_fiscal', caption: 'Nº Nota Fiscal', alignment: 'center', width: 100 },
            { dataField: 'data_fabricacao', caption: 'Data Fabricação', dataType: 'date', format: 'dd/MM/yyyy',  alignment: 'center', width: 100 },
            { 
                dataField: 'numemp', 
                caption: 'Empresa', 
                groupIndex: 0,
                setCellValue(rowData, value) {
                    rowData.numemp = value;
                    rowData.numfilial = null;
                },
                lookup: {
                    dataSource: createSafeLookupDataSource('/ti-infra/get-lookup-empresa', 'DSC', 'ID'),
                    displayExpr: 'DSC', 
                    valueExpr: 'ID' 
                } 
            },
            {
                dataField: 'numfilial',
                caption: 'Filial',
                groupIndex: 1,
                calculateDisplayValue: function(rowData) {
                    if (!rowData.numfilial || !rowData.numemp) return null;
                    const filial = filiaisCache.find(f => f.ID === rowData.numfilial && f.CODEMP === rowData.numemp);
                    return filial ? filial.DSC : null;
                }
            },
            { dataField: 'link_fabricante', caption: 'Link Fabricante', visible: false },
            { dataField: 'observacoes', caption: 'Observações', visible: false },
            // {
            //     caption: 'Imagens',
            //     width: 100,
            //     alignment: 'center',
            //     allowEditing: false,
            //     cellTemplate: function(container, options) {
            //         const hasImages = options.data.quantidade_imagens > 0;
            //         const equipmentId = options.data.id;

            //         const div = $('<div>').addClass('image-indicator-container');

            //         if (hasImages) {
            //             const viewBtn = $('<button>')
            //                 .addClass('dx-button view-images-btn')
            //                 .html('<i class="fa fa-image" style="color: #007bff; font-size: 16px;"></i>')
            //                 .attr('title', 'Visualizar ' + options.data.quantidade_imagens + ' imagem(ns)')
            //                 .on('click', function(e) {
            //                     e.stopPropagation();
            //                     DevExpress.ui.notify('Carregando imagens...', 'info', 1000);
                                
            //                     loadEquipmentImages(equipmentId).then(images => {
            //                         if (images.length > 0) {
            //                             showImagesPopup(images);
            //                         } else {
            //                             DevExpress.ui.notify('Nenhuma imagem encontrada!', 'warning', 3000);
            //                         }
            //                     });
            //                 });
                        
            //             div.append(viewBtn);
            //         } else {
            //             div.html('<i class="fa fa-image" style="color: #ccc; font-size: 16px;"></i>')
            //               .attr('title', 'Sem imagens');
            //         }

            //         div.appendTo(container);
            //     }
            // },
            { dataField: 'status', caption: 'Status', dataType: 'boolean', alignment: 'center', width: 120, visible: false },
        ],
        onEditorPreparing: function(e) {
            if (e.dataField === 'numfilial' && e.parentType === 'dataRow') {
                const empresaId = e.row?.data?.numemp;

                e.editorOptions.disabled = !empresaId;

                e.editorOptions.dataSource = new DevExpress.data.CustomStore({
                    key: 'ID',
                    load: function() {
                        if (!empresaId) return Promise.resolve([]);
                        return Promise.resolve(filiaisCache.filter(f => f.CODEMP === empresaId));
                    },
                    byKey: function(key) {
                        if (!empresaId) return Promise.resolve(null);
                        return Promise.resolve(filiaisCache.find(f => f.ID === key) || null);
                    }
                });
            }
        },
        onInitNewRow: function(e) {
            isNovoRegistro = true;
            e.data.status = true;
            forceImageUpdate = false;
        },
        onEditingStart: function(e) {
            isNovoRegistro = false;
            forceImageUpdate = false;
        },
        onRowUpdating: function(e) {
            e.newData = { ...e.oldData, ...e.newData };

            const uploader = $(".dx-fileuploader").dxFileUploader("instance");
            if (uploader) {
                const uploadedImages = uploader.option("uploadedImages");
                const hasNewImages = uploadedImages && uploadedImages.length > 0;
                
                if (hasNewImages || forceImageUpdate) {
                    e.newData.imagens = uploadedImages || [];
                    e.newData._imagesUpdated = new Date().getTime();
                }
            }
            
            // Remove o campo fictício usado para forçar o update (se existir)
            delete e.newData._forceImageUpdate;
        },
        onSaved: function(e) {
            // Reseta a flag após o salvamento
            forceImageUpdate = false;
            // Pequeno delay antes de recarregar para evitar conflitos
            setTimeout(() => {
                if (e.component) {
                    e.component.refresh();
                }
            }, 500);
        },
        onEditCanceled: function(e) {
            // Reseta a flag se o usuário cancelar
            forceImageUpdate = false;
        },
        onToolbarPreparing: function (e) {
            var toolbarItems = e.toolbarOptions.items;
            
            toolbarItems.push({
                location: "after",
                widget: "dxButton",
                options: {
                    icon: "fa fa-expand",
                    text: "",
                    onClick: function () {
                        var grid = e.component;
                        grid.expandAll();
                    }
                }
            });

            toolbarItems.push({
                location: "after",
                widget: "dxButton",
                options: {
                    icon: "fa fa-compress",
                    text: "",
                    onClick: function () {
                        var grid = e.component;
                        grid.collapseAll();
                    }
                }
            });

            e.toolbarOptions.items.push({
                name: "refresh",
                location: "after",
                widget: "dxButton",
                options: {
                    icon: "refresh",
                    onClick: function() {
                        e.component.refresh();
                    },
                    text: "Atualizar" 
                }
            });
        },    
        onRowPrepared: function(e) {
            if (e.rowType === "data" && e.data.quantidade_disponivel === 0) {
                e.rowElement.css({ "background-color": "#f8d7da", "color": "#721c24" });
            }
        }
    });
    
    function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
        return {
            dataSource: new DevExpress.data.CustomStore({
                loadMode: 'raw',
                load: function () {
                    return $.ajax({
                        url: url,
                        method: 'GET',
                        dataType: 'json'
                    }).then(response => {
                        if (response.success) {
                            return response.data;
                        } else {
                            console.warn('Erro ao carregar select:', url, response.message);
                            return [];
                        }
                    }).catch((error) => {
                        console.error('Erro ao buscar dados:', url, error);
                        return [];
                    });
                }
            }),
            displayExpr: displayExpr,
            valueExpr: valueExpr,
            placeholder: placeholder,
            searchEnabled: true,
            showClearButton: true
        };
    }
});
