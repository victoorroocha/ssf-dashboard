                                return item ? `${item.id} - ${item.nome}${item.serie ? ' - ' + item.serie : ''}` : '';
                            },
                            placeholder: 'Digite para buscar equipamento...',
                            showClearButton: true,
                            showDataBeforeSearch: true
                        },
                        validationRules: [{ type: 'required', message: 'Equipamento é obrigatório' }]
                    },
                    {
                        dataField: 'centro_custo',
                        caption: 'Centro de Custo',
                        lookup: {
                            dataSource: new DevExpress.data.CustomStore({
                                key: 'ID',
                                loadMode: 'processed',
                                cacheRawData: true, // Adicione cache para melhor performance
