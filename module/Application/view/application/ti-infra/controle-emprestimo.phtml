                                { value: 'emprestado', text: 'Emprestado' },
                                { value: 'devolvido', text: 'Devolvido' }
                            ],
                            valueExpr: 'value',
                            displayExpr: 'text'
                        },
                        validationRules: [{ type: 'required', message: 'Status é obrigatório' }]
                    }
                ]
