                                            <div><small><strong>Nº Série:</strong> ${data.serie || 'Não informado'}</small></div>
                                            <div><small><strong>Hostname:</strong> ${data.hostname || 'Não informado'}</small></div>
                                            <div><small><strong>Nº Ordem de Compra:</strong> ${data.num_ordem_compra || 'Não informado'}</small></div>
                                            <div><small><strong>Observação:</strong> ${data.observacoes || 'Nenhuma'}</small></div>
                                        </div>
                                    </div>
