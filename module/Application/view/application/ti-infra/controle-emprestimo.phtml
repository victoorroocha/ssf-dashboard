    // ------------------- NOVAS FUNÇÕES ABAIXO -------------------
    async function montarTabelaDinamica(dados) {
        let html = "";

        // 🔹 TIPO DE EQUIPAMENTO (com checkbox visual)
        html += await montarTabelaTipoEquipamento(dados);

        // 🔹 DADOS DO EQUIPAMENTO
        const camposEquip = {
            "Marca/Modelo": dados.equipamento_nome,
            "Hostname": dados.hostname,
            "Série": dados.serie,
            "Nº Patrimônio": dados.patrimonio,
            "Part Number": dados.partnumber,
            "Observações": dados.equipamento_observacoes
        };
        html += montarTabela("DADOS DO EQUIPAMENTO", camposEquip);

        // 🔹 CARACTERÍSTICAS DO EQUIPAMENTO
        const camposCaract = {
            "Processador": dados.processador,
            "Memória": dados.memoria,
            "Armazenamento": dados.armazenamento,
            "Sistema Operacional": dados.sistema_operacional,
            "Outros Softwares": dados.outros_softwares
        };
        html += montarTabela("CARACTERÍSTICAS DO EQUIPAMENTO", camposCaract);

        // 🔹 ACESSÓRIOS (também com checkbox visual)
        html += await montarTabelaAcessorios(dados);

        return html;
    }
    // TABELA GENÉRICA PADRÃO (para dados e características) - MODIFICADA
    function montarTabela(titulo, campos) {
        const linhas = Object.entries(campos)
            .filter(([_, valor]) => valor && valor !== "null" && valor !== "")
            .map(([label, valor]) => `
                <tr>
                    <td style="border:1px solid #000; padding:4px; font-weight:bold; width:25%;">${label}:</td>
                    <td style="border:1px solid #000; padding:4px; width:75%;">${valor}</td>
                </tr>
            `).join("");

        if (!linhas) return "";

        return `
            <table style="width:100%; border-collapse:collapse; font-size:10px; margin-bottom:0mm; border:1px solid #000; color: #000;">
                <tr>
                    <td colspan="2" style="border:1px solid #000; padding:4px; font-weight:bold; background-color:#cfe5b9; text-align: center; color: #000;">
                        ${titulo}
                    </td>
                </tr>
                ${linhas}
            </table>
        `;
    }
    // ✅ Tipo de Equipamento
    async function montarTabelaTipoEquipamento(dados) {
        try {
            const response = await fetch('/ti-infra/listar-tipo-equipamento');
            const resultado = await response.json();

            const tipos = Array.isArray(resultado)
                ? resultado
                : Array.isArray(resultado.data)
                    ? resultado.data
                    : [];

            const tipoAtualId = dados?.tipo_equipamento_id;

            if (tipos.length === 0) {
                return `
                    <table style="width:100%; border-collapse:collapse; font-size:10px; border:1px solid #000; color: #000;">
                        <tr>
                            <td colspan="5" style="border:1px solid #000; padding:4px; font-weight:bold; background-color:#cfe5b9; text-align: center; color: #000;">TIPO DE EQUIPAMENTO</td>
                        </tr>
                        <tr><td style="padding:4px; color: #000;">Nenhum tipo de equipamento encontrado.</td></tr>
                    </table>
                `;
            }

            const linhas = [];
            for (let i = 0; i < tipos.length; i += 5) {
                const grupo = tipos.slice(i, i + 5);
                const linha = grupo.map(t => {
                    const isSelected = tipoAtualId && t.id === tipoAtualId;
                    const checkbox = isSelected ? '☑' : '☐';
                    return `<td style="border:1px solid #000; padding:4px; width:20%; color: #000;">${checkbox} ${t.nome || t}</td>`;
                }).join('');
                linhas.push(`<tr>${linha}</tr>`);
            }

            return `
                <table style="width:100%; border-collapse:collapse; font-size:10px; margin-bottom:0mm; border:1px solid #000; color: #000;">
                    <tr>
                        <td colspan="5" style="border:1px solid #000; padding:4px; font-weight:bold; background-color:#cfe5b9; text-align: center; color: #000;">TIPO DE EQUIPAMENTO</td>
                    </tr>
                    ${linhas.join('')}
                </table>
            `;
        } catch (error) {
            console.error("Erro ao montar tabela de tipo de equipamento:", error);
            return `
                <table style="width:100%; border-collapse:collapse; font-size:10px; border:1px solid #000; color: #000;">
                    <tr><td style="padding:4px; color:red; color: #000;">Erro ao carregar os tipos de equipamento.</td></tr>
                </table>
            `;
        }
    }
    // ✅ Acessórios
    async function montarTabelaAcessorios(dados) {
        try {
            const response = await fetch('/ti-infra/listar-acessorios');
            const resultado = await response.json();

            const acessorios = Array.isArray(resultado)
                ? resultado
                : Array.isArray(resultado.data)
                    ? resultado.data
                    : [];

            const acessoriosVinculados = dados.acessorios_ids || [];

            if (acessorios.length === 0) {
                return `
                    <table style="width:100%; border-collapse:collapse; font-size:10px; border:1px solid #000; color: #000;">
                        <tr>
                            <td colspan="5" style="border:1px solid #000; padding:4px; font-weight:bold; background-color:#cfe5b9; text-align: center; color: #000;">ACESSÓRIOS</td>
                        </tr>
                        <tr><td style="padding:4px; color: #000;">Nenhum acessório encontrado.</td></tr>
                    </table>
                `;
            }

            const linhas = [];
            for (let i = 0; i < acessorios.length; i += 5) {
                const grupo = acessorios.slice(i, i + 5);
                const linha = grupo.map(a => {
                    const isSelected = acessoriosVinculados.includes(a.id);
                    const checkbox = isSelected ? '☑' : '☐';
                    return `<td style="border:1px solid #000; padding:4px; width:20%; color: #000;">${checkbox} ${a.nome || a}</td>`;
                }).join('');
                linhas.push(`<tr>${linha}</tr>`);
            }

            return `
                <table style="width:100%; border-collapse:collapse; font-size:10px; margin-bottom:0mm; border:1px solid #000; color: #000;">
                    <tr>
                        <td colspan="5" style="border:1px solid #000; padding:4px; font-weight:bold; background-color:#cfe5b9; color: #000;">ACESSÓRIOS</td>
                    </tr>
                    ${linhas.join('')}
                </table>
            `;
        } catch (error) {
            console.error("Erro ao montar tabela de acessórios:", error);
            return `
                <table style="width:100%; border-collapse:collapse; font-size:10px; border:1px solid #000; color: #000;">
                    <tr><td style="padding:4px; color:red; color: #000;">Erro ao carregar os acessórios.</td></tr>
                </table>
            `;
        }
    }

    // Formata o CPF com zeros à esquerda e aplica máscara
    function formatarCPF(cpf) {
        if (!cpf) return '________________';
        cpf = cpf.replace(/\D/g, ''); // remove tudo que não é número
        cpf = cpf.padStart(11, '0');  // completa com zeros à esquerda
        if (cpf.length !== 11) return '________________';
        return cpf.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4');
    }
    function marcarDevolucaoEquipamento(data) {
        DevExpress.ui.dialog.confirm(
            "Tem certeza que deseja marcar esse equipamento como devolvido?\nApós devolvido, não será possível editar os dados.",
            "Confirmação"
        ).then(function (result) {
            if (!result) return;

            const envio = {
                id: data.id,
                equipamento_id: data.equipamento_id
            };

            $.ajax({
                url: '/ti-infra/marcar-devolucao-equipamento',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(envio),
                dataType: 'json'
            }).done(function (response) {
                if (response.success) {
                    DevExpress.ui.notify('Devolução do equipamento realizada com sucesso!', 'success', 3000);
                    $('#gridControleEmprestimo').dxDataGrid('instance').refresh();
                } else {
                    DevExpress.ui.notify(response.message || 'Erro ao marcar devolução do equipamento', 'error', 3000);
                }
            }).fail(function () {
                DevExpress.ui.notify('Erro na requisição ao marcar devolução do equipamento ', 'error', 3000);
            });
        });
    }


    function loadEquipmentImages(equipmentId) {
        return $.ajax({
            url: '/ti-infra/carregar-imagens-equipamento',
            method: 'GET',
            data: { id: equipmentId },
            dataType: 'json'
        }).then(response => {
            if (response.success && response.data) {
                return response.data;
            } else {
                throw new Error(response.message || 'Erro ao carregar imagens');
            }
        }).catch(error => {
            console.error('Erro ao carregar imagens:', error);
            DevExpress.ui.notify('Erro ao carregar imagens do equipamento!', 'error', 3000);
            return [];
        });
    }
});
</script>
