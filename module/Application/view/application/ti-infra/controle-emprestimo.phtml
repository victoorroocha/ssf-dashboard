            },
            {
                dataField: 'status',
                caption: 'Status',
                sortIndex: 0,
                alignment: 'center',
                sortOrder: 'asc',
                calculateSortValue: function(rowData) {
                    const order = { 'emprestado': 0, 'devolvido': 1 };
                    return order[(rowData.status || '').toLowerCase()] ?? 99;
                },
                cellTemplate: function(container, options) {
                    const status = options.value || '';
                    const statusConfig = {
                        'emprestado': { text: 'Emprestado', color: '#2ecc71', bgColor: '#D6EAF8' },
                        'devolvido': { text: 'Devolvido', color: '#3498db', bgColor: '#DFF6DD' }
                    };
                    
                    const config = statusConfig[status.toLowerCase()] || { text: status, color: '#95a5a6', bgColor: '#F8F9FA' };
                    
                    $(container).css({
                        'font-weight': 'bold',
                        'color': config.color,
                        'background-color': config.bgColor,
                        'padding': '4px 8px',
                        'border-radius': '4px'
                    }).text(config.text);
                }
            },
            {
                type: 'buttons',
                width: 150,
                alignment: 'center',
                buttons: [
                    {
                        name: 'edit',
                        visible: function (e) {
                            return e.row.data.status !== 'devolvido';
                        },
                    },
                    {
                        name: 'delete',
                        visible: function (e) {
                            return e.row.data.status !== 'devolvido';
                        },
                    },
                    {
                        hint: "Gerar Termo Empréstimo",
                        icon: "doc",
                        visible: function(e) {
                            return e.row.data.status !== 'devolvido';
                        },
                        onClick: function(e) {
                            gerarTermoEmprestimo(e.row.data);
                        }
                    },
                    {
                        hint: "Gerar Termo de Devolução",
                        icon: "doc",
                        visible: function (e) {
                            // Só aparece se o status for devolvido
                            return e.row.data.status === 'devolvido';
                        },
                        onClick: function (e) {
                            const data = e.row.data;
                            gerarTermoDevolucao(data);
                        }
                    },
                    {
                        hint: 'Marcar devolução',
                        icon: 'check',
                        visible: function (e) {
                            return e.row.data.status === 'emprestado';
                        },
                        onClick: function (e) {
                            marcarDevolucaoEquipamento(e.row.data);
                        }
                    },
                ]
            }
        ],
        onInitNewRow: function(e) {
            e.data.data_entrega = new Date();
            e.data.status = 'emprestado';
            
            setTimeout(() => {
                const form = $(".dx-popup-content .dx-form").dxForm("instance");
                if (form) {
                    form.updateData('data_entrega', new Date());
                    form.updateData('status', 'emprestado');
                }
            }, 100);
        },
        onRowPrepared: function (e) {
            if (e.rowType === 'data') {
                const status = (e.data.status || '').toLowerCase();

                const statusColors = {
                    'devolvido': '#DFF6DD', // Verde claro
                    'emprestado': '#D6EAF8'  // Azul claro
                };

                if (statusColors[status]) {
                    e.rowElement.css({ backgroundColor: statusColors[status], color: '#000' });
                }
            }
        }, 
        onRowUpdating: function (e) {
            e.newData = { ...e.oldData, ...e.newData };
        },
        onToolbarPreparing: function (e) {
            var toolbarItems = e.toolbarOptions.items;

            toolbarItems.push({
                location: "after",
                widget: "dxButton",
                options: {
                    icon: "fa fa-expand",
                    text: "",
                    onClick: function () {
                        var grid = e.component;
                        grid.expandAll();
                    }
                }
            });

            toolbarItems.push({
                location: "after",
                widget: "dxButton",
                options: {
                    icon: "fa fa-compress",
                    text: "",
                    onClick: function () {
                        var grid = e.component;
                        grid.collapseAll();
                    }
                }
            });

            e.toolbarOptions.items.push({
                name: "refresh",
                location: "after",
                widget: "dxButton",
                options: {
                    icon: "refresh",
                    onClick: function() {
                        e.component.refresh();
                    },
                    text: "Atualizar" 
                }
            });
        },          
    });

    function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
        return {
            dataSource: new DevExpress.data.CustomStore({
                loadMode: 'raw',
                load: function () {
                    return $.ajax({
                        url: url,
                        method: 'GET',
                        dataType: 'json'
                    }).then(response => {
                        if (response.success) {
                            return response.data;
                        } else {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                            return [];
                        }
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao buscar dados!', 'error', 3000);
                        return [];
                    });
                }
            }),
            displayExpr: displayExpr,
            valueExpr: valueExpr,
            placeholder: placeholder,
            searchEnabled: true,
            showClearButton: true
        };
    }
