<script>
$(document).ready(function () {
    var produtosLookup = []; 
    var funcionariosLookup = []; 
    var centrosCustoLookup  = [];

    getLookupFuncionarios();
    getLookupCentrosCusto();

    let controleEmprestimoGrid = $('#gridControleEmprestimo').dxDataGrid({
        dataSource: new DevExpress.data.CustomStore({
            key: 'id',
            load: function () {
                return $.ajax({
                    url: '/ti-infra/listar-controles-emprestimo',
                    method: 'GET',
                    dataType: 'json'
                }).then(response => {
                    if (response.success) {
                        return {
                            data: response.data,
                            totalCount: response.totalCount || response.data.length
                        };
                    } else {
                        DevExpress.ui.notify(response.message, 'error', 5000);
                        return { data: [], totalCount: 0 };
                    }
                }).catch(() => {
                    DevExpress.ui.notify('Erro ao carregar controles!', 'error', 5000);
                    return { data: [], totalCount: 0 };
                });
            },
            insert: function (values) {
                return $.ajax({
                    url: '/ti-infra/salvar-controle-emprestimo',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(values),
                    dataType: 'json'
                }).then(response => {
                    if (!response.success) {
                        DevExpress.ui.notify(response.message, 'error', 5000);
                    } else {
                        DevExpress.ui.notify(response.message || 'Controle salvo com sucesso!', 'success', 2000);
                    }
                    return response;
                }).catch(() => {
                    DevExpress.ui.notify('Erro ao salvar controle!', 'error', 5000);
                    return {};
                });
            },
            update: function (key, values) {
                return $.ajax({
                    url: '/ti-infra/salvar-controle-emprestimo',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ id: key, ...values }),
                    dataType: 'json'
                }).then(response => {
                    if (!response.success) {
                        DevExpress.ui.notify(response.message, 'error', 5000);
                    } else {
                        DevExpress.ui.notify(response.message || 'Controle atualizado com sucesso!', 'success', 5000);
                    }
                    return response;
                }).catch(() => {
                    DevExpress.ui.notify('Erro ao atualizar controle!', 'error', 5000);
                    return {};
                });
            },
            remove: function (key) {
                return $.ajax({
                    url: '/ti-infra/excluir-controle-emprestimo',
                    method: 'DELETE',
                    contentType: 'application/json',
                    data: JSON.stringify({ id: key }),
                    dataType: 'json'
                }).then(response => {
                    if (!response.success) {
                        DevExpress.ui.notify(response.message, 'error', 5000);
                    } else {
                        DevExpress.ui.notify(response.message || 'Controle excluído com sucesso!', 'success', 2000);
                    }
                    return response;
                }).catch(() => {
                    DevExpress.ui.notify('Erro ao excluir controle!', 'error', 3000);
                    return {};
                });
            }
        }),
        keyExpr: 'id',
        columnAutoWidth: true,
        width: '100%',
        height: 'auto',
        showBorders: true,
        columnChooser: {
            enabled: true,
            mode: "dragAndDrop",
            position: { 
                my: "right", 
                at: "right", 
                of: ".dx-datagrid-column-chooser-button" 
            }
        },
        groupPanel: {
            visible: true,
        },
        toolbar: {
            items: [
                {
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-expand",
                        text: "",
