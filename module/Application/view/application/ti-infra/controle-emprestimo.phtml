                                    return new Promise(resolve => {
                                        const searchValue = (loadOptions.searchValue || '').toUpperCase();
                                        let resultado = [];

                                        // Se não há termo de busca, retorna os primeiros 50
                                        if (!searchValue) {
                                            resultado = centrosCustoLookup.slice(0, 50);
                                        } else {
