                            minSearchLength: 1,
                            showClearButton: true,
                            searchExpr: 'DSC' // Busca pelo campo de display
                        },
                        setCellValue: function(newData, value) {
                            const centro = centrosCustoLookup.find(p => p.ID == value);
                            if (centro) {
                                newData.centro_custo = centro.ID;
                                // Se quiser preencher outros campos, pode adicionar aqui
                            }
