                                    });
                                },
                                byKey: function(key) {
                                    return new Promise((resolve, reject) => {
                                        const encontrado = centrosCustoLookup.find(item => item.ID == key);
                                        if (encontrado) {
                                            resolve(encontrado);
                                        } else {
                                            reject(`Centro de Custo com ID ${key} não encontrado`);
                                        }
