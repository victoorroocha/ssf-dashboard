
<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Planejamento e Controle da Produção</h1>
    </div>

    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Cadastro Funcionários</p>

                    <div id="gridFuncionarios"></div>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- /.container-fluid -->

<script>
    
    $(document).ready(function() {

        var funcionariosLookup = []; 

        getLookupFuncionarios();

        let funcionariosGrid = $('#gridFuncionarios').dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: 'id',
                load: function() {
                    return $.ajax({
                        url: '/planejamento-controle-producao/listar-funcionarios',
                        method: 'GET',
                        dataType: 'json'
                    }).then(response => {
                        if (response.success) {
                            return {
                                data: response.data,
                                totalCount: response.totalCount || response.data.length
                            };
                        } else {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                            return { data: [], totalCount: 0 };
                        }
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao carregar funcionários!', 'error', 3000);
                        return { data: [], totalCount: 0 };
                    });
                },
                insert: function(values) {
                    return $.ajax({
                        url: '/planejamento-controle-producao/salvar-funcionario',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(values),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Funcionário salvo com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(error => {
                        if (error.responseJSON && error.responseJSON.message) {
                            DevExpress.ui.notify(error.responseJSON.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify('Erro ao salvar Funcionário!', 'error', 3000);
                        }
                        return {};
                    });
                },
                update: function(key, values) {
                    return $.ajax({
                        url: '/planejamento-controle-producao/salvar-funcionario',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key, ...values }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Funcionário atualizado com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao atualizar Funcionário!', 'error', 3000);
                        return {};
                    });
                },
                remove: function(key) {
                    return $.ajax({
                        url: '/planejamento-controle-producao/excluir-funcionario',
                        method: 'DELETE',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Funcionário excluído com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao excluir Funcionário!', 'error', 3000);
                        return {};
                    });
                }
            }),
            keyExpr: 'id',
            columnAutoWidth: true,
            width: '100%',
            height: 600,
            showBorders: true,
            columnChooser: {
                enabled: true,
                mode: "dragAndDrop", // or "select"
                position: { 
                    my: "right", 
                    at: "right", 
                    of: ".dx-datagrid-column-chooser-button" 
                }
            },
            groupPanel: {
                visible: true,
            },
            toolbar: {
                items: [
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-expand", // ícone para expandir
                            text: "",
                            onClick: function () {
                                var grid = $("#gridFuncionarios").dxDataGrid("instance");
                                grid.expandAll(); // Expande todos os grupos
                            }
                        }
                    },
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-compress", // ícone para colapsar
                            text: "",
                            onClick: function () {
                                var grid = $("#gridFuncionarios").dxDataGrid("instance");
                                grid.collapseAll(); // Colapsa todos os grupos
                            }
                        }
                    },
                    {
                        name: "refresh", // Define o nome do botão
                        location: "after", // Coloca o botão após os outros itens na toolbar
                        widget: "dxButton",
                        options: {
                            icon: "refresh", // Ícone de refresh
                            onClick: function() {
                                // Lógica para atualizar/recarregar os dados da grid
                                $("#gridFuncionarios").dxDataGrid("instance").refresh(); // Atualiza a grid
                            },
                            text: "Atualizar" // Texto exibido no botão
                        }
                    }
                ]
            },
            pager: {
                visible: true
            },
            paging: {
                pageSize: 500
            },
            headerFilter: {
                visible: true,
            },
            filterRow: {
                visible: true,
                applyFilter: 'auto',
            },
            export: {
                enabled: true,
                fileName: "Cadastro funcionários",
                allowExportSelectedData: false,
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: 'Procure...',
            },
            hoverStateEnabled: true,
            editing: {
                mode: 'popup',
                allowUpdating: true,
                allowAdding: true,
                allowDeleting: true,
                useIcons: true,
                popup: {
                    title: 'Cadastro de Funcionário',
                    showTitle: true,
                    width: 450,
                    height: 'auto',
                    position: {
                        my: 'center',
                        at: 'center',
                        of: window
                    }
                },
                form: {
                    colCount: 1,
                    labelLocation: 'top',
                    items: [
                        {
                            dataField: 'numcad',
                            label: { text: 'Matrícula / Funcionário' },
                            editorType: 'dxSelectBox',
                            editorOptions: {
                                readOnly: false // vai ser alterado dinamicamente no onEditingStart
                            }
                        },
                        {
                            // campo CPF
                            name: 'cpf',
                            dataField: 'cpf',
                            editorType: 'dxTextBox',
                            label: { text: 'CPF' },
                            editorOptions: {
                                width: '100%',
                                mask: '000.000.000-00',
                                maskChar: '_',
                                showMaskMode: 'always'
                            },
                        },
                        {
                            dataField: 'cargo_funcao',
                            editorType: 'dxTextBox',
                            label: { text: 'Cargo / Função' },
                            editorOptions: { width: '100%' },
                            validationRules: [{ type: 'required', message: 'Cargo/Função é obrigatório' }]
                        },
                        {
                            dataField: 'contato',
                            editorType: 'dxTextBox',
                            label: { text: 'Contato' },
                            editorOptions: {
                                width: '100%',
                                mask: '(00) 00000-0000',
                                maskChar: '_',
                                showMaskMode: 'always'
                            }
                        },
                        {
                            dataField: 'departamento_id',
                            editorType: 'dxSelectBox',
                            label: { text: 'Departamento' },
                            editorOptions: getSelectBoxOptions(
                                '/planejamento-controle-producao/get-lookup-departamentos',
                                'nome', 'id',
                                'Selecione Departamento'
                            ),
                            validationRules: [{ type: 'required', message: 'Departamento é obrigatória' }]
                        },
                        {
                            dataField: 'flg_ativo',
                            editorType: 'dxSwitch',
                            label: { text: 'Ativo?' },
                            editorOptions: {
                                switchedOnText: 'Sim',
                                switchedOffText: 'Não',
                            }
                        }
                    ]
                },
                texts: {
                    confirmDeleteMessage: 'Tem certeza que deseja excluir este Funcionário? Esta ação não pode ser desfeita.'
                }
            },
            columns: [
                {
                    dataField: 'numcad',
                    caption: 'Nome Funcionário',
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            key: 'MATRICULA',
                            loadMode: 'processed',
                            cacheRawData: true, 
                            load: function (loadOptions) {
                                return new Promise((resolve) => {
                                    const searchValue = (loadOptions.searchValue || '').toUpperCase();

                                    let resultado = [];

                                    if (!searchValue) {
                                        resultado = funcionariosLookup.slice(0, 50);
                                    } else {
                                        resultado = funcionariosLookup.filter(item =>
                                            item.NOME_COLABORADOR.toUpperCase().includes(searchValue)
                                        );
                                    }

                                    resolve({
                                        data: resultado,
                                        totalCount: resultado.length
                                    });
                                });
                            },
                            byKey: function (key) {
                                return new Promise((resolve, reject) => {
                                    const encontrado = funcionariosLookup.find(item => item.MATRICULA == key);
                                    if (encontrado) {
                                        resolve(encontrado);
                                    } else {
                                        reject(`Funcionário com Matricula ${key} não encontrado`);
                                    }
                                });
                            }
                        }),
                        displayExpr: 'NOME_COLABORADOR',
                        valueExpr: 'MATRICULA',
                        searchEnabled: true,
                        minSearchLength: 3,
                        searchExpr: 'NOME_COLABORADOR'
                    },
                    setCellValue: function (newData, value) {
                        const tecnico = funcionariosLookup.find(p => p.MATRICULA == value);
                        if (tecnico) {
                            newData.numcad = tecnico.MATRICULA;
                            newData.nome = tecnico.NOME_COLABORADOR;
                            newData.cpf = tecnico.CPF;
                            newData.cargo_funcao = tecnico.DSC_CARGO;
                            newData.contato = tecnico.NUMTEL ?? tecnico.NUMCEL ?? null;
                        }
                    },
                    visible: false,
                    validationRules: [{ type: 'required' }]
                },
                {
                    dataField: 'nome',
                    caption: 'Nome Funcionário',
                },
                {
                    dataField: 'cpf',
                    caption: 'CPF',
                    customizeText: function (e) {
                        const cpf = e.value ? e.value.replace(/\D/g, '') : '';
                        return cpf.length === 11
                            ? cpf.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4')
                            : e.value;
                    }
                },
                { dataField: 'cargo_funcao', caption: 'Cargo / Função' },
                {
                    dataField: 'contato',
                    caption: 'Contato',
                    customizeText: function (e) {
                        const contato = e.value ? e.value.replace(/\D/g, '') : '';
                        return contato.length === 11
                            ? contato.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3')
                            : e.value;
                    }
                },
                {
                    dataField: 'departamento_id',
                    caption: 'Departamento',
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            loadMode: 'raw',
                            load: function () {
                                return $.ajax({
                                    url: '/planejamento-controle-producao/listar-departamentos',
                                    method: 'GET',
                                    dataType: 'json'
                                }).then(response => {
                                    if (response.success) {
                                        return response.data;
                                    } else {
                                        DevExpress.ui.notify(response.message, 'error', 3000);
                                        return [];
                                    }
                                }).catch(() => {
                                    DevExpress.ui.notify('Erro ao buscar departamentos!', 'error', 3000);
                                    return [];
                                });
                            }
                        }),
                        valueExpr: 'id',
                        displayExpr: 'nome'
                    }
                },
                {
                    dataField: 'flg_ativo',
                    caption: 'Ativo?',
                    dataType: 'boolean',
                    alignment: 'center',
                    width: 120
                }
            ],
            onRowUpdating: function(e) {
                e.newData = { ...e.oldData, ...e.newData };
            },
            onInitNewRow: function(e) {
                e.data.flg_ativo = true;
            },
            onEditorPreparing: function(e) {
                // Mantém a lógica original de equipamento_id
                if (e.dataField === 'numcad' || e.dataField === 'cpf') {
                    if (e.row && e.row.isNewRow !== true) {
                        e.editorOptions.readOnly = true;
                        if (e.editorName === 'dxSelectBox') {
                            e.editorOptions.disabled = true;
                        }
                    } else {
                        e.editorOptions.readOnly = false;
                        if (e.editorName === 'dxSelectBox') {
                            e.editorOptions.disabled = false;
                        }
                    }
                }
            },
            onToolbarPreparing: function (e) {
                // Aqui você pode personalizar ainda mais a barra de ferramentas
                var toolbarItems = e.toolbarOptions.items;
                // Adicionar os botões de expandir/colapsar
                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-expand",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.expandAll(); // Expande todos os grupos
                        }
                    }
                });

                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-compress",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.collapseAll(); // Colapsa todos os grupos
                        }
                    }
                });

                e.toolbarOptions.items.push({
                    name: "refresh", // Adiciona o botão refresh na toolbar
                    location: "after", // Coloca depois dos outros itens
                    widget: "dxButton",
                    options: {
                        icon: "refresh", // Ícone do botão (ícone de atualização)
                        onClick: function() {
                            // Recarrega os dados da grid
                            e.component.refresh(); // Atualiza a grid
                        },
                        text: "Atualizar" 
                    }
                });
            },
        });
        function validarCPF(cpf) {
            if (!cpf || cpf.length !== 11 || /^(\d)\1{10}$/.test(cpf)) return false;

            let soma = 0;
            for (let i = 0; i < 9; i++) {
                soma += parseInt(cpf.charAt(i)) * (10 - i);
            }

            let resto = (soma * 10) % 11;
            if (resto === 10 || resto === 11) resto = 0;
            if (resto !== parseInt(cpf.charAt(9))) return false;

            soma = 0;
            for (let i = 0; i < 10; i++) {
                soma += parseInt(cpf.charAt(i)) * (11 - i);
            }

            resto = (soma * 10) % 11;
            if (resto === 10 || resto === 11) resto = 0;
            return resto === parseInt(cpf.charAt(10));
        }
        function getLookupFuncionarios() {
            $.getJSON('/planejamento-controle-producao/get-usuarios-senior-lookup')
            .done(function (response) {
                if (response.success && response.data.length > 0) {
                    funcionariosLookup = response.data;
                } else {
                    DevExpress.ui.notify('Nenhum Funcionário encontrado.', 'warning', 3000);
                }
            })
            .fail(function () {
                DevExpress.ui.notify('Erro ao carregar funcionários.', 'error', 3000);
            });
        }

        // Função para SelectBox usada no editor de área técnica
        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: 'raw',
                    load: function () {
                        return $.ajax({
                            url: url,
                            method: 'GET',
                            dataType: 'json'
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, 'error', 3000);
                                return [];
                            }
                        }).catch(() => {
                            DevExpress.ui.notify('Erro ao buscar dados!', 'error', 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true,
                onInitialized: function(e) {
                    const val = e.component.option('value');
                    e.component.option('value', val);
                }
            };
        }
    });

</script>


