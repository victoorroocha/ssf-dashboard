                                    valueField: "recebido",
                                    name: "Recebido",
                                    color: "#3b8610",
                                    label: {
                                        visible: true,
                                        customizeText: function (pointInfo) {
                                            const data = statusClientesDataSource.find(d => d.cliente === pointInfo.argument);
                                            return new Intl.NumberFormat('pt-BR', {
                                                style: 'currency',
                                                currency: 'BRL'
                                            }).format(data.total);
                                        }
                                    }
                                },
                                {
                                    valueField: "restante",
                                    name: "Pendente",
                                    color: "#d9ead3",
                                    label: {
                                        visible: false
                                    }
                                }
                            ],
                            tooltip: {
                                enabled: true,
                                customizeTooltip(arg) {
                                    const data = statusClientesDataSource.find(d => d.cliente === arg.argument);
                                    return {
                                        text:
                                            `<b>${arg.argument}</b><br />` +
                                            `Recebeu Documento ou Garantia: ${data.recebido.toLocaleString("pt-BR", {
                                                style: "currency",
                                                currency: "BRL"
                                            })}<br />` +
                                            `Pendente: ${data.restante.toLocaleString("pt-BR", {
                                                style: "currency",
                                                currency: "BRL"
                                            })}`
                                    };
                                }
                            },
                            legend: {
                                verticalAlignment: "bottom",
                                horizontalAlignment: "center"
