<script>
    // Variáveis globais para armazenar os valores selecionados
    const formSelections = {
        codigoSafra: "163",
    };

    $(document).ready(function() {
        // BTN Exportar PDF - Versão corrigida
        document.getElementById('btnExportPDF').addEventListener('click', async function () {
            const loading = document.getElementById('globalLoading');
            const spinnerGen = document.getElementById('spinnerGeneric');
            const spinnerPDF = document.getElementById('spinnerPDF');
            const loadingText = document.getElementById('loadingText');

            loading.style.display = 'flex';
            spinnerGen.style.display = 'none';
            spinnerPDF.style.display = 'block';
            loadingText.textContent = 'Gerando PDF…';

            try {
                const printArea = document.getElementById('print-area');

                // Detecta o zoom do navegador para compensar a escala
                const zoom = window.devicePixelRatio || 1;
                const scale = 2 / zoom; // seu scale original 2 dividido pelo zoom atual

                const canvas = await html2canvas(printArea, {
                    scale: scale,
                    useCORS: true,
                    logging: true,
                    allowTaint: true,
                    backgroundColor: null,
                    onclone: (clonedDoc) => {
                        const cabecalho = clonedDoc.querySelector('.cabecalho-content');
                        if (cabecalho) {
                            cabecalho.classList.remove('hidden-print');
                            cabecalho.style.backgroundColor = '#006400';
                            cabecalho.style.color = 'white';
                            cabecalho.style.padding = '10px 20px';
                            cabecalho.style.textAlign = 'center';
                        }
                    }
                });

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4');
                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                const margemMm = 30 * 0.264583;

                const imgData = canvas.toDataURL('image/png', 1.0);
                const props = pdf.getImageProperties(imgData);

                const pdfWidth = pageWidth - 2 * margemMm;
                const maxPdfHeight = pageHeight - 2 * margemMm;

                // Ajusta a altura para caber na página, mantendo a proporção
                let pdfHeight = (props.height * pdfWidth) / props.width;
                if (pdfHeight > maxPdfHeight) {
                    pdfHeight = maxPdfHeight;
                }

                pdf.addImage(
                    imgData,
                    'PNG',
                    margemMm,
                    margemMm,
                    pdfWidth,
                    pdfHeight,
                    undefined,
                    'FAST'
                );

                pdf.save('dashboard-monitoramento-pedidos.pdf');
            } catch (err) {
                console.error('Erro ao gerar PDF:', err);
                alert('Erro ao gerar PDF. Verifique o console para detalhes.');
            } finally {
                spinnerPDF.style.display = 'none';
                spinnerGen.style.display = 'block';
                loadingText.textContent = 'Carregando Informações...';
                loading.style.display = 'none';
            }
        });

        // Inicializa o formulário e rangeSelector
        const formInstance = $("#form-container").dxForm({
            formData: {
                codigoSafra: "163"
            },
            colCount: 1,
            items: [
                {
                    itemType: "group",
                    colCount: 1,
                    items: [
                        {
                            dataField: "codigoSafra",
                            editorType: "dxSelectBox",
                            label: { visible: false },
                            editorOptions: getSelectBoxOptions("/credito-e-cobranca/get-lookup-safra", "dsc", "codigosafra", "Selecione a Safra")
                        }
                    ]
                },
            ],
            onContentReady: function(e) {
                // Garante que todos os valores iniciais do formulário sejam capturados
                const formData = e.component.option('formData');
                for (let field in formData) {
                    formSelections[field] = formData[field];
                }
            },
            onFieldDataChanged: function(e) {
                // Atualiza a variável global quando um campo é alterado
                formSelections[e.dataField] = e.value;
                
            }
        }).dxForm("instance");

        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: "raw",
                    load: function() {
                        return $.ajax({
                            url: url,
                            method: "GET",
                            dataType: "json"
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, "error", 3000);
                                return [];
                            }
                        }).catch(error => {
                            DevExpress.ui.notify("Erro ao buscar dados!", "error", 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true,
                onInitialized: function(e) {
                    atualizarInfosDashboad();
                },
                onValueChanged: function(e) {
                    atualizarInfosDashboad();
                }
            };
        }
    });

    // Função para atualizar informações do dashboard
    function atualizarInfosDashboad() {
        // Mostra o loading
        $('#globalLoading').show();

        const codigoSafra = formSelections.codigoSafra;
        $('#safra-apuracao').text(codigoSafra);

        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/credito-e-cobranca/listar-dados-propostas-documentos',
                method: 'GET',
                dataType: 'json',
                data: formSelections,
                success: function(response) {
                    if (response.success) {
                        const formatadorMoeda = new Intl.NumberFormat('pt-BR', {
                            style: 'currency',
                            currency: 'BRL',
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });

                        // INICIO GRIDS E DETALHES
                            // Acessar os dados do objeto
                            const infoGermoplasmaTipoPrazo = response.data.infoGermoplasmaTipoPrazo;
                            const infoRoyaltiesTipoPrazo = response.data.infoRoyaltiesTipoPrazo;
                            const infoTSITipoPrazo = response.data.infoTSITipoPrazo;
                            const infoFreteTipoPrazo = response.data.infoFreteTipoPrazo;

                            // Germoplasma
                            const germoAno = formatadorMoeda.format(infoGermoplasmaTipoPrazo.PRAZO_ANO_GERMOPLASMA ?? 0);
                            document.getElementById('germoAno').textContent = germoAno;

                            const germoSafra = formatadorMoeda.format(infoGermoplasmaTipoPrazo.PRAZO_SAFRA_GERMOPLASMA ?? 0);
                            document.getElementById('germoSafra').textContent = germoSafra;

                            const totalGermoplasma = (infoGermoplasmaTipoPrazo.PRAZO_ANO_GERMOPLASMA + infoGermoplasmaTipoPrazo.PRAZO_SAFRA_GERMOPLASMA) ?? 0;
                            document.getElementById('germoTotal').textContent = formatadorMoeda.format(totalGermoplasma);

                            // Royalties
                            const royAno = formatadorMoeda.format(infoRoyaltiesTipoPrazo.PRAZO_ANO_ROYALTIES  ?? 0);
                            document.getElementById('royAno').textContent = royAno;

                            const roySafra = formatadorMoeda.format(infoRoyaltiesTipoPrazo.PRAZO_SAFRA_ROYALTIES  ?? 0);
                            document.getElementById('roySafra').textContent = roySafra;

                            const totalRoyalties = (infoRoyaltiesTipoPrazo.PRAZO_ANO_ROYALTIES + infoRoyaltiesTipoPrazo.PRAZO_SAFRA_ROYALTIES) ?? 0;
                            document.getElementById('royTotal').textContent = formatadorMoeda.format(totalRoyalties);

                            // TSI
                            const tsiAno = formatadorMoeda.format(infoTSITipoPrazo.PRAZO_ANO_TSI ?? 0);
                            document.getElementById('tsiAno').textContent = tsiAno;

                            const tsiSafra = formatadorMoeda.format(infoTSITipoPrazo.PRAZO_SAFRA_TSI ?? 0);
                            document.getElementById('tsiSafra').textContent = tsiSafra;

                            const totalTSI = (infoTSITipoPrazo.PRAZO_ANO_TSI + infoTSITipoPrazo.PRAZO_SAFRA_TSI) ?? 0;
                            document.getElementById('tsiTotal').textContent = formatadorMoeda.format(totalTSI);

                            // Frete
                            const freteAno = formatadorMoeda.format(infoFreteTipoPrazo.PRAZO_ANO_FRETE ?? 0);
                            document.getElementById('freteAno').textContent = freteAno;

                            const freteSafra = formatadorMoeda.format(infoFreteTipoPrazo.PRAZO_SAFRA_FRETE ?? 0);
                            document.getElementById('freteSafra').textContent = freteSafra;

                            const totalFrete = (infoFreteTipoPrazo.PRAZO_ANO_FRETE + infoFreteTipoPrazo.PRAZO_SAFRA_FRETE) ?? 0;
                            document.getElementById('freteTotal').textContent = formatadorMoeda.format(totalFrete);
                        // FIM GRIDS E DETALHES

                        let totaisPorStatus = response.data.totaisPorStatus;
                        renderSingleStatusBar("graficoStatusGarantiasContainer", "STATUS_GARANTIA_PEDIDO", totaisPorStatus.STATUS_GARANTIA_PEDIDO);
                        renderSingleStatusBar("graficoStatusDocumentosContainer", "STATUS_DOCUMENTO_PEDIDO", totaisPorStatus.STATUS_DOCUMENTO_PEDIDO);

                        let totaisPorVendedor = response.data.totaisPorVendedor;
                        const statusVendedoresDataSource = Object.entries(totaisPorVendedor).map(([nome, valores]) => ({
                            vendedor: nome,
                            recebido: valores.recebido,
                            restante: valores.total - valores.recebido,
                            total: valores.total
                        })).sort((a, b) => a.total - b.total);

                        $("#graficoStatusVendedoresContainer").dxChart({
                            dataSource: statusVendedoresDataSource,
                            rotated: true,
                            size: {
                                height: 400
                            },
                            commonSeriesSettings: {
                                argumentField: "vendedor",
                                type: "stackedBar",
                                label: {
                                    visible: true,
                                    backgroundColor: 'transparent',
                                    font: { color: "#000", size: 12, weight: "bold" },
                                    position: "outside"
                                },
                                barGroupPadding: 0.3,
                                barWidth: 30,
                            },
                            series: [
                                {
                                    valueField: "recebido",
                                    name: "Recebido",
                                    color: "#3b8610",
                                    label: {
                                        visible: true,
                                        position: "inside",
