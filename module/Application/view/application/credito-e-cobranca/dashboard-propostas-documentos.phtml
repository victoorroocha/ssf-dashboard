    function renderBar(containerId, documentos, total, tipo) {
        const restante = total - documentos;

        const chartData = [{
            tipo: tipo,
            documentos: documentos,
            restante: restante,
            total: total 
        }];

        $(`#${containerId}`).dxChart({
            dataSource: chartData,
            rotated: true,
            commonSeriesSettings: {
                argumentField: "tipo",
                type: "stackedBar",
                barPadding: 0.1,
                barWidth: 20
            },
            series: [
                {
                    valueField: "documentos",
                    color: "#3b8610",
                    label: {
                        visible: true,
                        backgroundColor: 'transparent',
                        border: { visible: false },
                        font: { color: "#000", size: 10,  weight: "bold"  },
                        position: "inside",
                        customizeText: function (pointInfo) {
                            return new Intl.NumberFormat('pt-BR', {
                                style: 'currency',
                                currency: 'BRL'
                            }).format(pointInfo.value);
                        }
                    }
                },
                {
                    valueField: "restante",
                    color: "#d9ead3",
                    label: {
                        visible: true,
                        backgroundColor: 'transparent',
                        border: { visible: false },
                        font: { color: "#000", size: 10,  weight: "bold"  },
                        position: "outside",
                        verticalOffset: -100,
                        customizeText: function (pointInfo) {
                            return new Intl.NumberFormat('pt-BR', {
                                style: 'currency',
                                currency: 'BRL'
                            }).format(pointInfo.point.data.total);
                        }
                    }
                }
            ],
            legend: { visible: false },
            tooltip: { enabled: false },
            argumentAxis: {
                visible: true,
                label: {
                    visible: true,
                    font: { size: 12 },
                    indentFromAxis: 5,
                    customizeText: function (arg) {
                        return arg.value.padEnd(12, ' ');
                    }
                },
                tick: { visible: false },
                grid: { visible: false },
                axisDivisionFactor: 100,
                constantLines: [],
                stripStyle: {},
                minorTick: { visible: false },
                minorGrid: { visible: false },
                title: { visible: false },
                axisLine: { visible: false }
            },
            valueAxis: {
                visible: false,
                grid: { visible: false },
                tick: { visible: false },
                axisLine: { visible: false }
            },
            customizePoint: () => ({ hoverStyle: null })
        });
    }
    function renderSingleStatusBar(containerId, tipoStatus, statusValores) {
        const chartData = [];

        for (let status in statusValores) {
            const valor = statusValores[status];
            chartData.push({
                tipo: status,
                documentos: valor,
                restante: 0,
                total: valor
            });
        }

        const chartId = `${containerId}_${tipoStatus}`;
        const container = $(`<div id="${chartId}" style="height: 100px; margin-bottom: 10px;"></div>`);
        $(`#${containerId}`).append(container);

        $(`#${chartId}`).dxChart({
            dataSource: chartData,
            rotated: true,
            commonSeriesSettings: {
                argumentField: "tipo",
                type: "stackedBar",
                barPadding: 0.1,
                barWidth: 20
            },
            series: [
                {
                    valueField: "documentos",
                    label: {
                        visible: true,
                        backgroundColor: 'transparent',
                        border: { visible: false },
                        font: { color: "#000", size: 12, weight: "bold" },
                        position: "inside",
                        customizeText: function (pointInfo) {
                            return new Intl.NumberFormat('pt-BR', {
                                style: 'currency',
                                currency: 'BRL'
                            }).format(pointInfo.value);
                        }
                    }
                },
                {
                    valueField: "restante",
                    color: "#d9ead3",
                    label: { visible: false }
                }
            ],
            legend: { visible: false },
            tooltip: { enabled: false },
            argumentAxis: {
                visible: true,
                label: {
                    visible: true,
                    font: { size: 12 },
                    indentFromAxis: 5,
                    customizeText: function (arg) {
                        return arg.value.padEnd(12, ' ');
                    }
                },
                tick: { visible: false },
                grid: { visible: false },
                axisDivisionFactor: 100,
                constantLines: [],
                stripStyle: {},
                minorTick: { visible: false },
                minorGrid: { visible: false },
                title: { visible: false },
                axisLine: { visible: false }
            },
            valueAxis: {
                visible: false,
                grid: { visible: false },
                tick: { visible: false },
                axisLine: { visible: false }
            },
            customizePoint: function (point) {
                const status = point.argument;
                let color = "#3b8610"; // padrão

                if (status === "Pendente") color = "#e6b800";          // amarelo escuro
                else if (status === "Recebido Parcial") color = "#3c78d8"; // azul escuro
                else if (status === "Recebido") color = "#38761d";      // verde escuro

                return { color: color };
            }
        });
    }







