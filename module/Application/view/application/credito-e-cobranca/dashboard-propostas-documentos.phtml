        // formSelections.dataFim = moment(endOfMonth.toDate()).format("YYYY-MM-DD");

        // const rangeSelectorInstance = $("#range-selector").dxRangeSelector({
        //     width: '100%',
        //     scale: {
        //         startValue: moment(`${startYear}-01-01`).toDate(),
        //         endValue: today.clone().endOf('year').toDate(),
        //         minorTickInterval: "month",
        //         tickInterval: "month",
        //         useTicks: true,
        //         label: { format: "MMM yyyy" }
        //     },
        //     value: [startOfMonth.toDate(), endOfMonth.toDate()],  // Intervalo: primeiro dia do mês até o último dia
        //     sliderMarker: { format: "monthAndYear" },
        //     behavior: { callValueChanged: "onMovingComplete" }, // Alterado para "onMovingComplete"
        //     applyValueMode: "onHandleRelease",
        //     onInitialized: function(e) {
        //         atualizarInfosDashboad();
        //     },
        //     onValueChanged: function(e) {
        //         const startDate = moment(e.value[0]);
        //         const endDate = moment(e.value[1]).subtract(1, 'days'); // quando faz o changed sempre pega dia 01 do proximo mes ao selecionado. Tratei pra subtrair um dia, pegando o ultimo dia do mes selecionado.

        //         formSelections.dataInicio = moment(startDate.toDate()).format("YYYY-MM-DD");
        //         formSelections.dataFim = moment(endDate.toDate()).format("YYYY-MM-DD");
                
        //         atualizarInfosDashboad();
        //     }
        // }).dxRangeSelector("instance");

    });

    // Função para atualizar informações do dashboard
    function atualizarInfosDashboad() {
        // Mostra o loading
        $('#globalLoading').show();

        // const dataInicio = moment(formSelections.dataInicio, 'YYYY-MM-DD');
        // const dataFim = moment(formSelections.dataFim, 'YYYY-MM-DD');
        const codigoSafra = formSelections.codigoSafra;
        // $('#safra-apuracao').text(codigoSafra);

        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/credito-e-cobranca/listar-dados-propostas-documentos',
                method: 'GET',
                dataType: 'json',
                data: formSelections,
                success: function(response) {
                    if (response.success) {
                        const formatadorMoeda = new Intl.NumberFormat('pt-BR', {
                            style: 'currency',
                            currency: 'BRL',
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });

                        let totaisPorPrazo = response.data.totaisPorPrazo;

                        renderBar("germoAnoBar", 0, totaisPorPrazo.PRAZO_ANO_GERMOPLASMA_TOTAL, "PRAZO ANO");
                        renderBar("germoSafraBar", totaisPorPrazo.PRAZO_SAFRA_GERMOPLASMA_DOCUMENTOS, totaisPorPrazo.PRAZO_SAFRA_GERMOPLASMA_TOTAL, "PRAZO SAFRA");

                        renderBar("royaltiesAnoBar", 0, totaisPorPrazo.PRAZO_ANO_ROYALTIES_TOTAL, "PRAZO ANO");
                        renderBar("royaltiesSafraBar", totaisPorPrazo.PRAZO_SAFRA_ROYALTIES_DOCUMENTOS, totaisPorPrazo.PRAZO_SAFRA_ROYALTIES_TOTAL, "PRAZO SAFRA");

                        renderBar("tsiAnoBar", 0, totaisPorPrazo.PRAZO_ANO_TSI_TOTAL, "PRAZO ANO");
                        renderBar("tsiSafraBar", totaisPorPrazo.PRAZO_SAFRA_TSI_DOCUMENTOS, totaisPorPrazo.PRAZO_SAFRA_TSI_TOTAL, "PRAZO SAFRA");

                        renderBar("freteAnoBar", 0, totaisPorPrazo.PRAZO_ANO_FRETE_TOTAL, "PRAZO ANO");
                        renderBar("freteSafraBar", totaisPorPrazo.PRAZO_SAFRA_FRETE_DOCUMENTOS, totaisPorPrazo.PRAZO_SAFRA_FRETE_TOTAL, "PRAZO SAFRA");

                        let totaisPorStatus = response.data.totaisPorStatus;

                        renderSingleStatusBar("graficoStatusGarantiasContainer", "STATUS_GARANTIA_PEDIDO", totaisPorStatus.STATUS_GARANTIA_PEDIDO);
                        renderSingleStatusBar("graficoStatusDocumentosContainer", "STATUS_DOCUMENTO_PEDIDO", totaisPorStatus.STATUS_DOCUMENTO_PEDIDO);

                        let totaisPorVendedor = response.data.totaisPorVendedor;

                        const statusVendedoresDataSource = Object.entries(totaisPorVendedor).map(([nome, valores]) => ({
                            vendedor: nome,
                            recebido: valores.recebido,
                            restante: valores.total - valores.recebido,
                            total: valores.total
                        }))
                        .sort((a, b) => a.total - b.total); 

                        $("#graficoStatusVendedoresContainer").dxChart({
                            dataSource: statusVendedoresDataSource,
                            rotated: true,
                            commonSeriesSettings: {
                                argumentField: "vendedor",
                                type: "stackedBar",
                                label: {
                                    visible: true,
                                    backgroundColor: 'transparent',
                                    font: { color: "#000", size: 12, weight: "bold" },
                                    position: "outside"
                                }
                            },
                            series: [
                                {
                                    valueField: "recebido",
                                    name: "Recebido",
                                    color: "#3b8610",
                                    label: {
                                        visible: true,
                                        customizeText: function (pointInfo) {
                                            const data = statusVendedoresDataSource.find(d => d.vendedor === pointInfo.argument);
                                            return new Intl.NumberFormat('pt-BR', {
                                                style: 'currency',
                                                currency: 'BRL'
                                            }).format(data.total);
                                        }
                                    }
                                },
                                {
                                    valueField: "restante",
                                    name: "Pendente",
                                    color: "#d9ead3",
                                    label: {
                                        visible: false
                                    }
                                }
                            ],
                            tooltip: {
                                enabled: true,
                                customizeTooltip(arg) {
                                    const data = statusVendedoresDataSource.find(d => d.vendedor === arg.argument);
                                    return {
                                        text:
                                            `<b>${arg.argument}</b><br />` +
                                            `Recebeu Documento ou Garantia: ${data.recebido.toLocaleString("pt-BR", {
                                                style: "currency",
                                                currency: "BRL"
                                            })}<br />` +
                                            `Pendente: ${data.restante.toLocaleString("pt-BR", {
                                                style: "currency",
                                                currency: "BRL"
                                            })}`
                                    };
                                }
                            },
                            legend: {
                                verticalAlignment: "bottom",
                                horizontalAlignment: "center"
                            }
                        });

                        let totaisPorGrupoCliente = response.data.totaisPorGrupoCliente;
                        const statusClientesDataSource = Object.entries(totaisPorGrupoCliente).map(([nome, valores]) => ({
                            cliente: nome,
                            recebido: valores.recebido,
                            restante: valores.total - valores.recebido,
                            total: valores.total
                        }))
                        .sort((a, b) => a.total - b.total); 
                        
                        $("#graficoStatusClientesContainer").dxChart({
                            dataSource: statusClientesDataSource,
                            rotated: true,
                            commonSeriesSettings: {
                                argumentField: "cliente",
                                type: "stackedBar",
                                label: {
                                    visible: true,
                                    backgroundColor: 'transparent',
                                    font: { color: "#000", size: 12, weight: "bold" },
                                    position: "outside"
                                }
