                                                    icon: "fa fa-print", 
                                                    visible: function(e) {
                                                        const docStatus = e.row?.data?.STATUS_DOCUMENTO_PEDIDO;
                                                        const garStatus = e.row?.data?.STATUS_GARANTIA_PEDIDO;
                                                        return docStatus !== 'Pendente' || garStatus !== 'Pendente';
                                                    },
