                                                        $("#gridContainer").dxDataGrid("instance").refresh(); // Atualiza a grid
                                                    },
                                                    text: "Atualizar" // Texto exibido no botão
                                                }
                                            }
                                        ]
                                    },
                                    editing: {
                                        mode: 'batch',    // Modo de edição em lote
                                        allowUpdating: false,
                                        allowDeleting: false,
                                        useIcons: true,
                                        selectTextOnEditStart: false,
                                    },
                                    selection: {
                                        mode: 'multiple',
                                        showCheckBoxesMode: 'none'
                                    },
                                    hoverStateEnabled: true,
                                    pager: {
                                        visible: true
                                    },
                                    paging: {
                                        pageSize: 500
                                    },
                                    headerFilter: {
                                        visible: true,
                                    },
                                    filterRow: {
                                        visible: true,
                                        applyFilter: 'auto',
                                    },
                                    export: {
                                        enabled: true,
                                        fileName: "Controle Documentos Pedido",
                                        allowExportSelectedData: false,
                                    },
                                    searchPanel: {
                                        visible: true,
                                        width: 240,
                                        placeholder: 'Procure...',
                                    },
                                    columns: [
                                        // Visiveis
                                        {
                                            type: "buttons",      
                                            width: 100,            
                                            fixed: true,
                                            fixedPosition: "left",
                                            buttons: [
                                                {
                                                    hint: "Visualizar Documentos Cliente",
                                                    icon: "fa fa-eye",  
                                                    onClick: function(e) {
                                                        const data = e.row.data;
                                                        abrirPopupDocumentosPedido(data.ID_PEDIDO, data.TIPO_PESSOA, data.GRUPO_CLIENTE, data.CODIGOSAFRA);
                                                    }
                                                },
                                                {
