        function abrirPopupDocumentosPedido(idPedido, tipoPessoa, grupoClienteID, codigoSafra) {
            $.ajax({
                url: "/credito-e-cobranca/list-documentos-pedido",
                method: 'GET',
                data: { idPedido: idPedido, tipoPessoa: tipoPessoa, grupoClienteID: grupoClienteID, codigoSafra: codigoSafra },
                success: function (response) {
                    if (response.data) {
                        const popup = $('#popupDocumentosPedido').dxPopup({
                            title: "Detalhes Pedido",
                            visible: false,
                            width: '80%',
                            height: 'auto',
                            // maxHeight: '90vh',
                            showTitle: true,
                            scrollingEnabled: true,
                            contentTemplate: function (contentElement) {
                                const formContainer = $("<div>").attr("id", "formDocumentosGarantias");

                                const formData = {};
                                const documentos = response.data.documentos || [];
                                const garantias = response.data.garantias || [];

                                documentos.forEach(doc => {
                                    formData[`documento_${doc.id_documento}`] = !!doc.ativo;
                                });

                                garantias.forEach(gar => {
                                    formData[`garantia_${gar.id_garantia}`] = !!gar.ativo;
                                });

                                // Preenche observação do pedido
                                formData.observacao = response.data.observacaoPedido.observacao || '';

                                const documentosItems = documentos.map(doc => ({
                                    dataField: `documento_${doc.id_documento}`,
                                    editorType: "dxCheckBox",
                                    editorOptions: {
                                        text: doc.dsc_documento,
                                        width: '100%',
                                        elementAttr: { class: "custom-checkbox" },
                                        onValueChanged: function (e) {
                                            $.ajax({
                                                url: "/credito-e-cobranca/toggle-documento-pedido",
                                                method: "POST",
                                                contentType: "application/json",
                                                data: JSON.stringify({
                                                    id_pedido: idPedido,
                                                    id_documento: doc.id_documento,
                                                    checked: e.value,
                                                    grupoClienteID: grupoClienteID,
                                                    codigoSafra: codigoSafra
                                                }),
                                                success: function () {
                                                    DevExpress.ui.notify(
                                                        e.value ? "Documento vinculado com sucesso." : "Documento desvinculado com sucesso.",
                                                        "success", 2000
                                                    );
                                                },
                                                error: function () {
                                                    DevExpress.ui.notify(
                                                        e.value ? "Erro ao vincular documento." : "Erro ao desvincular documento.",
                                                        "error", 2000
                                                    );
                                                }
                                            });
                                        }
                                    },
                                    label: { visible: false }
                                }));

                                const garantiasItems = garantias.map(gar => ({
                                    dataField: `garantia_${gar.id_garantia}`,
                                    editorType: "dxCheckBox",
                                    editorOptions: {
                                        text: gar.dsc_garantia,
                                        width: '100%',
                                        elementAttr: { class: "custom-checkbox" },
                                        onValueChanged: function (e) {
                                            $.ajax({
                                                url: "/credito-e-cobranca/toggle-garantia-pedido",
                                                method: "POST",
                                                contentType: "application/json",
                                                data: JSON.stringify({
                                                    id_pedido: idPedido,
                                                    id_garantia: gar.id_garantia,
                                                    checked: e.value,
                                                    grupoClienteID: grupoClienteID,
                                                    codigoSafra: codigoSafra
                                                }),
                                                success: function () {
                                                    DevExpress.ui.notify(
                                                        e.value ? "Garantia vinculada com sucesso." : "Garantia desvinculada com sucesso.",
                                                        "success", 2000
                                                    );
                                                },
                                                error: function () {
                                                    DevExpress.ui.notify(
                                                        e.value ? "Erro ao vincular garantia." : "Erro ao desvincular garantia.",
                                                        "error", 2000
                                                    );
                                                }
                                            });
                                        }
                                    },
                                    label: { visible: false }
                                }));

                                formContainer.dxForm({
                                    formData: formData,
                                    labelLocation: "top",
                                    items: [
                                        {
                                            itemType: "group",
                                            caption: "Documentos",
                                            colCount: 2,
                                            items: documentosItems
                                        },
                                        {
                                            itemType: "group",
                                            caption: "Garantias",
                                            colCount: 2,
                                            items: garantiasItems
                                        },
                                        {
                                            itemType: "group",
                                            caption: "Duplicatas e Boletos",
                                            colCount: 1,
                                            items: [
                                                {
                                                    itemType: "simple",
                                                    template: function () {
                                                        return $("<div>").dxDataGrid({
                                                            dataSource: new DevExpress.data.ArrayStore({
                                                                key: 'ID',
                                                                data: response.data.duplicatasBoletos
                                                            }),
                                                            editing: {
                                                                mode: 'batch', 
                                                                allowUpdating: true,
                                                                allowDeleting: false,
                                                                useIcons: true,
                                                                selectTextOnEditStart: true,
                                                                startEditAction: 'click'
                                                            },
                                                            columns: [
                                                                { dataField: 'ID', visible: false },
                                                                {
                                                                    dataField: 'VENCIMENTO_PARCELA',
                                                                    caption: 'Venc. Parcela',
                                                                    allowEditing: false,
                                                                    alignment: 'center',
                                                                    dataType: 'date',
                                                                    format: 'dd/MM/yyyy',
                                                                    sortOrder: 'asc',
                                                                    cellTemplate: function(container, options) {
                                                                        container.css('background-color', '#f5f5f5'); // cinza claro
                                                                        container.text(options.text);
                                                                    }
                                                                },
                                                                {
                                                                    dataField: "BOLETO_EMITIDO",
                                                                    caption: "Boleto Emitido",
                                                                    dataType: "boolean",
                                                                    width: 130,
                                                                    allowEditing: false,
                                                                    cellTemplate: function(container, options) {
                                                                        container.css('background-color', '#f5f5f5'); // cinza claro
                                                                        $("<div>").dxCheckBox({ value: options.value, disabled: true }).appendTo(container);
                                                                    }
                                                                },
                                                                {
                                                                    dataField: "DUPLICATA_EMITIDA",
                                                                    caption: "Duplicata Emitida",
                                                                    dataType: "boolean",
                                                                    width: 130,
                                                                    allowEditing: false,
                                                                    cellTemplate: function(container, options) {
                                                                        container.css('background-color', '#f5f5f5'); // cinza claro
                                                                        $("<div>").dxCheckBox({ value: options.value, disabled: true }).appendTo(container);
                                                                    }
                                                                },
                                                                { 
                                                                    dataField: "BOLETO_RECEBIDO", 
                                                                    caption: "Boleto Recebido", 
                                                                    dataType: "boolean", 
                                                                    width: 130,
                                                                    cellTemplate: function(container, options) {
                                                                        container.css('background-color', '#ffffff'); // branco para editável
                                                                        $("<div>").dxCheckBox({ value: options.value }).appendTo(container);
                                                                    }
                                                                },
                                                                { 
                                                                    dataField: "DUPLICATA_RECEBIDO", 
                                                                    caption: "Duplicata Recebida", 
                                                                    dataType: "boolean", 
                                                                    width: 130,
                                                                    cellTemplate: function(container, options) {
                                                                        container.css('background-color', '#ffffff'); // branco para editável
                                                                        $("<div>").dxCheckBox({ value: options.value }).appendTo(container);
                                                                    }
                                                                }
                                                            ],
                                                            showBorders: true,
                                                            paging: { pageSize: 5 },
                                                            filterRow: { visible: true, applyFilter: "auto" },
                                                            height: 'auto',
                                                            onRowUpdating: function(e) {
                                                                // Prepara dados completos para envio
                                                                e.newData = { ...e.oldData, ...e.newData };

                                                                // Previna update local automático
                                                                e.cancel = true;

                                                                // Obtém store para atualizar manualmente depois
                                                                const store = e.component.getDataSource().store();

                                                                // Chamada AJAX para atualizar no backend
                                                                $.ajax({
                                                                    url: '/credito-e-cobranca/toggle-duplicata-boleto-pedido',
                                                                    method: 'PUT',
                                                                    contentType: 'application/json',
                                                                    data: JSON.stringify({ ID: e.key, ...e.newData }),
                                                                    dataType: 'json'
                                                                }).done(function(response) {
                                                                    if (response.success) {
                                                                        DevExpress.ui.notify(response.message, "success", 3000);

                                                                        // Atualiza localmente a store (faz o update refletir na grid)
                                                                        store.update(e.key, e.newData).done(() => {
                                                                            e.component.refresh(); // refresca a grid

                                                                            // Confirma o batch para limpar as bordas verdes
                                                                            e.component.saveEditData().then(() => {
                                                                                // Opcional: cancela edição (fecha a linha em edição)
                                                                                e.component.cancelEditData();
                                                                            });
                                                                        });

                                                                    } else {
                                                                        DevExpress.ui.notify(response.message, "error", 3000);
                                                                    }
                                                                }).fail(function() {
                                                                    DevExpress.ui.notify("Erro ao atualizar dados!", "error", 3000);
                                                                });
                                                            }
                                                        });

                                                    }
                                                }
                                            ]
                                        },
