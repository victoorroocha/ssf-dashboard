                                        }
                                    },
                                    label: { visible: false }
                                }));

                                const garantiasItems = garantias.map(gar => ({
                                    dataField: `garantia_${gar.id_garantia}`,
                                    editorType: "dxCheckBox",
                                    editorOptions: {
                                        text: gar.dsc_garantia,
                                        width: '100%',
                                        elementAttr: { class: "custom-checkbox" },
                                        onValueChanged: function (e) {
                                            $.ajax({
                                                url: "/credito-e-cobranca/toggle-garantia-pedido",
                                                method: "POST",
                                                contentType: "application/json",
                                                data: JSON.stringify({
                                                    id_pedido: idPedido,
                                                    id_garantia: gar.id_garantia,
                                                    checked: e.value,
                                                    grupoClienteID: grupoClienteID,
                                                    codigoSafra: codigoSafra
                                                }),
                                                success: function () {
                                                    DevExpress.ui.notify(
                                                        e.value ? "Garantia vinculada com sucesso." : "Garantia desvinculada com sucesso.",
                                                        "success", 2000
                                                    );
                                                },
                                                error: function () {
                                                    DevExpress.ui.notify(
                                                        e.value ? "Erro ao vincular garantia." : "Erro ao desvincular garantia.",
                                                        "error", 2000
                                                    );
                                                }
                                            });
                                        }
                                    },
                                    label: { visible: false }
