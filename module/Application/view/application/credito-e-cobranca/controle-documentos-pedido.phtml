        function selecionarAvalistasPopup(data) {
            const informacoesImpressao = data;
            const selectedItems = []; // ← manter referência fora do contentTemplate

            const popup = $('#popupAvalistas').dxPopup({
                title: "Selecionar Avalistas",
                visible: false,
                width: '50%',
                height: 'auto',
                showTitle: true,
                scrollingEnabled: true,
                closeOnOutsideClick: false,
                toolbarItems: [
                    {
                        widget: 'dxButton',
                        toolbar: 'bottom',
                        location: 'after',
                        options: {
                            text: 'Gerar Nota Promissória',
                            type: 'success',
                            onClick: function () {
                                informacoesImpressao.AVALISTAS = selectedItems;
                                gerarNotaPromissoria(informacoesImpressao);
                                popup.hide();
                            }
                        }
                    }
                ],
                contentTemplate: function (contentElement) {
                    const tagBox = $('<div id="tagBoxAvalistas"></div>').dxTagBox({
                        dataSource: new DevExpress.data.DataSource({
                            store: new DevExpress.data.CustomStore({
                                key: 'ID_CLIENTE',
                                load: function(loadOptions) {
                                    const deferred = $.Deferred();
                                    const searchValue = (loadOptions.searchValue || '').toUpperCase();

                                    if (!searchValue || searchValue.length < 3) {
                                        deferred.resolve(selectedItems, { totalCount: selectedItems.length });
                                        return deferred.promise();
                                    }

                                    return $.ajax({
                                        url: '/credito-e-cobranca/list-clientes-senior',
                                        dataType: 'json',
                                        data: { search: searchValue }
                                    }).then(result => {
                                        const data = result.data || [];

                                        // Garante que todos os selecionados estejam no datasource
                                        const mergedData = [...data];
                                        selectedItems.forEach(sel => {
                                            if (!mergedData.find(d => d.ID_CLIENTE === sel.ID_CLIENTE)) {
                                                mergedData.push(sel);
                                            }
                                        });

                                        return {
                                            data: mergedData,
                                            totalCount: mergedData.length
                                        };
                                    }).catch(() => {
                                        return { data: selectedItems, totalCount: selectedItems.length };
                                    });
                                }
                            }),
                            paginate: false,
                            pageSize: 30
                        }),
                        valueExpr: 'ID_CLIENTE',
                        displayExpr: 'NOME_CLIENTE',
                        placeholder: 'Pesquise e selecione os avalistas',
                        showSelectionControls: true,
                        searchEnabled: true,
                        applyValueMode: 'useButtons',
                        minSearchLength: 3,
                        noDataText: 'Digite pelo menos 3 caracteres para procurar...',
                        multiSelect: true,
                        showMultiTagOnly: false,
                        selectAllMode: 'page',
                        onSelectionChanged: function(e) {
                            // e.addedItems → itens que foram adicionados
                            // e.removedItems → itens que foram removidos

                            // Adiciona os novos selecionados
                            e.addedItems.forEach(item => {
                                if (!selectedItems.find(sel => sel.ID_CLIENTE === item.ID_CLIENTE)) {
                                    selectedItems.push(item);
                                }
                            });

                            // Remove os itens desmarcados
                            e.removedItems.forEach(item => {
                                const index = selectedItems.findIndex(sel => sel.ID_CLIENTE === item.ID_CLIENTE);
                                if (index > -1) selectedItems.splice(index, 1);
                            });
                        }
                    });

                    contentElement.append(tagBox);
                },
                onHidden: function () {
                    $('#popupAvalistas').empty();
                },
            }).dxPopup('instance');

            popup.show();
        }
