                                                            const observacao = e.value;

                                                            if (!idPedido) {
                                                                DevExpress.ui.notify('ID do pedido não está definido.', 'error', 3000);
                                                                return;
                                                            }

                                                            $.ajax({
                                                                url: '/credito-e-cobranca/salvar-observacao-pedido',
                                                                method: 'POST',
                                                                contentType: 'application/json',
                                                                data: JSON.stringify({
                                                                    idPedido: idPedido,
                                                                    observacao: observacao,
                                                                    grupoClienteID: grupoClienteID,
                                                                    codigoSafra: codigoSafra
                                                                }),
                                                                success: function (res) {
                                                                    if (res.success) {
                                                                        DevExpress.ui.notify(res.message, 'success', 2000);
                                                                    } else {
                                                                        DevExpress.ui.notify(res.message, 'error', 3000);
                                                                    }
                                                                },
                                                                error: function () {
                                                                    DevExpress.ui.notify('Erro ao salvar observação.', 'error', 3000);
                                                                }
                                                            });
                                                        },
                                                        stylingMode: "outlined",
                                                        placeholder: "Digite a observação aqui...",
                                                        elementAttr: {
                                                            class: "custom-textarea"
                                                        }
                                                    },
                                                    label: {
                                                        text: 'Observação do Pedido',
                                                        location: 'top',
                                                        visible: false
                                                    },
                                                    cssClass: "observacao-field"
                                                }
                                            ]
                                        }
                                    ]
                                });

                                const scrollableContent = $("<div>").dxScrollView({
                                    height: 'calc(90vh - 100px)',
                                    showScrollbar: "onHover",
                                    direction: "vertical",
                                    scrollByContent: true
                                });

                                scrollableContent.find('.dx-scrollview-content').append(formContainer);
                                contentElement.append(scrollableContent);

                            },
                            onHidden: function () {
                                if (typeof dataGrid !== 'undefined') {
                                    dataGrid.refresh();
                                }
                            },
                        }).dxPopup('instance');

                        popup.show();
                    }
                },
                error: function () {
                    alert("Erro ao carregar documentos e garantias.");
                }
            });
        }
        async function imprimirDocumentosPedido(data) {
            let idPedido = data.ID_PEDIDO;
            let tipoPessoa = data.TIPO_PESSOA;
            let grupoClienteID = data.GRUPO_CLIENTE;
            let codigoSafra = data.CODIGOSAFRA;

            if (!idPedido) {
                DevExpress.ui.notify('ID do pedido não está definido.', 'error', 3000);
                return;
            } 
            if (!tipoPessoa) {
                DevExpress.ui.notify('Tipo de pessoa não está definido.', 'error', 3000);
                return;
            }
            if (!grupoClienteID) {
                DevExpress.ui.notify('Grupo de cliente não está definido.', 'error', 3000);
                return;
            }
            if (!codigoSafra) {
                DevExpress.ui.notify('Código da safra não está definido.', 'error', 3000);
                return;
            }

            // Dados do cliente
            const dadosCliente = data;

            $.ajax({
                url: "/credito-e-cobranca/list-documentos-pedido",
                method: 'GET',
                data: {
                    idPedido: idPedido,
                    tipoPessoa: tipoPessoa,
                    grupoClienteID: grupoClienteID,
                    codigoSafra: codigoSafra
                },
                success: async function(response) {
                    try {
                        if (!response.data) {
                            throw new Error('Dados de resposta inválidos');
                        }

                        // Limpa a section antes de inserir conteúdo novo
                        $("#print-area").empty();

                        // Cria cabeçalho
                        const cabecalho = $(`
                            <div class="cabecalho-content hidden-print">
                                <div class="cabecalho-logo-div"></div>
                                <h3>Quem planta, planta qualidade!</h3>
                            </div>
                            <br />
                        `);

                        // Adiciona cabeçalho à section
                        $("#print-area").append(cabecalho);

                        const formData = {};
                        const documentos = response.data.documentos || [];
                        const garantias = response.data.garantias || [];
                        

                        // region CABEÇALHO
                            $("#print-area").append(`
                                <div class="hidden-print checklist-cadastro" style="font-family: Arial, sans-serif; color: #000;">
                                    <div style="border: 2px solid #444; border-radius: 6px; padding: 0; margin-bottom: 16px; overflow: hidden;">
                                        <div style="background-color: #006400; color: white; text-align: center; font-size: 26px; font-weight: bold; padding: 10px;">
                                            CHECK LIST DOCUMENTOS CADASTRO
                                        </div>
                                        <table style="width: 100%; border-collapse: collapse; font-size: 26px;">
