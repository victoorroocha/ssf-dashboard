                                                                { dataField: 'ID', visible: false },
                                                                {
                                                                    dataField: 'VENCIMENTO_PARCELA',
                                                                    caption: 'Venc. Parcela',
                                                                    allowEditing: false,
                                                                    alignment: 'center',
                                                                    dataType: 'date',
                                                                    format: 'dd/MM/yyyy',
                                                                    sortOrder: 'asc',
                                                                    cellTemplate: function(container, options) {
                                                                        container.css('background-color', '#f5f5f5'); // cinza claro
                                                                        container.text(options.text);
                                                                    }
                                                                },
                                                                {
                                                                    dataField: "BOLETO_EMITIDO",
                                                                    caption: "Boleto Emitido",
                                                                    dataType: "boolean",
                                                                    width: 130,
                                                                    allowEditing: false,
                                                                    cellTemplate: function(container, options) {
                                                                        container.css('background-color', '#f5f5f5'); // cinza claro
                                                                        $("<div>").dxCheckBox({ value: options.value, disabled: true }).appendTo(container);
                                                                    }
                                                                },
                                                                {
                                                                    dataField: "DUPLICATA_EMITIDA",
                                                                    caption: "Duplicata Emitida",
                                                                    dataType: "boolean",
                                                                    width: 130,
                                                                    allowEditing: false,
                                                                    cellTemplate: function(container, options) {
                                                                        container.css('background-color', '#f5f5f5'); // cinza claro
                                                                        $("<div>").dxCheckBox({ value: options.value, disabled: true }).appendTo(container);
                                                                    }
                                                                },
                                                                { 
                                                                    dataField: "BOLETO_RECEBIDO", 
                                                                    caption: "Boleto Recebido", 
                                                                    dataType: "boolean", 
                                                                    width: 130,
                                                                    cellTemplate: function(container, options) {
                                                                        container.css('background-color', '#ffffff'); // branco para editável
                                                                        $("<div>").dxCheckBox({ value: options.value }).appendTo(container);
                                                                    }
                                                                },
                                                                { 
                                                                    dataField: "DUPLICATA_RECEBIDO", 
                                                                    caption: "Duplicata Recebida", 
                                                                    dataType: "boolean", 
                                                                    width: 130,
                                                                    cellTemplate: function(container, options) {
                                                                        container.css('background-color', '#ffffff'); // branco para editável
                                                                        $("<div>").dxCheckBox({ value: options.value }).appendTo(container);
                                                                    }
                                                                }
                                                            ],
                                                            showBorders: true,
                                                            paging: { pageSize: 5 },
                                                            filterRow: { visible: true, applyFilter: "auto" },
                                                            height: 'auto',
                                                            onRowUpdating: function(e) {
                                                                // Prepara dados completos para envio
                                                                e.newData = { ...e.oldData, ...e.newData };

                                                                // Previna update local automático
                                                                e.cancel = true;

                                                                // Obtém store para atualizar manualmente depois
                                                                const store = e.component.getDataSource().store();

                                                                // Chamada AJAX para atualizar no backend
                                                                $.ajax({
                                                                    url: '/credito-e-cobranca/toggle-duplicata-boleto-pedido',
                                                                    method: 'PUT',
                                                                    contentType: 'application/json',
                                                                    data: JSON.stringify({ ID: e.key, ...e.newData }),
                                                                    dataType: 'json'
                                                                }).done(function(response) {
                                                                    if (response.success) {
                                                                        DevExpress.ui.notify(response.message, "success", 3000);

                                                                        // Atualiza localmente a store (faz o update refletir na grid)
                                                                        store.update(e.key, e.newData).done(() => {
                                                                            e.component.refresh(); // refresca a grid

                                                                            // Confirma o batch para limpar as bordas verdes
                                                                            e.component.saveEditData().then(() => {
                                                                                // Opcional: cancela edição (fecha a linha em edição)
                                                                                e.component.cancelEditData();
                                                                            });
                                                                        });

                                                                    } else {
                                                                        DevExpress.ui.notify(response.message, "error", 3000);
                                                                    }
                                                                }).fail(function() {
                                                                    DevExpress.ui.notify("Erro ao atualizar dados!", "error", 3000);
                                                                });
                                                            }
                                                        });

                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            itemType: "group",
                                            caption: "Observação do Pedido",
                                            colCount: 1,
                                            items: [
                                                {
                                                    dataField: 'observacao',
                                                    editorType: 'dxTextArea',
                                                    editorOptions: {
                                                        height: 150,
                                                        onValueChanged: function (e) {
                                                            const observacao = e.value;

                                                            if (!idPedido) {
                                                                DevExpress.ui.notify('ID do pedido não está definido.', 'error', 3000);
                                                                return;
                                                            }

                                                            $.ajax({
                                                                url: '/credito-e-cobranca/salvar-observacao-pedido',
                                                                method: 'POST',
                                                                contentType: 'application/json',
                                                                data: JSON.stringify({
                                                                    idPedido: idPedido,
                                                                    observacao: observacao,
                                                                    grupoClienteID: grupoClienteID,
                                                                    codigoSafra: codigoSafra
                                                                }),
                                                                success: function (res) {
                                                                    if (res.success) {
                                                                        DevExpress.ui.notify(res.message, 'success', 2000);
                                                                    } else {
                                                                        DevExpress.ui.notify(res.message, 'error', 3000);
                                                                    }
                                                                },
                                                                error: function () {
                                                                    DevExpress.ui.notify('Erro ao salvar observação.', 'error', 3000);
                                                                }
                                                            });
                                                        },
                                                        stylingMode: "outlined",
                                                        placeholder: "Digite a observação aqui...",
                                                        elementAttr: {
                                                            class: "custom-textarea"
                                                        }
                                                    },
                                                    label: {
                                                        text: 'Observação do Pedido',
                                                        location: 'top',
                                                        visible: false
                                                    },
                                                    cssClass: "observacao-field"
                                                }
                                            ]
                                        }
                                    ]
                                });

                                const scrollableContent = $("<div>").dxScrollView({
                                    height: 'calc(90vh - 100px)',
                                    showScrollbar: "onHover",
                                    direction: "vertical",
                                    scrollByContent: true
                                });

                                scrollableContent.find('.dx-scrollview-content').append(formContainer);
                                contentElement.append(scrollableContent);

                            },
                            onHidden: function () {
                                if (typeof dataGrid !== 'undefined') {
                                    dataGrid.refresh();
                                }
                            },
                        }).dxPopup('instance');

                        popup.show();
                    }
                },
                error: function () {
                    alert("Erro ao carregar documentos e garantias.");
                }
            });
        }

        async function imprimirDocumentosPedido(data) {
            let idPedido = data.ID_PEDIDO;
            let tipoPessoa = data.TIPO_PESSOA;
            let grupoClienteID = data.GRUPO_CLIENTE;
            let codigoSafra = data.CODIGOSAFRA;

            if (!idPedido) {
                DevExpress.ui.notify('ID do pedido não está definido.', 'error', 3000);
                return;
            } 
            if (!tipoPessoa) {
                DevExpress.ui.notify('Tipo de pessoa não está definido.', 'error', 3000);
                return;
            }
            if (!grupoClienteID) {
                DevExpress.ui.notify('Grupo de cliente não está definido.', 'error', 3000);
                return;
            }
            if (!codigoSafra) {
                DevExpress.ui.notify('Código da safra não está definido.', 'error', 3000);
                return;
