        // Função para formatar data
        function formatarData(data) {
            if (!data) return '';
            return moment(data, 'YYYY-MM-DD').format('DD/MM/YYYY');
        }
        function formatarDataPorExtenso(dataString) {
            const meses = [
                "janeiro", "fevereiro", "março", "abril", "maio", "junho",
                "julho", "agosto", "setembro", "outubro", "novembro", "dezembro"
            ];

            console.log('dataString', dataString);

            const partes = dataString.split('/'); // [dia, mês, ano]
            console.log('partes', partes);
            const dia = partes[0];
            const mes = meses[parseInt(partes[1], 10) - 1];
            const ano = partes[2];

            return `${dia} de ${mes} de ${ano}`;
        }
        // Função para formatar valores monetários por extenso (suporte até bilhões)
        function numeroPorExtenso(valor) {
            if (valor === null || valor === undefined || valor === '') return 'Zero reais';
            
            const num = parseFloat(valor);
            if (isNaN(num)) return 'Valor inválido';
            
            if (num === 0) return 'Zero reais';
            
            const unidades = ['', 'um', 'dois', 'três', 'quatro', 'cinco', 
                            'seis', 'sete', 'oito', 'nove'];
            const dez_a_dezenove = ['dez', 'onze', 'doze', 'treze', 'quatorze', 
                                'quinze', 'dezesseis', 'dezessete', 'dezoito', 'dezenove'];
            const dezenas = ['', 'dez', 'vinte', 'trinta', 'quarenta', 'cinquenta', 
                            'sessenta', 'setenta', 'oitenta', 'noventa'];
            const centenas = ['', 'cento', 'duzentos', 'trezentos', 'quatrocentos', 
                            'quinhentos', 'seiscentos', 'setecentos', 'oitocentos', 'novecentos'];
            
            function converterTrio(trio) {
                if (trio === 0) return '';
                if (trio === 100) return 'cem';
                
                const c = Math.floor(trio / 100);
                const d = Math.floor((trio % 100) / 10);
                const u = trio % 10;
                
                let extenso = '';
                
                if (c > 0) extenso += centenas[c];
                
                if (d > 0) {
                    if (c > 0) extenso += ' e ';
                    if (d === 1) {
                        extenso += dez_a_dezenove[u];
                        return extenso;
                    } else {
                        extenso += dezenas[d];
                    }
                }
                
                if (u > 0) {
                    if ((c > 0 || d > 0) && d !== 1) extenso += ' e ';
                    extenso += unidades[u];
                }
                
                return extenso;
            }
            
            const inteiro = Math.floor(num);
            let extenso = '';
            let resto = inteiro;
            
            // Bilhões
            if (resto >= 1000000000) {
                const bilhoes = Math.floor(resto / 1000000000);
                extenso += converterTrio(bilhoes) + (bilhoes === 1 ? ' bilhão' : ' bilhões');
                resto %= 1000000000;
                if (resto > 0) extenso += ' ';
            }
            
            // Milhões
            if (resto >= 1000000) {
                const milhoes = Math.floor(resto / 1000000);
                extenso += converterTrio(milhoes) + (milhoes === 1 ? ' milhão' : ' milhões');
                resto %= 1000000;
                if (resto > 0) extenso += ' ';
            }
            
            // Milhares
            if (resto >= 1000) {
                const mil = Math.floor(resto / 1000);
                extenso += (mil === 1 ? 'mil' : converterTrio(mil) + ' mil');
                resto %= 1000;
                if (resto > 0) extenso += ' ';
            }
            
            // Unidades
            if (resto > 0 || inteiro === 0) {
                extenso += converterTrio(resto);
            }
            
            extenso = extenso.trim();
            extenso += inteiro === 1 ? ' real' : ' reais';
            
            // Centavos
            const centavos = Math.round((num - inteiro) * 100);
            if (centavos > 0) {
                extenso += ' e ' + (centavos === 1 ? 'um centavo' : converterTrio(centavos) + ' centavos');
            }
            
            // Capitaliza a primeira letra
            return extenso.charAt(0).toUpperCase() + extenso.slice(1);
        }
        // Função para formatar moeda (completa)
        function formatarMoeda(valor) {
            if (valor === null || valor === undefined || valor === '') return 'R$ 0,00';
            
            const num = parseFloat(valor);
            if (isNaN(num)) return 'R$ 0,00';
            
            return num.toLocaleString('pt-BR', {
                style: 'currency',
                currency: 'BRL',
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }
        // Função para formatar CPF/CNPJ tratando double e completando zeros
        function formatarCPFCNPJ(documento, tipoPessoa) {
            if (!documento) return '';
            
            // Converte para string e remove caracteres não numéricos
            let numeros = documento.toString().replace(/\D/g, '');
            
            // Completa com zeros à esquerda conforme o tipo
            if (tipoPessoa === 'PF') {
                numeros = numeros.padStart(11, '0'); // CPF precisa ter 11 dígitos
            } else {
                numeros = numeros.padStart(14, '0'); // CNPJ precisa ter 14 dígitos
            }
            
            // Aplica a formatação
            if (tipoPessoa === 'PF' && numeros.length === 11) {
                return numeros.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4');
            } else if (tipoPessoa === 'PJ' && numeros.length === 14) {
                return numeros.replace(/(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/, '$1.$2.$3/$4-$5');
            }
            
            return documento; // Retorna original se não for possível formatar
        }


        function criarTabelaDuplicatasBoletos(data) {
            // Cria tabela
            const $table = $('<table>').css({
                width: '95%',
                margin: '0 auto',
                borderCollapse: 'collapse',
                fontFamily: 'Arial, sans-serif',
                fontSize: '26px',
                border: '1px solid #ddd'
            });

            // Cria cabeçalho
            const $thead = $('<thead>').appendTo($table);
            const $headerRow = $('<tr>').appendTo($thead);
            const colunas = [
                // id escondido (não exibe)
                // { field: 'ID', visible: false }
                { caption: 'Venc. Parcela', field: 'VENCIMENTO_PARCELA' },
                { caption: 'Boleto Emitido', field: 'BOLETO_EMITIDO' },
                { caption: 'Duplicata Emitida', field: 'DUPLICATA_EMITIDA' },
                { caption: 'Boleto Recebido', field: 'BOLETO_RECEBIDO', editable: true },
                { caption: 'Duplicata Recebida', field: 'DUPLICATA_RECEBIDO', editable: true }
            ];

            colunas.forEach(col => {
                $('<th>').text(col.caption).css({
                border: '1px solid #ddd',
                padding: '8px',
                backgroundColor: '#006400',
                color: 'white',
                textAlign: 'center',
                fontSize: '22px'
                }).appendTo($headerRow);
            });

            // Cria corpo da tabela
            const $tbody = $('<tbody>').appendTo($table);

            data.forEach(row => {
                const $tr = $('<tr>').appendTo($tbody);

                colunas.forEach(col => {
                const valor = row[col.field];

                const $td = $('<td>').css({
                    border: '1px solid #ddd',
                    padding: '8px',
                    textAlign: col.field === 'VENCIMENTO_PARCELA' ? 'center' : 'left',
                    backgroundColor: (col.editable) ? '#fff' : '#f5f5f5',
                    fontSize: '22px'
                }).appendTo($tr);

                if (col.field === 'VENCIMENTO_PARCELA') {
                    // Formata data dd/MM/yyyy
                    const dataFormatada = new Date(valor).toLocaleDateString('pt-BR');
                    $td.text(dataFormatada);
                } else if (typeof valor === 'boolean') {
                    // Checkbox, somente editável se permitido
                    const $checkbox = $('<input type="checkbox">').prop('checked', valor);

                    if (!col.editable) {
                    $checkbox.prop('disabled', true);
                    }

                    $checkbox.appendTo($td);

                    if (col.editable) {
                    // Evento ao mudar checkbox editável
                    $checkbox.on('change', () => {
                        const novoValor = $checkbox.prop('checked');
                        // Envia update via AJAX
                        $.ajax({
                        url: '/credito-e-cobranca/toggle-duplicata-boleto-pedido',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            ID: row.ID,
                            [col.field]: novoValor
                        }),
                        dataType: 'json'
                        }).done(response => {
                        if (response.success) {
                            DevExpress.ui.notify(response.message, "success", 3000);
                        } else {
                            DevExpress.ui.notify(response.message, "error", 3000);
                            // Reverte checkbox
                            $checkbox.prop('checked', !novoValor);
                        }
                        }).fail(() => {
                        DevExpress.ui.notify("Erro ao atualizar dados!", "error", 3000);
                        $checkbox.prop('checked', !novoValor);
                        });
                    });
                    }
                } else {
                    $td.text(valor);
                }
                });
            });

            return $table;
        }
    });
    
</script>
