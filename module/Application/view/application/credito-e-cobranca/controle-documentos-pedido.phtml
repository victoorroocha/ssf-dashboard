                                <hr style="border: none; border-top: 2px solid #444; margin-bottom: 16px;" />

                                <div id="grupo-observacao-pedido" style="margin-bottom: 24px;">
                                    <div style="background-color: #006400; color: white; padding: 8px 12px; border-radius: 6px 6px 0 0; font-size: 18px; font-weight: bold;">
                                        04. Observação do Pedido
                                    </div>
                                    <textarea id="observacaoPedido" 
                                        style="width: 100%; padding: 8px; font-size: 14px; border-radius: 0 0 6px 6px; border: 1px solid #ccc; resize: none; margin: 0 auto; display: block;"
                                        placeholder="Não há observações..."></textarea>
                                </div>
                            `);
                            // Preenche o textarea com o valor da observação, ou vazio se não houver
                            const obs = response.data.observacaoPedido?.observacao || '';
                            const $textarea = $("#observacaoPedido");
                            $textarea.val(obs);

                            // Ajusta a altura para caber todo o texto
                            $textarea.css('height', 'auto');
                            $textarea.css('height', $textarea[0].scrollHeight + 'px');
                        //#endregion

                        //#region IMPRIMIR E GERAR PDF - Versão Corrigida
                            const loading = document.getElementById('globalLoading');
                            const spinnerGen = document.getElementById('spinnerGeneric');
                            const spinnerPDF = document.getElementById('spinnerPDF');
                            const loadingText = document.getElementById('loadingText');

                            loading.style.display = 'flex';
                            spinnerGen.style.display = 'none';
                            spinnerPDF.style.display = 'block';
                            loadingText.textContent = 'Gerando PDF…';

                            try {
                                const printArea = document.getElementById('print-area');
                                
                                // Adiciona timeout para garantir renderização
                                await new Promise(resolve => setTimeout(resolve, 100));
                                
                                const canvas = await html2canvas(printArea, {
                                    scale: 1.5,
                                    useCORS: true,
                                    logging: true,
                                    allowTaint: true,
                                    backgroundColor: '#fff',
                                    onclone: (clonedDoc) => {
                                        // Mostrar cabeçalho
                                        const cabecalho = clonedDoc.querySelector('.cabecalho-content');
                                        if (cabecalho) {
                                            cabecalho.classList.remove('hidden-print');
                                            cabecalho.style.backgroundColor = '#006400';
                                            cabecalho.style.color = 'white';
                                            cabecalho.style.padding = '10px 20px';
                                            cabecalho.style.textAlign = 'center';
                                        }
                                        
                                        // Mostrar todos os elementos que devem aparecer no PDF
                                        const elementsToShow = clonedDoc.querySelectorAll('.hidden-print');
                                        elementsToShow.forEach(el => el.classList.remove('hidden-print'));

                                            // Substituir textarea por div com texto para impressão
                                            const obsTextarea = clonedDoc.querySelector('#observacaoPedido');
                                            if (obsTextarea) {
                                                const texto = obsTextarea.value || obsTextarea.placeholder || '';
                                                const divObs = clonedDoc.createElement('div');

                                                divObs.style.width = '100%';
                                                divObs.style.padding = '8px';
                                                divObs.style.fontSize = '14px';
                                                divObs.style.border = '1px solid #ccc';
                                                divObs.style.borderRadius = '0 0 6px 6px';
                                                divObs.style.whiteSpace = 'pre-wrap';  // preserva quebras de linha
                                                divObs.style.minHeight = '50px';
                                                divObs.textContent = texto;

                                                obsTextarea.parentNode.replaceChild(divObs, obsTextarea);
                                            }
                                    }
                                });

                                const { jsPDF } = window.jspdf;
                                const pdf = new jsPDF('p', 'mm', 'a4');
                                const pageWidth = pdf.internal.pageSize.getWidth();
                                const pageHeight = pdf.internal.pageSize.getHeight();
                                const margemMm = 30 * 0.264583;

                                const imgData = canvas.toDataURL('image/png', 1.0);
                                const props = pdf.getImageProperties(imgData);

                                const pdfWidth = pageWidth - 2 * margemMm;
                                const maxPdfHeight = pageHeight - 2 * margemMm;

                                let pdfHeight = (props.height * pdfWidth) / props.width;
                                if (pdfHeight > maxPdfHeight) {
                                    pdfHeight = maxPdfHeight;
                                }

                                pdf.addImage(
                                    imgData,
                                    'PNG',
                                    margemMm,
                                    margemMm,
                                    pdfWidth,
                                    pdfHeight,
                                    undefined,
                                    'FAST'
                                );

                                pdf.save('informacoes-documentos-pedido.pdf');
                            } catch (err) {
                                console.error('Erro ao gerar PDF:', err);
                                alert('Erro ao gerar PDF. Verifique o console para detalhes.');
                            } finally {
                                spinnerPDF.style.display = 'none';
                                spinnerGen.style.display = 'block';
                                loadingText.textContent = 'Carregando Informações...';
                                loading.style.display = 'none';
                            }                            
                        //#endregion

                    } catch (error) {
                        console.error('Erro no processamento:', error);
                        DevExpress.ui.notify('Erro ao processar documentos: ' + error.message, 'error', 5000);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Erro na requisição:', status, error);
                    DevExpress.ui.notify('Falha na requisição: ' + error, 'error', 5000);
                }
            });
        }

        function criarTabelaDuplicatasBoletos(data) {
            // Cria tabela
            const $table = $('<table>').css({
                width: '95%',
                margin: '0 auto',
                borderCollapse: 'collapse',
                fontFamily: 'Arial, sans-serif',
                fontSize: '14px',
                border: '1px solid #ddd'
            });

            // Cria cabeçalho
            const $thead = $('<thead>').appendTo($table);
            const $headerRow = $('<tr>').appendTo($thead);
            const colunas = [
                // id escondido (não exibe)
                // { field: 'ID', visible: false }
                { caption: 'Venc. Parcela', field: 'VENCIMENTO_PARCELA' },
                { caption: 'Boleto Emitido', field: 'BOLETO_EMITIDO' },
                { caption: 'Duplicata Emitida', field: 'DUPLICATA_EMITIDA' },
                { caption: 'Boleto Recebido', field: 'BOLETO_RECEBIDO', editable: true },
                { caption: 'Duplicata Recebida', field: 'DUPLICATA_RECEBIDO', editable: true }
            ];

            colunas.forEach(col => {
                $('<th>').text(col.caption).css({
                border: '1px solid #ddd',
                padding: '8px',
                backgroundColor: '#006400',
                color: 'white',
                textAlign: 'center',
                fontSize: '12px'
                }).appendTo($headerRow);
            });

            // Cria corpo da tabela
            const $tbody = $('<tbody>').appendTo($table);

            data.forEach(row => {
                const $tr = $('<tr>').appendTo($tbody);

                colunas.forEach(col => {
                const valor = row[col.field];

                const $td = $('<td>').css({
                    border: '1px solid #ddd',
                    padding: '8px',
                    textAlign: col.field === 'VENCIMENTO_PARCELA' ? 'center' : 'left',
                    backgroundColor: (col.editable) ? '#fff' : '#f5f5f5',
                    fontSize: '12px'
                }).appendTo($tr);

                if (col.field === 'VENCIMENTO_PARCELA') {
                    // Formata data dd/MM/yyyy
                    const dataFormatada = new Date(valor).toLocaleDateString('pt-BR');
                    $td.text(dataFormatada);
                } else if (typeof valor === 'boolean') {
                    // Checkbox, somente editável se permitido
                    const $checkbox = $('<input type="checkbox">').prop('checked', valor);

                    if (!col.editable) {
                    $checkbox.prop('disabled', true);
                    }

                    $checkbox.appendTo($td);

                    if (col.editable) {
                    // Evento ao mudar checkbox editável
                    $checkbox.on('change', () => {
                        const novoValor = $checkbox.prop('checked');
                        // Envia update via AJAX
                        $.ajax({
                        url: '/credito-e-cobranca/toggle-duplicata-boleto-pedido',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            ID: row.ID,
                            [col.field]: novoValor
                        }),
                        dataType: 'json'
                        }).done(response => {
                        if (response.success) {
                            DevExpress.ui.notify(response.message, "success", 3000);
                        } else {
                            DevExpress.ui.notify(response.message, "error", 3000);
                            // Reverte checkbox
                            $checkbox.prop('checked', !novoValor);
                        }
                        }).fail(() => {
                        DevExpress.ui.notify("Erro ao atualizar dados!", "error", 3000);
                        $checkbox.prop('checked', !novoValor);
                        });
                    });
                    }
                } else {
                    $td.text(valor);
                }
                });
            });

            return $table;
        }
    });
    
</script>
