<script>
    // Variáveis globais para armazenar os valores selecionados
    const formSelections = {
        codigoSafra: "163",
        dataInicio: null,
        dataFim: null
    };

    $(document).ready(function() {
        // BTN Exportar PDF - Versão corrigida
        document.getElementById('btnExportPDF').addEventListener('click', async function () {
            const loading = document.getElementById('globalLoading');
            const spinnerGen = document.getElementById('spinnerGeneric');
            const spinnerPDF = document.getElementById('spinnerPDF');
            const loadingText = document.getElementById('loadingText');

            loading.style.display = 'flex';
            spinnerGen.style.display = 'none';
            spinnerPDF.style.display = 'block';
            loadingText.textContent = 'Gerando PDF…';

            try {
                const printArea = document.getElementById('print-area');

                const canvas = await html2canvas(printArea, {
                    scale: 2,
                    useCORS: true,
                    logging: true,
                    allowTaint: true,
                    backgroundColor: null,
                    onclone: (clonedDoc) => {
                        const cabecalho = clonedDoc.querySelector('.cabecalho-content');
                        if (cabecalho) {
                            cabecalho.classList.remove('hidden-print');
                            cabecalho.style.backgroundColor = '#006400';
                            cabecalho.style.color = 'white';
                            cabecalho.style.padding = '10px 20px';
                            cabecalho.style.textAlign = 'center';
                        }
                    }
                });

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4');
                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                const margemMm = 30 * 0.264583;

                const imgData = canvas.toDataURL('image/png', 1.0);
                const props = pdf.getImageProperties(imgData);

                const pdfWidth = pageWidth - 2 * margemMm;
                const pdfHeight = (props.height * pdfWidth) / props.width;

                let heightLeft = pdfHeight;
                let position = 0;
                let pageNumber = 1;

                while (heightLeft > 0) {
                    if (pageNumber > 1) {
                        pdf.addPage();
                    }

                    pdf.addImage(
                        imgData,
                        'PNG',
                        margemMm,
                        margemMm - position,
                        pdfWidth,
                        pdfHeight,
                        undefined,
                        'FAST'
                    );

                    heightLeft -= pageHeight - 2 * margemMm;
                    position += pageHeight - 2 * margemMm;
                    pageNumber++;
                }

                pdf.save('dashboard-monitoramento-pedidos.pdf');
            } catch (err) {
                console.error('Erro ao gerar PDF:', err);
                alert('Erro ao gerar PDF. Verifique o console para detalhes.');
            } finally {
                spinnerPDF.style.display = 'none';
                spinnerGen.style.display = 'block';
                loadingText.textContent = 'Carregando Informações...';
                loading.style.display = 'none';
            }
        });

        // Inicializa o formulário e rangeSelector
        const formInstance = $("#form-container").dxForm({
            formData: {},
            colCount: 1,
            items: [
                {
                    itemType: "group",
                    colCount: 1,
                    items: [
                        {
                            dataField: "codigoSafra",
                            editorType: "dxSelectBox",
                            label: { visible: false },
                            editorOptions: getSelectBoxOptions("/credito-e-cobranca/get-lookup-safra", "dsc", "codigosafra", "Selecione a Safra")
                        }
                    ]
                },
            ],
            onFieldDataChanged: function(e) {
                // Atualiza a variável global quando um campo é alterado
                formSelections[e.dataField] = e.value;
                
            }
        }).dxForm("instance");

        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: "raw",
                    load: function() {
                        return $.ajax({
                            url: url,
                            method: "GET",
                            dataType: "json"
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, "error", 3000);
                                return [];
                            }
                        }).catch(error => {
                            DevExpress.ui.notify("Erro ao buscar dados!", "error", 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true,
                onValueChanged: function(e) {
                    atualizarInfosDashboad();
                }
            };
        }

        // Inicializa o Range Selector
        const today = moment();
        const startYear = 2023; // definido para pegar historico de 2023 pra k.
        const startOfMonth = today.clone().startOf('month');  // Primeiro dia do mês atual
        const endOfMonth = today.clone().endOf('month');     // Último dia do mês atual

        // Define valores iniciais nas variáveis globais
        formSelections.dataInicio = moment(startOfMonth.toDate()).format("YYYY-MM-DD"); 
        formSelections.dataFim = moment(endOfMonth.toDate()).format("YYYY-MM-DD");

        const rangeSelectorInstance = $("#range-selector").dxRangeSelector({
            width: '100%',
            scale: {
                startValue: moment(`${startYear}-01-01`).toDate(),
                endValue: today.clone().endOf('year').toDate(),
                minorTickInterval: "month",
                tickInterval: "month",
                useTicks: true,
                label: { format: "MMM yyyy" }
            },
            value: [startOfMonth.toDate(), endOfMonth.toDate()],  // Intervalo: primeiro dia do mês até o último dia
            sliderMarker: { format: "monthAndYear" },
            behavior: { callValueChanged: "onMovingComplete" }, // Alterado para "onMovingComplete"
            applyValueMode: "onHandleRelease",
            onInitialized: function(e) {
                atualizarInfosDashboad();
            },
            onValueChanged: function(e) {
                const startDate = moment(e.value[0]);
                const endDate = moment(e.value[1]).subtract(1, 'days'); // quando faz o changed sempre pega dia 01 do proximo mes ao selecionado. Tratei pra subtrair um dia, pegando o ultimo dia do mes selecionado.

                formSelections.dataInicio = moment(startDate.toDate()).format("YYYY-MM-DD");
                formSelections.dataFim = moment(endDate.toDate()).format("YYYY-MM-DD");
                
                atualizarInfosDashboad();
            }
        }).dxRangeSelector("instance");

    });

    // Função para atualizar informações do dashboard
    function atualizarInfosDashboad() {
        // Mostra o loading
        $('#globalLoading').hide();

        const dataInicio = moment(formSelections.dataInicio, 'YYYY-MM-DD');
        const dataFim = moment(formSelections.dataFim, 'YYYY-MM-DD');

        let textoPeriodo = '';

        if (dataInicio.isSame(dataFim, 'month')) {
            textoPeriodo = dataInicio.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase());
        } else {
            textoPeriodo = `${dataInicio.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase())} à ${dataFim.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase())}`;
        }

        $('#periodo-apuracao').text(textoPeriodo);
        console.log('formSelections', formSelections);

        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/credito-e-cobranca/listar-dados-monitoramento-pedidos-safra',
                method: 'GET',
                dataType: 'json',
                data: formSelections,
                success: function(response) {
                    if (response.success) {
                            // INICIO CARDS
                            // Acessar os dados do objeto
                            const infoCardsMonitoramentoPedidos = response.data.infoCardsMonitoramentoPedidos;

                            const formatadorMoeda = new Intl.NumberFormat('pt-BR', {
                                style: 'currency',
                                currency: 'BRL',
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });
                            
                            const totalEmitidos = formatadorMoeda.format(infoCardsMonitoramentoPedidos.TOTAL_EMITIDO);
                            document.querySelector('.card-column:nth-child(1) .indicator-value').textContent = totalEmitidos;

                            const totalPagos = formatadorMoeda.format(infoCardsMonitoramentoPedidos.TOTAL_PAGO);
                            document.querySelector('.card-column:nth-child(2) .indicator-value').textContent = totalPagos;

                            const totalVencidos = formatadorMoeda.format(infoCardsMonitoramentoPedidos.TOTAL_VENCIDO);
                            document.querySelector('.card-column:nth-child(3) .indicator-value').textContent = totalVencidos;

                            const totalAVencer = formatadorMoeda.format(infoCardsMonitoramentoPedidos.TOTAL_A_VENCER);
                            document.querySelector('.card-column:nth-child(4) .indicator-value').textContent = totalAVencer;

                            const totalPermuta = formatadorMoeda.format(infoCardsMonitoramentoPedidos.TOTAL_PERMUTA);
                            document.querySelector('.card-column:nth-child(5) .indicator-value').textContent = totalPermuta;
                        // FIM CARDS

                        //INICIO GRAFICO 1
                            // Simulando response.data.infoGraficoPagamento (novo gráfico)
                            var dataSourcePagamento = [
                                { DATA_PAGAMENTO: "2025-01-05", VALOR_RECEBIDO: 1500.00 },
                                { DATA_PAGAMENTO: "2025-01-10", VALOR_RECEBIDO: 1800.50 },
                                { DATA_PAGAMENTO: "2025-01-15", VALOR_RECEBIDO: 900.75 },
                                { DATA_PAGAMENTO: "2025-01-20", VALOR_RECEBIDO: 2100.00 },
                                { DATA_PAGAMENTO: "2025-01-25", VALOR_RECEBIDO: 1750.30 },
                                { DATA_PAGAMENTO: "2025-01-30", VALOR_RECEBIDO: 1950.00 }
                            ];
                            // Converte strings para Date para garantir ordenação correta e uso no eixo
                            dataSourcePagamento.forEach(item => {
                                item.DATA_PAGAMENTO = new Date(item.DATA_PAGAMENTO);
                            });
                            // Ordena em ordem crescente pela data
                            dataSourcePagamento.sort((a,b) => a.DATA_PAGAMENTO - b.DATA_PAGAMENTO);
                            var moedaBRL = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
                            // Cria gráfico com base nas suas configurações
                            var graficoPagamento = $("#chart1").dxChart({
                                dataSource: dataSourcePagamento,
                                commonSeriesSettings: {
                                    argumentField: "DATA_PAGAMENTO",
                                    type: "bar",
                                    label: {
                                        visible: true,
                                        backgroundColor: "#fff",
                                        font: {
                                            color: "#1B5E20",  // cor verde PAGOS
                                            weight: 600
                                        },
                                        // Formata os valores das labels como moeda BRL
                                        customizeText: function(e) {
                                            return moedaBRL.format(e.value);
                                        }
                                    }
                                },
                                series: [{
                                    valueField: "VALOR_RECEBIDO",
                                    name: "Valor Recebido",
                                    color: "#1B5E20"  // cor verde PAGOS
                                }],
                                argumentAxis: {
                                    argumentType: "datetime",
                                    label: {
                                        format: "dd/MM",
                                        rotationAngle: -45,
                                        overlappingBehavior: "stagger"
                                    },
                                    grid: { visible: false }
                                },
                                valueAxis: {
                                    label: {
                                        format: {
                                            type: "currency",
                                            precision: 2,
                                            currency: "BRL"
                                        }
                                    },
                                    title: {
                                        text: "Valor Recebido (R$)"
                                    },
                                    grid: { visible: false }
                                },
                                legend: {
                                    visible: false
                                },
