<script>
    // Variáveis globais para armazenar os valores selecionados
    const formSelections = {
        codigoSafra: "163",
        dataInicio: null,
        dataFim: null
    };

    $(document).ready(function() {
        // BTN Exportar PDF - Versão corrigida
        document.getElementById('btnExportPDF').addEventListener('click', async function () {
            const loading = document.getElementById('globalLoading');
            const spinnerGen = document.getElementById('spinnerGeneric');
            const spinnerPDF = document.getElementById('spinnerPDF');
            const loadingText = document.getElementById('loadingText');

            loading.style.display = 'flex';
            spinnerGen.style.display = 'none';
            spinnerPDF.style.display = 'block';
            loadingText.textContent = 'Gerando PDF…';

            try {
                const printArea = document.getElementById('print-area');

                // Detecta o zoom do navegador para compensar a escala
                const zoom = window.devicePixelRatio || 1;
                const scale = 2 / zoom; // seu scale original 2 dividido pelo zoom atual

                const canvas = await html2canvas(printArea, {
                    scale: scale,
                    useCORS: true,
                    logging: true,
                    allowTaint: true,
                    backgroundColor: null,
                    onclone: (clonedDoc) => {
                        const cabecalho = clonedDoc.querySelector('.cabecalho-content');
                        if (cabecalho) {
                            cabecalho.classList.remove('hidden-print');
                            cabecalho.style.backgroundColor = '#006400';
                            cabecalho.style.color = 'white';
                            cabecalho.style.padding = '10px 20px';
                            cabecalho.style.textAlign = 'center';
                        }
                    }
                });

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4');
                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                const margemMm = 30 * 0.264583;

                const imgData = canvas.toDataURL('image/png', 1.0);
                const props = pdf.getImageProperties(imgData);

                const pdfWidth = pageWidth - 2 * margemMm;
                const maxPdfHeight = pageHeight - 2 * margemMm;

                // Ajusta a altura para caber na página, mantendo a proporção
                let pdfHeight = (props.height * pdfWidth) / props.width;
                if (pdfHeight > maxPdfHeight) {
                    pdfHeight = maxPdfHeight;
                }

                pdf.addImage(
                    imgData,
                    'PNG',
                    margemMm,
                    margemMm,
                    pdfWidth,
                    pdfHeight,
                    undefined,
                    'FAST'
                );

                pdf.save('dashboard-monitoramento-pedidos.pdf');
            } catch (err) {
                console.error('Erro ao gerar PDF:', err);
                alert('Erro ao gerar PDF. Verifique o console para detalhes.');
            } finally {
                spinnerPDF.style.display = 'none';
                spinnerGen.style.display = 'block';
                loadingText.textContent = 'Carregando Informações...';
                loading.style.display = 'none';
            }
        });

        // Inicializa o formulário e rangeSelector
        const formInstance = $("#form-container").dxForm({
            formData: {
                codigoSafra: "163"
            },
            colCount: 1,
            items: [
                {
                    itemType: "group",
                    colCount: 1,
                    items: [
                        {
                            dataField: "codigoSafra",
                            editorType: "dxSelectBox",
                            label: { visible: false },
                            editorOptions: getSelectBoxOptions("/credito-e-cobranca/get-lookup-safra", "dsc", "codigosafra", "Selecione a Safra")
                        }
                    ]
                },
            ],
            onFieldDataChanged: function(e) {
                // Atualiza a variável global quando um campo é alterado
                formSelections[e.dataField] = e.value;
                
            }
        }).dxForm("instance");

        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: "raw",
                    load: function() {
                        return $.ajax({
                            url: url,
                            method: "GET",
                            dataType: "json"
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, "error", 3000);
                                return [];
                            }
                        }).catch(error => {
                            DevExpress.ui.notify("Erro ao buscar dados!", "error", 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true,
                onValueChanged: function(e) {
                    atualizarInfosDashboad();
                }
            };
        }

        // Inicializa o Range Selector
        const today = moment();
        const startYear = 2023; // definido para pegar historico de 2023 pra k.
        const startOfMonth = today.clone().startOf('month');  // Primeiro dia do mês atual
        const endOfMonth = today.clone().endOf('month');     // Último dia do mês atual

        // Define valores iniciais nas variáveis globais
        formSelections.dataInicio = moment(startOfMonth.toDate()).format("YYYY-MM-DD"); 
        formSelections.dataFim = moment(endOfMonth.toDate()).format("YYYY-MM-DD");

        const rangeSelectorInstance = $("#range-selector").dxRangeSelector({
            width: '100%',
            scale: {
                startValue: moment(`${startYear}-01-01`).toDate(),
                endValue: today.clone().endOf('year').toDate(),
                minorTickInterval: "month",
                tickInterval: "month",
                useTicks: true,
                label: { format: "MMM yyyy" }
            },
            value: [startOfMonth.toDate(), endOfMonth.toDate()],  // Intervalo: primeiro dia do mês até o último dia
            sliderMarker: { format: "monthAndYear" },
            behavior: { callValueChanged: "onMovingComplete" }, // Alterado para "onMovingComplete"
            applyValueMode: "onHandleRelease",
            onInitialized: function(e) {
                atualizarInfosDashboad();
            },
            onValueChanged: function(e) {
                const startDate = moment(e.value[0]);
                const endDate = moment(e.value[1]).subtract(1, 'days'); // quando faz o changed sempre pega dia 01 do proximo mes ao selecionado. Tratei pra subtrair um dia, pegando o ultimo dia do mes selecionado.

                formSelections.dataInicio = moment(startDate.toDate()).format("YYYY-MM-DD");
                formSelections.dataFim = moment(endDate.toDate()).format("YYYY-MM-DD");
                
                atualizarInfosDashboad();
            }
        }).dxRangeSelector("instance");

    });

    // Função para atualizar informações do dashboard
    function atualizarInfosDashboad() {
        // Mostra o loading
        $('#globalLoading').show();

        const dataInicio = moment(formSelections.dataInicio, 'YYYY-MM-DD');
        const dataFim = moment(formSelections.dataFim, 'YYYY-MM-DD');
        const codigoSafra = formSelections.codigoSafra;

        let textoPeriodo = '';

        if (dataInicio.isSame(dataFim, 'month')) {
            textoPeriodo = dataInicio.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase());
        } else {
            textoPeriodo = `${dataInicio.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase())} à ${dataFim.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase())}`;
        }

        $('#periodo-apuracao').text(textoPeriodo);
        $('#safra-apuracao').text(codigoSafra);

        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/credito-e-cobranca/listar-dados-monitoramento-pedidos-safra',
                method: 'GET',
                dataType: 'json',
                data: formSelections,
                success: function(response) {
                    if (response.success) {
                        // INICIO CARDS
                            // Acessar os dados do objeto
                            const infoCardsMonitoramentoPedidos = response.data.infoCardsMonitoramentoPedidos;

                            const formatadorMoeda = new Intl.NumberFormat('pt-BR', {
                                style: 'currency',
                                currency: 'BRL',
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });

                            const totalEmitidos = formatadorMoeda.format(infoCardsMonitoramentoPedidos.TOTAL_EMITIDO ?? 0);
                            document.querySelector('.card-column:nth-child(1) .indicator-value').textContent = totalEmitidos;

                            const totalPagos = formatadorMoeda.format(infoCardsMonitoramentoPedidos.TOTAL_PAGO ?? 0);
                            document.querySelector('.card-column:nth-child(2) .indicator-value').textContent = totalPagos;

                            const totalVencidos = formatadorMoeda.format(infoCardsMonitoramentoPedidos.TOTAL_VENCIDO ?? 0);
                            document.querySelector('.card-column:nth-child(3) .indicator-value').textContent = totalVencidos;

                            const totalAVencer = formatadorMoeda.format(infoCardsMonitoramentoPedidos.TOTAL_A_VENCER ?? 0);
                            document.querySelector('.card-column:nth-child(4) .indicator-value').textContent = totalAVencer;

                            const totalPermuta = formatadorMoeda.format(infoCardsMonitoramentoPedidos.TOTAL_PERMUTA ?? 0);
                            document.querySelector('.card-column:nth-child(5) .indicator-value').textContent = totalPermuta;

                            const totalSafra = formatadorMoeda.format(infoCardsMonitoramentoPedidos.TOTAL_SAFRA ?? 0);
                            document.querySelector('.card-column:nth-child(6) .indicator-value').textContent = totalSafra;
                        // FIM CARDS

                        // INICIO GRIDS E DETALHES
                            // Acessar os dados do objeto
                            const infoGermoplasmaTipoPrazo = response.data.infoGermoplasmaTipoPrazo;
                            const infoRoyaltiesTipoPrazo = response.data.infoRoyaltiesTipoPrazo;
                            const infoTSITipoPrazo = response.data.infoTSITipoPrazo;
                            const infoFreteTipoPrazo = response.data.infoFreteTipoPrazo;

                            // Germoplasma
                            const germoAno = formatadorMoeda.format(infoGermoplasmaTipoPrazo.PRAZO_ANO_GERMOPLASMA ?? 0);
                            document.getElementById('germoAno').textContent = germoAno;

                            const germoSafra = formatadorMoeda.format(infoGermoplasmaTipoPrazo.PRAZO_SAFRA_GERMOPLASMA ?? 0);
                            document.getElementById('germoSafra').textContent = germoSafra;

                            const totalGermoplasma = (infoGermoplasmaTipoPrazo.PRAZO_ANO_GERMOPLASMA + infoGermoplasmaTipoPrazo.PRAZO_SAFRA_GERMOPLASMA) ?? 0;
                            document.getElementById('germoTotal').textContent = formatadorMoeda.format(totalGermoplasma);

                            // Royalties
                            const royAno = formatadorMoeda.format(infoRoyaltiesTipoPrazo.PRAZO_ANO_ROYALTIES  ?? 0);
                            document.getElementById('royAno').textContent = royAno;

                            const roySafra = formatadorMoeda.format(infoRoyaltiesTipoPrazo.PRAZO_SAFRA_ROYALTIES  ?? 0);
                            document.getElementById('roySafra').textContent = roySafra;

                            const totalRoyalties = (infoRoyaltiesTipoPrazo.PRAZO_ANO_ROYALTIES + infoRoyaltiesTipoPrazo.PRAZO_SAFRA_ROYALTIES) ?? 0;
                            document.getElementById('royTotal').textContent = formatadorMoeda.format(totalRoyalties);

                            // TSI
                            const tsiAno = formatadorMoeda.format(infoTSITipoPrazo.PRAZO_ANO_TSI ?? 0);
                            document.getElementById('tsiAno').textContent = tsiAno;

                            const tsiSafra = formatadorMoeda.format(infoTSITipoPrazo.PRAZO_SAFRA_TSI ?? 0);
                            document.getElementById('tsiSafra').textContent = tsiSafra;

                            const totalTSI = (infoTSITipoPrazo.PRAZO_ANO_TSI + infoTSITipoPrazo.PRAZO_SAFRA_TSI) ?? 0;
                            document.getElementById('tsiTotal').textContent = formatadorMoeda.format(totalTSI);

                            // Frete
                            const freteAno = formatadorMoeda.format(infoFreteTipoPrazo.PRAZO_ANO_FRETE ?? 0);
                            document.getElementById('freteAno').textContent = freteAno;

                            const freteSafra = formatadorMoeda.format(infoFreteTipoPrazo.PRAZO_SAFRA_FRETE ?? 0);
                            document.getElementById('freteSafra').textContent = freteSafra;

                            const totalFrete = (infoFreteTipoPrazo.PRAZO_ANO_FRETE + infoFreteTipoPrazo.PRAZO_SAFRA_FRETE) ?? 0;
                            document.getElementById('freteTotal').textContent = formatadorMoeda.format(totalFrete);
                        // FIM GRIDS E DETALHES

                        // INICIO GRAFICO 1
                            var dataSourcePagamento = response.data.infoRecebimentoDataPagamento || [];
                            var moedaBRL = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

                            var graficoPagamento = $("#chart1").dxChart({
                                dataSource: dataSourcePagamento,
                                rotated: false, 
                                commonSeriesSettings: {
                                    argumentField: "DATA_PAGAMENTO",
                                    type: "bar",
                                    barPadding: 0.2, // menor espaço entre barras
                                    barWidth: 50,    // barras mais finas
                                    label: {
                                        visible: true,
                                        backgroundColor: "#fff",
                                        font: {
                                            color: "#1B5E20",
                                            weight: 600
                                        },
                                        customizeText: function(e) {
                                            return moedaBRL.format(e.value);
                                        }
                                    }
                                },
                                series: [{
                                    valueField: "VALOR_RECEBIDO",
                                    name: "Valor Recebido",
                                    color: "#1B5E20"
                                }],
                                argumentAxis: {
                                    label: {
                                        rotationAngle: -45,
                                        overlappingBehavior: "stagger",
                                        customizeText: function (e) {
                                            const date = new Date(e.value);
                                            const day = String(date.getDate()).padStart(2, '0');
                                            const month = String(date.getMonth() + 1).padStart(2, '0');
                                            const year = date.getFullYear();
                                            return `${day}/${month}/${year}`;
                                        }
                                    },
                                    grid: { visible: false }
                                },
                                valueAxis: {
                                    label: {
                                        format: {
                                            type: "currency",
                                            precision: 2,
                                            currency: "BRL"
                                        }
                                    },
                                    title: {
                                        text: "Valor Recebido (R$)"
                                    },
                                    grid: { visible: false }
                                },
                                legend: {
                                    visible: false
                                },
                                tooltip: {
                                    enabled: true,
                                    format: {
                                        type: "currency",
                                        precision: 2,
                                        currency: "BRL"
                                    }
                                },
                                title: {
                                    text: 'Pagamentos por Data',
                                    font: {
                                        size: 20
                                    }
                                },
                                size: {
                                    height: 350 
                                }
                            }).dxChart("instance");
                        // FIM GRAFICO 1

                        // Inicio Ranking Clientes e Vendedores
                            var top10Clientes =  response.data.infoTopClientes || [];
                            var rankingVendas = response.data.infoTopVendedores || [];
                            var moedaBRL = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

                            $("#gridClientes").dxDataGrid({
                                dataSource: top10Clientes,
                                showBorders: true,
                                sorting: { mode: "multiple" },
                                columnAutoWidth: true,
                                paging: { enabled: false },
                                headerFilter: { visible: true },
                                columns: [
                                    {
                                        caption: "TOP 10 Pagamentos Mês - Clientes",
                                        alignment: "center",
                                        columns: [
                                            { dataField: "NOME_CLIENTE", caption: "Cliente" },
                                            {
                                                dataField: "VALOR",
                                                caption: "Valor (R$)",
                                                dataType: "number",
                                                format: {
                                                    style: "currency",
                                                    currency: "BRL",
                                                    precision: 2
                                                }
                                            }
                                        ]
                                    }
                                ],
                                onCellPrepared: function(e) {
                                    if (e.rowType === "header") {
                                        e.cellElement.css({
                                            "background-color": "#1B5E20",
                                            "color": "white",
                                            "font-weight": "bold"
                                        });
                                    }
                                }
                            });

                            $("#gridVendedores").dxDataGrid({
                                dataSource: rankingVendas,
                                showBorders: true,
                                sorting: { mode: "multiple" },
                                columnAutoWidth: true,
                                paging: { enabled: false },
                                headerFilter: { visible: true },
                                columns: [
                                    {
                                        caption: "TOP 10 Pagamentos Mês - Vendedores",
                                        alignment: "center",
                                        columns: [
                                            { dataField: "NOME_VENDEDOR", caption: "Vendedor" },
                                            {
                                                dataField: "VALOR",
                                                caption: "Valor (R$)",
                                                dataType: "number",
                                                format: {
                                                    style: "currency",
                                                    currency: "BRL",
                                                    precision: 2
                                                }
                                            }
                                        ]
                                    }
                                ],
                                onCellPrepared: function(e) {
                                    if (e.rowType === "header") {
                                        e.cellElement.css({
                                            "background-color": "#1B5E20",
                                            "color": "white",
                                            "font-weight": "bold"
                                        });
                                    }
                                }
                            });
                        // Fim Ranking Clientes e Vendedores   

                        // Inicio Grafico Receber e A Receber
                            var rawData = response.data.infoReceberRecebido || {};
                            var dataDonut = [
                                { status: "A Receber", valor: rawData.VALOR_A_RECEBER || 0 },
                                { status: "Recebido", valor: rawData.VALOR_RECEBIDO || 0 }
                            ];
                            var moedaBRL = new Intl.NumberFormat('pt-BR', {
                                style: 'currency',
                                currency: 'BRL'
                            });

                            $("#chart2").dxPieChart({
                                type: "doughnut",
                                palette: ["#FFA000", "#1B5E20"],
                                dataSource: dataDonut,
                                size: {
                                    height: 400
                                },
                                title: {
                                    text: 'Parcelas à Receber e Recebidas Mês',
                                    font: {
                                        size: 20
                                    }
                                },
                                legend: {
                                    visible: true,
                                    horizontalAlignment: "center",
                                    verticalAlignment: "bottom",
                                    itemTextPosition: "right"
                                },
                                tooltip: {
                                    enabled: true,
                                    customizeTooltip: function (arg) {
                                        return {
                                            text: `${moedaBRL.format(arg.value)}`
                                        };
                                    }
                                },
                                series: [{
                                    argumentField: "status",
                                    valueField: "valor",
                                    label: {
                                        visible: true,
                                        format: "fixedPoint",
                                        precision: 2,
                                        connector: {
                                            visible: true
                                        },
                                        customizeText: function (arg) {
                                            const valorFormatado = moedaBRL.format(arg.value);
                                            const percentual = (arg.percent * 100).toFixed(1).replace('.', ',') + '%';
                                            return `${valorFormatado} (${percentual})`;
                                        }
                                    }
                                }],
                                centerTemplate: function(pieChart, container) {
                                    // Soma total dos valores visíveis (a receber + recebido)
                                    const total = pieChart.getAllSeries()[0]
                                        .getVisiblePoints()
                                        .reduce((sum, point) => sum + point.originalValue, 0);
                                    
                                    // Cria um texto SVG centralizado com o valor total formatado
                                    const svgNamespace = "http://www.w3.org/2000/svg";

                                    // Círculo de fundo branco para "limpar" o centro
                                    const circle = document.createElementNS(svgNamespace, "circle");
                                    circle.setAttribute("cx", 100);
                                    circle.setAttribute("cy", 100);
                                    circle.setAttribute("r", pieChart.getInnerRadius() - 6);
                                    circle.setAttribute("fill", "#fff");
                                    container.appendChild(circle);

                                    // Texto do valor total, centralizado
                                    const text = document.createElementNS(svgNamespace, "text");
                                    text.setAttribute("x", 100);
                                    text.setAttribute("y", 110);
                                    text.setAttribute("fill", "#333");
                                    text.setAttribute("font-size", "12");
                                    text.setAttribute("font-weight", "bold");
                                    text.setAttribute("text-anchor", "middle");
                                    text.textContent = moedaBRL.format(total);
                                    container.appendChild(text);
                                }
                            });
                        // Fim Grafico Receber e A Receber
                    }
                },
                error: function(error) {
                    DevExpress.ui.notify("Erro na requisição", "error", 3000);
                },
                complete: function() {
                    // Esconde o loading quando tudo estiver pronto
                    $('#globalLoading').hide();
                }
            });
        });
    }


    function obterDadosPedidos(tipo) {
        $('#globalLoading').show();

        formSelections.tipo = tipo;

        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/credito-e-cobranca/detalhes-cards-monitoramento-pedidos-safra',
                method: 'GET',
                dataType: 'json',
                data: formSelections,
                success: function(response) {
                    if (response.success) {
                        const result = response.data;

                        // Resolve a Promise com os dados filtrados
                        resolve(result || []);
                    } else {
                        reject(new Error("Resposta da API não foi bem-sucedida"));
                    }
                },
                error: function(error) {
                    DevExpress.ui.notify("Erro na requisição dos Detalhes", "error", 3000);
                    reject(error);
                },
                complete: function() {
                    // Esconde o loading quando tudo estiver pronto
                    $('#globalLoading').hide();
                }
            });
        });
    }
    async function abrirPopup(tipo) {
        try {
            const result = await obterDadosPedidos(tipo);
            
            $("#popup-container").dxPopup({
                width: '80%',
                height: 800,
                showTitle: true,
                title: `Detalhes - ${tipo}`,
                visible: true,
                dragEnabled: true,
                closeOnOutsideClick: true,
                contentTemplate: function () {
                    return $("<div>").dxDataGrid({
                        dataSource: result.dataSource,
                        height: '100%',
                        width: '100%',
                        columnAutoWidth: true,
                        elementAttr: {
                            class: "grid-personalizada"
                        },
                        showBorders: true,
                        columnChooser: {
                            enabled: true,
                            mode: "dragAndDrop",
                            position: { 
                                my: "right", 
                                at: "right", 
                                of: ".dx-datagrid-column-chooser-button" 
                            }
                        },
                        groupPanel: {
                            visible: true,
                        },
                        editing: {
                            mode: 'batch',
                            allowUpdating: false,
                            allowDeleting: false,
                        },
                        selection: {
                            mode: 'multiple',
                            showCheckBoxesMode: 'none'
                        },
                        hoverStateEnabled: true,
                        pager: {
                            visible: true
                        },
                        paging: {
                            pageSize: 500
                        },
                        headerFilter: {
                            visible: true,
                        },
                        filterRow: {
                            visible: true,
                            applyFilter: 'auto',
                        },
                        export: {
                            enabled: true,
                            fileName: "Detalhes " + tipo,
                            allowExportSelectedData: false,
                        },
                        searchPanel: {
                            visible: true,
                            width: 240,
                            placeholder: 'Procure...',
                        },
                        columns: result.collumns,
                        onToolbarPreparing: function (e) {
                            var toolbarItems = e.toolbarOptions.items;
                            
                            toolbarItems.push({
                                location: "after",
                                widget: "dxButton",
                                options: {
                                    icon: "fa fa-expand",
                                    text: "Expandir",
                                    onClick: function () {
                                        var grid = e.component;
                                        grid.expandAll();
                                    }
                                }
                            });

                            toolbarItems.push({
                                location: "after",
                                widget: "dxButton",
                                options: {
                                    icon: "fa fa-compress",
                                    text: "Colapsar",
                                    onClick: function () {
                                        var grid = e.component;
                                        grid.collapseAll();
                                    }
                                }
                            });
                        }
                    });
                }
            });
        } catch (error) {
            console.error('Erro ao obter dados de detalhe ' + tipo + ':', error);
        }
    }
</script>