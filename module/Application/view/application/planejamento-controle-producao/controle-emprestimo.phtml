<style>
    #print-area {
        background: white;
        width: 100%;
        max-width: 100%; /* Alterado para ocupar toda a largura disponível */
        margin: 0 auto; /* Centralizado */
        padding: 15px; /* Reduzido para economizar espaço */
        border: 1px solid #ccc;
        box-sizing: border-box;
        font-size: 0.9em; /* Tamanho de fonte base reduzido */
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #0f172a;
        padding-bottom: 8px; /* Reduzido */
        margin-bottom: 15px; /* Reduzido */
        flex-wrap: wrap;
    }

    .header h1 {
        font-size: 1.25em; /* Usando em para escalabilidade */
        margin: 0;
        color: #0f172a;
        font-weight: 600; /* Mais semântico que bold */
    }

    .header .numero-os {
        font-size: 18px;
        color: #ef4444;
        font-weight: 500;
    }

    .section {
        margin-bottom: 15px; /* Reduzido */
    }

    .section-title {
        font-weight: 600;
        background: #0f172a;
        color: white;
        padding: 5px 8px; /* Reduzido */
        font-size: 0.95em; /* Reduzido */
        border-radius: 3px; /* Adicionado para suavizar */
        margin-bottom: 8px; /* Adicionado espaçamento */
    }

    .field-group {
        display: flex;
        flex-wrap: wrap;
        gap: 8px; /* Reduzido para economizar espaço */
    }

    .field {
        flex: 1 1 calc(50% - 8px); /* Ajustado para o novo gap */
        padding: 6px; /* Reduzido */
        border: 1px solid #e2e8f0; /* Cor mais suave */
        border-radius: 4px;
        box-sizing: border-box;
        background-color: #f8fafc; /* Fundo sutil para melhor legibilidade */
    }
    .field.third {
        flex: 1 1 calc(33.333% - 8px); /* para 3 colunas com gap de 8px */
    }

    .field.full {
        flex: 1 1 100%;
    }

    .label {
        font-weight: 500; /* Mais suave que bold */
        display: block;
        margin-bottom: 2px; /* Reduzido */
        font-size: 0.85em;
        color: #475569; /* Cor mais suave */
    }

    .value {
        font-size: 0.9em;
        min-height: 1.2em; /* Baseado em em para escalabilidade */
        word-break: break-word;
        color: #1e293b; /* Cor mais escura para melhor contraste */
        padding: 2px 0; /* Pequeno espaçamento interno */
        white-space: pre-wrap; /* mantém quebras de linha do texto */
        word-wrap: break-word; /* reforço para não estourar o layout */
    }

    .signature {
        margin-top: 30px; /* Reduzido */
        border-top: 1px dashed #cbd5e1; /* Cor mais suave */
        text-align: center;
        padding-top: 8px;
        font-size: 0.9em;
        color: #64748b; /* Cor mais suave */
    }

    /* #ordemServicoContent {
        max-height: 90vh;
        overflow-y: auto;
        overflow-x: hidden;
    } */

    /* Adicionando responsividade para telas menores */
    @media (max-width: 600px) {
        .field {
            flex: 1 1 100%; /* Em telas pequenas, campos ocupam linha inteira */
        }
        
        .header {
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }
        
        .header .numero-os {
            align-self: flex-end;
        }
    }


    @media print {
        body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        #print-area {
            page-break-inside: avoid;
        }

        /* Evita quebra dentro das seções */
        .section, .signature {
            page-break-inside: avoid;
            page-break-before: auto;
            page-break-after: auto;
        }

        /* Força a assinatura a ir para a próxima página se não couber */
        .signature {
            page-break-before: always;
        }
    }


    /* teste template equipamentos selectBox */
    .equipamento-template {
        padding: 8px;
        line-height: 1.4;
    }

    .equipamento-header {
        font-size: 14px;
        margin-bottom: 5px;
        border-bottom: 1px solid #eee;
        padding-bottom: 3px;
    }

    .equipamento-details {
        font-size: 12px;
        color: #020202ff;
    }

    .equipamento-details div {
        margin-bottom: 2px;
    }
</style>

<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Planejamento e Controle da Produção</h1>
    </div>

    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Empréstimo</p>

                    <div id="gridControleEmprestimo"></div>
                    <div id="popupOS"></div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        var produtosLookup = []; 
        // getLookupProdutos();

        let controleEmprestimoGrid = $('#gridControleEmprestimo').dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: 'id',
                load: function () {
                    return $.ajax({
                        url: '/planejamento-controle-producao/listar-controles-emprestimo',
                        method: 'GET',
                        dataType: 'json'
                    }).then(response => {
                        if (response.success) {
                            return {
                                data: response.data,
                                totalCount: response.totalCount || response.data.length
                            };
                        } else {
                            DevExpress.ui.notify(response.message, 'error', 5000);
                            return { data: [], totalCount: 0 };
                        }
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao carregar controles!', 'error', 5000);
                        return { data: [], totalCount: 0 };
                    });
                },
                insert: function (values) {
                    return $.ajax({
                        url: '/planejamento-controle-producao/salvar-controle-emprestimo',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(values),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 5000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Controle salvo com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao salvar controle!', 'error', 5000);
                        return {};
                    });
                },
                update: function (key, values) {
                    return $.ajax({
                        url: '/planejamento-controle-producao/salvar-controle-emprestimo',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key, ...values }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 5000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Controle atualizado com sucesso!', 'success', 5000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao atualizar controle!', 'error', 5000);
                        return {};
                    });
                },
                remove: function (key) {
                    return $.ajax({
                        url: '/planejamento-controle-producao/excluir-controle-emprestimo',
                        method: 'DELETE',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 5000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Controle excluído com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao excluir controle!', 'error', 3000);
                        return {};
                    });
                }
            }),
            keyExpr: 'id',
            columnAutoWidth: true,
            width: '100%',
            height: 'auto',
            showBorders: true,
            columnChooser: {
                enabled: true,
                mode: "dragAndDrop", // or "select"
                position: { 
                    my: "right", 
                    at: "right", 
                    of: ".dx-datagrid-column-chooser-button" 
                }
            },
            groupPanel: {
                visible: true,
            },
            toolbar: {
                items: [
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-expand", // ícone para expandir
                            text: "",
                            onClick: function () {
                                var grid = $("#gridControleEmprestimo").dxDataGrid("instance");
                                grid.expandAll(); // Expande todos os grupos
                            }
                        }
                    },
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-compress", // ícone para colapsar
                            text: "",
                            onClick: function () {
                                var grid = $("#gridControleEmprestimo").dxDataGrid("instance");
                                grid.collapseAll(); // Colapsa todos os grupos
                            }
                        }
                    },
                    {
                        name: "refresh", // Define o nome do botão
                        location: "after", // Coloca o botão após os outros itens na toolbar
                        widget: "dxButton",
                        options: {
                            icon: "refresh", // Ícone de refresh
                            onClick: function() {
                                // Lógica para atualizar/recarregar os dados da grid
                                $("#gridControleEmprestimo").dxDataGrid("instance").refresh(); // Atualiza a grid
                            },
                            text: "Atualizar" // Texto exibido no botão
                        }
                    }
                ]
            },
            paging: {
                pageSize: 500,
            },
            pager: {
                visible: true,
                allowedPageSizes: [5, 10, 100, 200, 500],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
            headerFilter: {
                visible: true,
            },
            filterRow: {
                visible: true,
                applyFilter: 'auto',
            },
            export: {
                enabled: true,
                fileName: "Controle Empréstimos",
                allowExportSelectedData: false,
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: 'Procure...',
            },
            hoverStateEnabled: true,
            editing: {
                mode: 'popup',
                allowUpdating: true,
                allowAdding: true,
                allowDeleting: true,
                useIcons: true,
                popup: {
                    title: "Empréstimo",
                    showTitle: true,
                    width: '800px',
                    resizeEnabled: true,
                    autoResizeEnabled: true,
                    height: 'auto', 
                    // maxHeight: '95vh'
                },
                form: {
                    colCount: 2,
                    labelLocation: 'top',
