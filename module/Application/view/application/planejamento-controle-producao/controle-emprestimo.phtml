                            editorType: 'dxSelectBox', 
                            colSpan: 2, 
                            editorOptions: getSelectBoxOptions('/planejamento-controle-producao/get-lookup-funcionarios', 'nome', 'id', 'Selecione o funcionário') ,
                            validationRules: [{ type: 'required' }]
                        },
                        { 
                            dataField: 'equipamento_id', 
                            label: { text: 'Equipamento' }, 
                            editorType: 'dxSelectBox', 
                            colSpan: 2, 
                            editorOptions: {
                                dataSource: new DevExpress.data.DataSource({
                                    store: new DevExpress.data.CustomStore({
                                        key: 'id',
                                        load: function(loadOptions) {
                                            const searchValue = (loadOptions.searchValue || '').toUpperCase();
                                            const skip = loadOptions.skip || 0;
                                            const take = loadOptions.take || 30;
                                            
                                            return $.ajax({
                                                url: '/planejamento-controle-producao/get-lookup-equipamentos',
                                                dataType: 'json',
                                                data: { 
                                                    search: searchValue,
                                                    offset: skip,
                                                    limit: take
                                                }
                                            }).then(result => {
                                                const data = result.data || result;
                                                return {
                                                    data: data,
                                                    totalCount: result.totalCount || 1000
                                                };
                                            }).catch(() => {
                                                return { data: [], totalCount: 0 };
                                            });
                                        },
                                        byKey: function(key) {
                                            return $.ajax({
                                                url: '/planejamento-controle-producao/get-lookup-equipamentos',
                                                dataType: 'json',
                                                data: { key: key }
                                            }).then(result => {
                                                const item = result.data || result;
                                               
                                                return item;
                                            });
                                        }
                                    }),
                                    paginate: true,
                                    pageSize: 30
                                }),
                                valueExpr: 'id',
                                searchEnabled: true,
                                searchExpr: ['codigo', 'nome'],
                                searchTimeout: 500,
                                minSearchLength: 0,
                                // ✅ Recarregar ao abrir
                                onOpened: function(e) {
                                    e.component.getDataSource().reload();
                                },
                                itemTemplate: function(data) {
                                    const indisponivel = data.quantidade_disponivel === 0 ? " (Indisponível)" : "";
                                    return `
                                        <div class="equipamento-template">
                                            <div class="equipamento-header">
                                                <strong>${data.codigo || 'Sem código'}</strong> - ${data.nome || 'Sem nome'} <span style="color:darkred; font-weight:bold;">${indisponivel}</span>
                                            </div>
                                            <div class="equipamento-details">
                                                <div><small><strong>Qtd. Total:</strong> ${data.quantidade}</small></div>
                                                <div><small><strong>Qtd. Disponível:</strong> ${data.quantidade_disponivel}</small></div>
                                                <div><small><strong>Observação:</strong> ${data.observacoes || 'Nenhuma'}</small></div>
                                            </div>
                                        </div>
                                    `;
                                },
                                displayExpr: function(item) {
                                    return item ? `${item.codigo} - ${item.nome}` : '';
                                },
                                placeholder: 'Digite para buscar...',
                                showClearButton: true,
                                showDataBeforeSearch: true
                            } 
                        },
                        {
                            dataField: 'quantidade_emprestimo',
                            editorType: 'dxNumberBox',
                            editorOptions: { format: { type: 'fixedPoint', precision: 4 } },
                            validationRules: [
                                { type: 'required' },
                            ]
                        },
                        { 
                            dataField: 'data_devolucao', 
                            label: { text: 'Data Devolução' }, 
                            editorType: 'dxDateBox', 
                            editorOptions: { 
                                type: 'date', 
                                min: new Date()
                            }, 
                            colSpan: 2 
                        },
                        { dataField: 'observacoes', label: { text: 'Observações Adicionais' }, editorType: 'dxTextArea', colSpan: 2, editorOptions: { height: 60 } },
                    ]
                }
            },
            columns: [
                { 
                    dataField: 'id', 
                    caption: 'ID', 
                    alignment: 'center', 
                    width: 110,
                    calculateDisplayValue: function(rowData) {
                        return String(rowData.id).padStart(5, '0');
                    }
                },
                { dataField: 'data_emprestimo', caption: 'Dt. Emprestimo', dataType: 'date', alignment: 'center', width: 150 },
                { dataField: 'matricula', caption: 'Matricula', visible: true, alignment: 'center' },
                { dataField: 'funcionario_id', caption: 'Funcionário', visible: true, lookup: { dataSource: new DevExpress.data.CustomStore({ load: () => $.getJSON('/planejamento-controle-producao/listar-funcionarios') }), displayExpr: 'nome', valueExpr: 'id' } },
                { dataField: 'dsc_departamento', caption: 'Departamento', visible: true },
                { 
                    dataField: 'equipamento_id', 
                    caption: 'Equipamento', 
                    lookup: { 
                        dataSource: new DevExpress.data.CustomStore({ load: () => $.getJSON('/planejamento-controle-producao/listar-equipamentos') }), 
                        displayExpr: 'dsc_equipamento', 
                        valueExpr: 'id' 
                    },
                    setCellValue: function(newData, value, currentRowData) {
                        newData.equipamento_id = value;

                        // Pega o item selecionado no lookup (que já tem centro_custo_id)
                        const selectedItem = this.lookup.items.find(item => item.id === value);
                    }
                },
                {
                    dataField: 'quantidade_emprestimo',
                    caption: 'Qtd. Empréstimo',
                    allowEditing: true,
                    alignment: 'right',
                    width: 150,
                    dataType: 'number',
                    format: { type: 'fixedPoint', precision: 4 },
                    validationRules: [{ type: 'required' }]
                },
                { dataField: 'data_devolucao', caption: 'Dt. Devolução', dataType: 'date', alignment: 'center', width: 150 },
                { dataField: 'observacoes', caption: 'Observações Adicionais', visible: false },
                {
                    type: 'buttons',
                    width: 120,
                    alignment: 'center',
                    buttons: [
                        {
                            name: 'edit',
                        },
                        {
                            name: 'delete',
                        },
                    ]
                },
            ],
            columns: [
                { 
                    dataField: 'id', 
                    caption: 'ID', 
                    alignment: 'center', 
                    width: 110,
                    calculateDisplayValue: function(rowData) {
                        return String(rowData.id).padStart(5, '0');
                    }
                },
                { dataField: 'data_emprestimo', caption: 'Dt. Emprestimo', dataType: 'date', alignment: 'center', width: 150 },
                { dataField: 'matricula', caption: 'Matricula', visible: true, alignment: 'center' },
                { dataField: 'funcionario_id', caption: 'Funcionário', visible: true, lookup: { dataSource: new DevExpress.data.CustomStore({ load: () => $.getJSON('/planejamento-controle-producao/listar-funcionarios') }), displayExpr: 'nome', valueExpr: 'id' } },
                { dataField: 'dsc_departamento', caption: 'Departamento', visible: true },
                { 
                    dataField: 'equipamento_id', 
                    caption: 'Equipamento', 
                    lookup: { 
                        dataSource: new DevExpress.data.CustomStore({ load: () => $.getJSON('/planejamento-controle-producao/listar-equipamentos') }), 
                        displayExpr: 'dsc_equipamento', 
                        valueExpr: 'id' 
                    },
                    setCellValue: function(newData, value, currentRowData) {
                        newData.equipamento_id = value;

                        // Pega o item selecionado no lookup (que já tem centro_custo_id)
                        const selectedItem = this.lookup.items.find(item => item.id === value);
                    }
                },
                {
                    dataField: 'quantidade_emprestimo',
                    caption: 'Qtd. Empréstimo',
                    allowEditing: true,
                    alignment: 'right',
                    width: 150,
                    dataType: 'number',
                    format: { type: 'fixedPoint', precision: 4 },
                    validationRules: [{ type: 'required' }]
                },
                { dataField: 'data_devolucao', caption: 'Dt. Devolução', dataType: 'date', alignment: 'center', width: 150 },
                { dataField: 'observacoes', caption: 'Observações Adicionais', visible: false },
                {
                    type: 'buttons',
                    width: 120,
                    alignment: 'center',
                    buttons: [
                        {
                            name: 'edit',
                        },
                        {
                            name: 'delete',
                        },
                    ]
                },
            ],
            onInitNewRow: function(e) {
                e.data.data_emprestimo = new Date();
                
                setTimeout(() => {
                    const form = $(".dx-popup-content .dx-form").dxForm("instance");
                    if (form) {
                        form.updateData('data_emprestimo', new Date());
                    }
                }, 100);
            },
            onRowUpdating: function (e) {
                e.newData = { ...e.oldData, ...e.newData };
            },
            onToolbarPreparing: function (e) {
                // Aqui você pode personalizar ainda mais a barra de ferramentas
                var toolbarItems = e.toolbarOptions.items;

                // Adicionar os botões de expandir/colapsar
                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-expand",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.expandAll(); // Expande todos os grupos
                        }
                    }
                });

                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-compress",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.collapseAll(); // Colapsa todos os grupos
                        }
                    }
                });

                e.toolbarOptions.items.push({
                    name: "refresh", // Adiciona o botão refresh na toolbar
                    location: "after", // Coloca depois dos outros itens
                    widget: "dxButton",
                    options: {
                        icon: "refresh", // Ícone do botão (ícone de atualização)
                        onClick: function() {
                            // Recarrega os dados da grid
                            e.component.refresh(); // Atualiza a grid
                        },
                        text: "Atualizar" 
                    }
                });
            },             
        });


        const normalizarDatas = (data) => {
            if (!data) return null;
            return DevExpress.localization.formatDate(new Date(data), 'yyyy-MM-dd HH:mm:ss');
        };

        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: 'raw',
                    load: function () {
                        return $.ajax({
                            url: url,
                            method: 'GET',
                            dataType: 'json'
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, 'error', 3000);
                                return [];
                            }
                        }).catch(() => {
                            DevExpress.ui.notify('Erro ao buscar dados!', 'error', 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true
            };
        }
    });
</script>
