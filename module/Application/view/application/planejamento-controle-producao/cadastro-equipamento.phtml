
<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Planejamento e Controle da Produção</h1>
    </div>

    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Cadastro Equipamentos</p>

                    <div id="gridEquipamentos"></div>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- /.container-fluid -->

<script>
    $(document).ready(function() {
        let isNovoRegistro = false;
        let equipamentosGrid = $('#gridEquipamentos').dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: 'id',
                load: function(loadOptions) {
                    return $.ajax({
                        url: '/planejamento-controle-producao/listar-equipamentos',
                        method: 'GET',
                        dataType: 'json'
                    }).then(response => {
                        if (response.success) {
                            return {
                                data: response.data,
                                totalCount: response.totalCount || response.data.length
                            };
                        } else {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                            return { data: [], totalCount: 0 };
                        }
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao carregar equipamentos!', 'error', 3000);
                        return { data: [], totalCount: 0 };
                    });
                },
                insert: function(values) {
                    return $.ajax({
                        url: '/planejamento-controle-producao/salvar-equipamento',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(values),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify('Equipamento salvo com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao salvar equipamento!', 'error', 3000);
                        return {};
                    });
                },
                update: function(key, values) {
                    return $.ajax({
                        url: '/planejamento-controle-producao/salvar-equipamento',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key, ...values }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify('Equipamento atualizado com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao atualizar equipamento!', 'error', 3000);
                        return {};
                    });
                },
                remove: function(key) {
                    return $.ajax({
                        url: '/planejamento-controle-producao/excluir-equipamento',
                        method: 'DELETE',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify('Equipamento excluído com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao excluir equipamento!', 'error', 3000);
                        return {};
                    });
                }
            }),
            keyExpr: 'id',
            columnAutoWidth: true,
            width: '100%',
            height: 600,
            showBorders: true,
            columnChooser: {
                enabled: true,
                mode: "dragAndDrop", // or "select"
                position: { 
                    my: "right", 
                    at: "right", 
                    of: ".dx-datagrid-column-chooser-button" 
                }
            },
            groupPanel: {
                visible: true,
            },
            toolbar: {
                items: [
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-expand", // ícone para expandir
                            text: "",
                            onClick: function () {
                                var grid = $("#gridEquipamentos").dxDataGrid("instance");
                                grid.expandAll(); // Expande todos os grupos
                            }
                        }
                    },
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-compress", // ícone para colapsar
                            text: "",
                            onClick: function () {
                                var grid = $("#gridEquipamentos").dxDataGrid("instance");
                                grid.collapseAll(); // Colapsa todos os grupos
                            }
                        }
                    },
                    {
                        name: "refresh", // Define o nome do botão
                        location: "after", // Coloca o botão após os outros itens na toolbar
                        widget: "dxButton",
                        options: {
                            icon: "refresh", // Ícone de refresh
                            onClick: function() {
                                // Lógica para atualizar/recarregar os dados da grid
                                $("#gridEquipamentos").dxDataGrid("instance").refresh(); // Atualiza a grid
                            },
                            text: "Atualizar" // Texto exibido no botão
                        }
                    }
                ]
            },
            pager: {
                visible: true
            },
            paging: {
                pageSize: 500
            },
            headerFilter: {
                visible: true,
            },
            filterRow: {
                visible: true,
                applyFilter: 'auto',
            },
            export: {
                enabled: true,
                fileName: "Cadastro Equipamentos",
                allowExportSelectedData: false,
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: 'Procure...',
            },
            hoverStateEnabled: true,
            editing: {
                mode: 'popup',
                allowUpdating: true,
                allowAdding: true,
                allowDeleting: false,
                useIcons: true,
                popup: {
                    title: 'Cadastro de Equipamento',
                    showTitle: true,
                    width: 600,
                    height: 'auto',
                    position: { my: 'center', at: 'center', of: window }
                },
                form: {
                    colCount: 2,
                    labelLocation: 'top',
                    items: [
                        { dataField: 'nome', editorType: 'dxTextBox', label: { text: 'Nome do Equipamento' }, validationRules: [{ type: 'required', message: 'Campo obrigatório' }] },
                        { dataField: 'codigo', editorType: 'dxTextBox', label: { text: 'Código (TAG/Identificação)' }, validationRules: [{ type: 'required', message: 'TAG obrigatória' }] },
                        { 
                            dataField: 'quantidade', editorType: 'dxNumberBox',
                            editorOptions: {
                                format: { type: 'fixedPoint', precision: 4 }
                            },
                            validationRules: [{ type: 'required' }]
                        },
                        { 
                            dataField: 'valor',  editorType: 'dxNumberBox',
                            editorOptions: {
                                format: { type: 'currency', currency: 'BRL', precision: 4 }
                            },
                            colSpan: 1,
                            validationRules: [{ type: 'required' }] 
                        },
                        { dataField: 'observacoes', colSpan: 2, editorType: 'dxTextArea', label: { text: 'Observações' }, editorOptions: { height: 100, width: '100%' } },
                        {
                            dataField: 'status',
                            editorType: 'dxSwitch',
                            label: { text: 'Ativo?' },
                            editorOptions: {
                                switchedOnText: 'Ativo',
                                switchedOffText: 'Inativo'
                            },
                            colSpan: 2,
                        }
                    ]
                },
                texts: {
                    confirmDeleteMessage: 'Deseja excluir este equipamento?'
                }
            },
            columns: [
                { dataField: 'codigo', caption: 'Código (TAG/Identificação)', width: 120, alignment: 'center', },
                { dataField: 'nome', caption: 'Nome do Equipamento' },
                {
                    dataField: 'quantidade',
                    caption: 'Qtd. Total',
                    allowEditing: true,
                    alignment: 'right',
                    width: 150,
                    dataType: 'number',
                    format: { type: 'fixedPoint', precision: 4 },
                    validationRules: [{ type: 'required' }]
                },
                {
                    dataField: 'quantidade_disponivel',
                    caption: 'Qtd. Disponível',
                    allowEditing: false,
                    alignment: 'right',
                    width: 150,
                    dataType: 'number',
                    format: { type: 'fixedPoint', precision: 4 },
                    validationRules: [{ type: 'required' }]
                },
                {
                    dataField: 'valor',
                    caption: 'Valor Unitário',
                    allowEditing: true,
                    alignment: 'right',
                    width: 120,
                    dataType: 'number',
                    format: { type: 'currency', currency: 'BRL', precision: 4 },
                    validationRules: [{ type: 'required' }]
                },
                { 
                    dataField: 'custo_total', caption: 'Custo Total', alignment: 'right',
                    width: 120,
                    dataType: 'number',
                    allowEditing: false,
                    format: { type: 'currency', currency: 'BRL', precision: 4 }
                },
                { dataField: 'observacoes', caption: 'Observações' },
                {
                    dataField: 'status',
                    caption: 'Status',
                    dataType: 'boolean',
                    alignment: 'center',
                    width: 120
                },
            ],
            onInitNewRow: function(e) {
                isNovoRegistro = true;
                e.data.status = true;
            },
            onEditingStart: function(e) {
                isNovoRegistro = false;
            },
            onRowUpdating: function(e) {
                e.newData = { ...e.oldData, ...e.newData };
            },
            onToolbarPreparing: function (e) {
                // Aqui você pode personalizar ainda mais a barra de ferramentas
                var toolbarItems = e.toolbarOptions.items;
                // Adicionar os botões de expandir/colapsar
                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-expand",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.expandAll(); // Expande todos os grupos
                        }
                    }
                });

                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-compress",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.collapseAll(); // Colapsa todos os grupos
                        }
                    }
                });

                e.toolbarOptions.items.push({
                    name: "refresh", // Adiciona o botão refresh na toolbar
                    location: "after", // Coloca depois dos outros itens
                    widget: "dxButton",
                    options: {
                        icon: "refresh", // Ícone do botão (ícone de atualização)
                        onClick: function() {
                            // Recarrega os dados da grid
                            e.component.refresh(); // Atualiza a grid
                        },
                        text: "Atualizar" 
                    }
                });
            },     
            onRowPrepared: function(e) {
                if (e.rowType === "data") { // Apenas linhas de dados
                    if (e.data.quantidade_disponivel === 0) {
                        e.rowElement.css({
                            "background-color": "#f8d7da", // Vermelho claro
                            "color": "#721c24" // Opcional: texto vermelho escuro
                        });
                    }
                }
            },       
        });

        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: "raw",
                    load: function() {
                        return $.ajax({
                            url: url,
                            method: "GET",
                            dataType: "json"
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, "error", 3000);
                                return [];
                            }
                        }).catch(error => {
                            DevExpress.ui.notify("Erro ao buscar dados!", "error", 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true,
                onInitialized: function(e) {
                    const val = e.component.option("value");
                    e.component.option("value", val);
                }
            };
        }
    });
</script>
