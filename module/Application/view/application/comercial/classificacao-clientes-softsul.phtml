<script>
    let clientesData = []; // Variável global para armazenar os dados
    let clientesGrid;      // Referência à dxDataGrid
    
    $(document).ready(function() {
        atualizarInfosDashboad();
    });

    $(document).on("click", ".category-card", function () {
        const $card = $(this);
        const idSelecionado = $card.index() + 1;

        // Se o card já está ativo, desativa e limpa o filtro
        if ($card.hasClass("ativo")) {
            $card.removeClass("ativo");
            if (clientesGrid) {
                $('#globalLoading').show(); // Mostra o loading
                clientesGrid.clearFilter(); // limpa todos os filtros
            }
        } else {
            // Remove classe ativa dos outros cards e aplica no clicado
            $(".category-card").removeClass("ativo");
            $card.addClass("ativo");

            // Aplica o filtro na grid
            if (clientesGrid) {
                $('#globalLoading').show(); // Mostra o loading
                clientesGrid.filter(["CATEGORIA_CLIENTE_ID", "=", idSelecionado]);
            }
        }
    });

    function atualizarInfosDashboad() {
        $('#globalLoading').show();

        return new Promise((resolve, reject) => {
            $.ajax({
                url: "/comercial/list-classificacao-clientes-softsul",
                method: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && Array.isArray(response.data)) {
                        clientesData = response.data;

                        // Zera os contadores antes de contar novamente
                        $(".category-card .count").text("0");

                        // Contagem por ID de classificação
                        const contagemPorId = {};

                        clientesData.forEach(cliente => {
                            const idClass = cliente.CATEGORIA_CLIENTE_ID;
                            if (!contagemPorId[idClass]) {
                                contagemPorId[idClass] = 0;
                            }
                            contagemPorId[idClass]++;
                        });

                        // Atualiza os cards com os contadores
                        $(".category-card").each(function () {
                            const idCard = $(this).index() + 1; // IDs de 1 a 7 na ordem
                            const count = contagemPorId[idCard] || 0;
                            $(this).find(".count").text(count);
                        });

                        // Cria ou atualiza a grid
                        if (clientesGrid) {
                            clientesGrid.option("dataSource", clientesData);
                            clientesGrid.clearFilter(); // Mostrar tudo ao carregar
                        } else {
                            inicializarGridClientes();
                        }

                    } else {
                        DevExpress.ui.notify("Erro ao carregar dados", "error", 3000);
                    }
                },
                error: function(error) {
                    DevExpress.ui.notify("Erro na requisição", "error", 3000);
                },
                complete: function() {
                    $('#globalLoading').hide();
                }
            });
        });
    }

