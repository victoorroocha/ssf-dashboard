                { dataField: "CLAPRO", caption: "Classe Prod.", alignment: "center" },
                { dataField: "CLAPRO_DESC", caption: "Classe Descrição", alignment: "left" },
                { dataField: "SITNFSAIDA", caption: "Sit. NF Saída", alignment: "center" },
                { dataField: "SITNFSAIDA_DESCR", caption: "Situação NF", alignment: "left" },
                { dataField: "VENC01_CR", caption: "Vencimento", alignment: "center" },
                { dataField: "TOTAL_CR", caption: "Total CR", alignment: "right", format: "currency" },
                { dataField: "QNTPARC_CR", caption: "Qtde Parc.", alignment: "center" },
                { dataField: "DATGER", caption: "Data Ger.", alignment: "center" },
                { dataField: "USUGER", caption: "Usuário Ger.", alignment: "center" },
                { dataField: "HORGER", caption: "Hora Ger.", alignment: "center" },
                { dataField: "MENSAGEM_1", caption: "Mensagem 1", alignment: "left" },
                { dataField: "OBS_MOTIVO", caption: "Obs Motivo", alignment: "left" },
                { dataField: "MENS1", caption: "Mensagem 1", alignment: "left" },
                { dataField: "MENS2", caption: "Mensagem 2", alignment: "left" },
                { dataField: "MENS3", caption: "Mensagem 3", alignment: "left" },
                { dataField: "MENS4", caption: "Mensagem 4", alignment: "left" },
                { dataField: "MENS5", caption: "Mensagem 5", alignment: "left" },
                { dataField: "MENS6", caption: "Mensagem 6", alignment: "left" },
                { dataField: "MENS7", caption: "Mensagem 7", alignment: "left" },
                { dataField: "MENS8", caption: "Mensagem 8", alignment: "left" },
                { dataField: "MENS9", caption: "Mensagem 9", alignment: "left" }
            ]
        }).dxDataGrid("instance");

        const gridServicos = $("#gridServicos").dxDataGrid({
            dataSource: [],
            keyExpr: "CHAVENFE",
            width: '100%',
            columnAutoWidth: true,
            showColumnLines: false,
            showRowLines: true,
            rowAlternationEnabled: false,
            showBorders: true,
            hoverStateEnabled: false,
            wordWrapEnabled: false,
            // Ordenação
            sorting: {
                mode: 'multiple' // 'single', 'multiple', 'none'
            },
            // Paginação
            paging: {
                pageSize: 20,
                pageIndex: 0
            },
            pager: {
                visible: true,
                showPageSizeSelector: true,
                allowedPageSizes: [10, 100, 200, 500],
                showInfo: true,
                showNavigationButtons: true,
                showPageSizeSelector: true
            },
            // Filtros
            filterRow: {
                visible: true,
                applyFilter: 'auto', // 'auto', 'onClick'
                showOperationChooser: true
            },
            headerFilter: {
                visible: true,
                allowSearch: true
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: 'Procurar...',
                highlightSearchText: true,
                searchVisibleColumnsOnly: false
            },
            filterPanel: {
                visible: false
            },
            filterSyncEnabled: false,
            // Column Chooser
            columnChooser: {
                enabled: true,
                mode: 'select', // 'select', 'dragAndDrop'
                allowSearch: true,
                width: 300,
                height: 400
            },
            grouping: {
                autoExpandAll: false,
                allowCollapsing: true,
                contextMenuEnabled: true,
                expandMode: 'rowClick'
            },
            groupPanel: {
                visible: true,
                emptyPanelText: 'Arraste uma coluna aqui para agrupar por essa coluna',
                allowColumnDragging: true,
            },
            export: {
                enabled: true,
                fileName: "Conferência de Saídas - Serviços",
                allowExportSelectedData: false,
                exportAll: true,
                formats: ['xlsx', 'pdf']
            },
            toolbar: {
                items: [
                    'groupPanel',  // ✅ Agora funcionará
                    'searchPanel',
                    'exportButton',
                    'columnChooserButton'
                ]
            },
            columns: [
                { dataField: "EMPRESA", caption: "Empresa", alignment: "center" },
                { dataField: "FILIAL", caption: "Filial", alignment: "center" },
                { dataField: "CHAVE_CTE", caption: "Chave CTE", alignment: "center" },
                { dataField: "NUMERO_CTE", caption: "Num CTE", alignment: "center" }
            ]
        }).dxDataGrid("instance");


        function carregarDados() {
            const rota = abaAtual === "produtos"
                ? "/contabilidade/list-conferencia-notas-saida-produto"
                : "/contabilidade/list-conferencia-notas-saida-servico";

            const params = {
                dataInicio: filtros.dataInicio ? filtros.dataInicio.toISOString().split("T")[0] : null,
                dataFim: filtros.dataFim ? filtros.dataFim.toISOString().split("T")[0] : null,
                empresa: filtros.empresa || null,
                filial: filtros.filial || null,
                chavenfe: filtros.chavenfe || null
            };

            $.ajax({
                url: rota,
                method: "GET",
                data: params,
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                        if (abaAtual === "produtos") {
                            gridProdutos.option("dataSource", response.data);
                        } else {
                            gridServicos.option("dataSource", response.data);
                        }
                    } else {
                        DevExpress.ui.notify(response.message, "error", 3000);
                    }
                },
                error() {
                    DevExpress.ui.notify("Erro ao carregar dados.", "error", 3000);
                }
            });
        }

        // PRIMEIRO CARREGAMENTO
        carregarDados();


    });
</script>
