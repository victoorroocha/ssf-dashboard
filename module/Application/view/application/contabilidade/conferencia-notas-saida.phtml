                { dataField: "VLRFACS", caption: "Vlr. FACS", alignment: "right" },
                { dataField: "VLRFETHAB", caption: "Vlr. Fethab", alignment: "right" },
                { dataField: "SIT_TRIB", caption: "Sit. Tributária", alignment: "center" },
                { dataField: "CSTPIS", caption: "CST PIS", alignment: "center" },
                { dataField: "PERPIS_FAT", caption: "Perc PIS", alignment: "center" },
                { dataField: "VLRBASE_PIS", caption: "Base PIS", alignment: "right" },
                { dataField: "VLRIMP_PISFAT", caption: "Vlr. PIS", alignment: "right" },
                { dataField: "CSTCOF", caption: "CST COFINS", alignment: "center" },
                { dataField: "PERCOF_FAT", caption: "Perc COFINS", alignment: "center" },
                { dataField: "VLRIMP_COFFAT", caption: "Vlr. COFINS", alignment: "right" },
                { dataField: "VLRRET_COF", caption: "Ret. COFINS", alignment: "right" },
                { dataField: "PERISS", caption: "Perc ISS", alignment: "center" },
                { dataField: "VLRBASE_ISS", caption: "Base ISS", alignment: "right" },
                { dataField: "VLRIMP_ISS", caption: "Vlr. ISS", alignment: "right" },
                { dataField: "PERIRRF", caption: "Perc IRRF", alignment: "center" },
                { dataField: "VLRBASE_IRF", caption: "Base IRRF", alignment: "right" },
                { dataField: "VLRIMP_IRF", caption: "Vlr. IRRF", alignment: "right" },
                { dataField: "PERFAT_COF", caption: "Perc Fat COF", alignment: "center" },
                { dataField: "VLRBASE_COFRET", caption: "Base COF Ret", alignment: "right" },
                { dataField: "VLRIMP_COFRET", caption: "COF Ret", alignment: "right" },
                { dataField: "PERFAT_PIS", caption: "Perc Fat PIS", alignment: "center" },
                { dataField: "VLRBASE_PISRET", caption: "Base PIS Ret", alignment: "right" },
                { dataField: "VLRIMP_PISRET", caption: "PIS Ret", alignment: "right" },
