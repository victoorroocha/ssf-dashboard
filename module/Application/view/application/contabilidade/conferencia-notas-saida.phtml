<script>
    $(document).ready(function() {
        // Estado dos filtros
        let filtros = {
            dataInicio: new Date(),
            dataFim: new Date(),
            empresa: 5,
            filial: null,
            chavenfe: null,
        };

        // Função de validação do período
        function validarPeriodo() {
            if (!filtros.dataInicio || !filtros.dataFim) return true;

            const diffDias = Math.abs(
                (filtros.dataFim - filtros.dataInicio) / (1000 * 60 * 60 * 24)
            );

            if (diffDias > 60) {
                DevExpress.ui.notify(
                    "O período não pode ser superior a 60 dias.",
                    "warning",
                    5000
                );
                return false;
            }

            return true;
        }


        // Inicializa campos DevExtreme
        $("#dataInicio").dxDateBox({
            type: "date",
            displayFormat: "dd/MM/yyyy",
            value: filtros.dataInicio,
            onValueChanged: function (e) {
                filtros.dataInicio = e.value;
                if (!validarPeriodo()) {
                    // Reverter para data anterior válida
                    e.component.option("value", filtros.dataFim);
                    return;
                }
                carregarDados();
            },
        });
        $("#dataFim").dxDateBox({
            type: "date",
            displayFormat: "dd/MM/yyyy",
            value: filtros.dataFim,
            onValueChanged: function (e) {
                filtros.dataFim = e.value;
                if (!validarPeriodo()) {
                    // Reverter para data anterior válida
                    e.component.option("value", filtros.dataInicio);
                    return;
                }
                carregarDados();
            },
        });
        $("#empresa").dxTextBox({
            placeholder: "Informe a empresa...",
            value: filtros.empresa,
            inputAttr: { style: "text-align: center;" }, // 🔹 centraliza o texto
            onValueChanged: function (e) {
                filtros.empresa = e.value;
                carregarDados();
            }
        });
        $("#filial").dxTextBox({
            placeholder: "Informe a filial...",
            value: filtros.filial,
            inputAttr: { style: "text-align: center;" }, // 🔹 centraliza o texto
            onValueChanged: function (e) {
                filtros.filial = e.value;
                carregarDados();
            }
        });
        $("#chavenfe").dxTextBox({
            placeholder: "Informe a chave da nota...",
            value: filtros.chavenfe,
            onValueChanged: function (e) {
                filtros.chavenfe = e.value;
                carregarDados();
            }
        });

        let abaAtual = "produtos";

        $("#tabs").dxTabs({
            dataSource: [
                { id: "produtos", text: "Notas de Produto", classe: "aba-produto" },
                { id: "servicos", text: "Notas de Serviço", classe: "aba-servico" },
            ],
            selectedIndex: 0,
            itemTemplate: function (itemData, itemIndex, itemElement) {
                // adiciona a classe personalizada na aba
                itemElement.addClass(itemData.classe);
                return $("<span>").text(itemData.text);
            },
            onItemClick(e) {
                abaAtual = e.itemData.id;

                // Oculta/mostra as DIVs
                if (abaAtual === "produtos") {
                    $("#gridProdutos").show();
                    $("#gridServicos").hide();
                } else {
                    $("#gridProdutos").hide();
                    $("#gridServicos").show();
                }

                carregarDados();
            }
        });

        const gridProdutos = $("#gridProdutos").dxDataGrid({
            dataSource: [],
            keyExpr: "CHAVENFE",
            width: '100%',
            columnAutoWidth: true,
            showColumnLines: false,
            showRowLines: true,
