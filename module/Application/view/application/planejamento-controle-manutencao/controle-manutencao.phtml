                onShown: function () {
                    $.ajax({
                        url: "/planejamento-controle-manutencao/get-info-ordem-servico",
                        method: 'GET',
                        data: { id: data.id },
                        success: function (response) {
                            try {
                                const dados = response.data.ordemServico;
                                const dadosItens = response.data.itens;
                                if (!dados) throw new Error("Dados não encontrados");

                                // Solicitação
                                $('.numero-os').text(dados?.nr_ordem_servico ? `Nº ${dados.nr_ordem_servico}` : 'Nº 000');
                                $('.os-data').text(dados?.data_solicitacao || '');
                                $('.os-prioridade').text(dados?.prioridade || '');
                                $('.os-solicitante').text(dados?.nome_solicitante || '');
                                $('.os-setor').text(dados?.nome_setor || '');

                                // Dados do Equipamento
                                $('.os-tipo').text(dados?.tipo_manutencao || '');
                                $('.os-equipamento').text(dados?.nome_equipamento || '');
                                $('.os-centro-custo').text(dados?.centro_custo_id || '');
                                $('.os-local').text(dados?.area_tecnica || '');
                                
                                const fieldDefeito = $('.os-defeito').closest('.field.full');
                                if (dados?.descricao_defeito && dados.descricao_defeito.trim() !== '') {
                                    $('.os-defeito').text(dados.descricao_defeito);
                                    fieldDefeito.show(); // exibe a seção
                                } else {
                                    fieldDefeito.hide(); // mantém escondida caso vazio
                                }

                                // Execução do Serviço
                                $('.os-data-programada').text(dados?.data_programada || '');
                                $('.os-data-inicio').text(dados?.data_inicio || '');
                                $('.os-data-final').text(dados?.data_final || '');
                                $('.os-descricao').text(dados?.info_servico || '');
                                $('.os-tecnico').text(dados?.nome_tecnico || '');
                                $('.os-tecnico-executor').text(dados?.nome_tecnico_exec || (dados?.nome_tecnico || ''));

                                // Itens utilizados
                                const secItens = document.getElementById('section-itens');
                                const tbody = secItens.querySelector('tbody');
                                tbody.innerHTML = '';

                                if (dadosItens && dadosItens.length > 0) {
                                    dadosItens.forEach(item => {
                                        const row = document.createElement('tr');
                                        const qtdFormatada = Number(item.qtd_utilizada).toLocaleString('pt-BR', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
                                        const custoUnitarioFormatado = Number(item.custo_unitario).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 4, maximumFractionDigits: 4 });
                                        const custoTotalFormatado = Number(item.custo_total).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 4, maximumFractionDigits: 4 });
                                        const iconeRetirado = item.flg_retirado ? '<span style="color: green;">&#10003;</span>' : '<span style="color: red;">&#10007;</span>';

                                        row.innerHTML = `
                                            <td style="border: 1px solid #ccc; padding: 2px;">${item.descricao_produto}</td>
                                            <td style="border: 1px solid #ccc; padding: 2px;">${item.descricao_deposito}</td>
                                            <td style="border: 1px solid #ccc; padding: 2px; text-align: right;">${qtdFormatada}</td>
                                            <td style="border: 1px solid #ccc; padding: 2px; text-align: right;">${custoUnitarioFormatado}</td>
                                            <td style="border: 1px solid #ccc; padding: 2px; text-align: right;">${custoTotalFormatado}</td>
                                            <td style="border: 1px solid #ccc; padding: 2px; text-align: center;">${iconeRetirado}</td>
                                        `;
                                        tbody.appendChild(row);
                                    });
                                    secItens.style.display = 'block';
                                }

                                // Observações
                                const secObs = document.getElementById('section-observacoes');
                                if (dados?.observacoes && dados.observacoes.trim() !== '') {
                                    $('.os-observacoes').text(dados.observacoes);
                                    secObs.style.display = 'block';
                                }
                            } catch (err) {
                                DevExpress.ui.notify('Erro ao preencher OS: ' + err.message, 'error', 4000);
                            }
                        },
                        error: function (xhr, status, error) {
                            DevExpress.ui.notify('Erro na requisição da OS: ' + error, 'error', 4000);
                        }
                    });
                }
            }).dxPopup('instance');

            osPopup.show();
        }

