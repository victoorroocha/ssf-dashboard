        // Função para atualizar a visibilidade dos campos
        function atualizarVisibilidadeForm(form) {
            const tipoOrdemServico = form.option('formData').tipo_ordem_servico;

            // Esconde e remove obrigatoriedade de ambos os campos
            form.itemOption('equipamento_id', {
                visible: false,
                validationRules: []
            });

            form.itemOption('centro_custo_id', {
                visible: false,
                validationRules: []
            });
            form.itemOption('setor_id', {
                visible: false,
                validationRules: []
            });

            // Mostra e adiciona obrigatoriedade ao campo correto
            if (tipoOrdemServico === 'Equipamento') {
                form.itemOption('equipamento_id', {
                    visible: true,
                    validationRules: [{ type: 'required', message: 'Campo obrigatório' }]
                });
                form.itemOption('centro_custo_id', {
                    visible: true,
                    disabled: true, // bloqueia edição
                    validationRules: []
                });
            } else if (tipoOrdemServico === 'Centro de Custo') {
                form.itemOption('centro_custo_id', {
                    visible: true,
                    disabled: false,
                    validationRules: [{ type: 'required', message: 'Campo obrigatório' }]
                });
                form.itemOption('setor_id', {
                    visible: true,
                    validationRules: [{ type: 'required', message: 'Campo obrigatório' }]
                });
            }
        }
