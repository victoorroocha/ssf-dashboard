                                    } else {
                                        // Destruir TabPanel existente antes de criar
                                        const existingTabPanel = $('#tabpanelFinalizar').dxTabPanel('instance');
                                        if (existingTabPanel) {
                                            existingTabPanel.dispose(); // destrói instância DevExtreme
                                            $('#tabpanelFinalizar').remove(); // remove do DOM
                                        }
                                        DevExpress.ui.notify(response.message || 'OS não encontrada.', 'warning', 3000);
                                    }
                                })
                                .fail(function () {
                                    // Destruir TabPanel existente antes de criar
                                    const existingTabPanel = $('#tabpanelFinalizar').dxTabPanel('instance');
                                    if (existingTabPanel) {
                                        existingTabPanel.dispose(); // destrói instância DevExtreme
                                        $('#tabpanelFinalizar').remove(); // remove do DOM
                                    }

                                    // Quando a validação falhar ou o campo não tiver 5 dígitos
                                    const button = finalizarPopup.option('toolbarItems')[0];
                                    if (button) {
                                        button.options.disabled = true;
                                        finalizarPopup.option('toolbarItems', [button]);
                                    }
                                    DevExpress.ui.notify('Erro ao validar a Ordem de Serviço.', 'error', 3000);
                                });
                        }
                    }).css({ marginBottom: '15px' });
                }
            }).dxPopup('instance');

            finalizarPopup.show();
        }
        function finalizarOS(data) {
            DevExpress.ui.dialog.confirm(
                "Tem certeza que deseja finalizar esta manutenção?\nApós finalizada, não será possível editar os dados.",
                "Confirmação"
            ).then(function (result) {
                if (!result) return; // Usuário clicou "Não"

                const envio = {
                    id: data.id
                };

                $.ajax({
                    url: '/planejamento-controle-manutencao/finalizar-os',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(envio),
                    dataType: 'json'
                }).done(function (response) {
                    if (response.success) {
                        DevExpress.ui.notify('Ordem de Serviço finalizada com sucesso!', 'success', 3000);
                        $('#gridControleManutencao').dxDataGrid('instance').refresh();
                    } else {
                        DevExpress.ui.notify(response.message || 'Erro ao finalizar Ordem de Serviço', 'error', 3000);
                    }
                }).fail(function () {
                    DevExpress.ui.notify('Erro na requisição para finalizar Ordem de Serviço ', 'error', 3000);
                });
            });
        }
        // Função Impressão Direta / Geração de PDF da Ordem de Serviço
        function openOrdemServicoPopup(data) {
            let osPopup = $('#popupOS').dxPopup({
                width: 900,
                height: 'auto',
                showTitle: false,
                dragEnabled: true,
                closeOnOutsideClick: true,
                position: {
                    of: window,
                    at: 'center',
                    my: 'center',
                },
                toolbarItems: [
                    {
                        widget: 'dxButton',
                        location: 'after',
                        toolbar: 'top',
                        options: {
                            icon: 'print',
                            hint: 'Imprimir / Gerar PDF',
                            type: 'default',
                            onClick: async function () {
                                const loading = document.getElementById('globalLoading');
                                const spinnerGen = document.getElementById('spinnerGeneric');
                                const spinnerPDF = document.getElementById('spinnerPDF');
                                const loadingText = document.getElementById('loadingText');

                                try {
                                    if (loading) loading.style.display = 'flex';
                                    if (spinnerGen) spinnerGen.style.display = 'none';
                                    if (spinnerPDF) spinnerPDF.style.display = 'block';
                                    if (loadingText) loadingText.textContent = 'Gerando PDF…';

                                    const printArea = document.getElementById('print-area');
                                    const zoom = window.devicePixelRatio || 1;
                                    const scale = 2 / zoom;

                                    const canvas = await html2canvas(printArea, {
                                        scale: scale,
                                        useCORS: true,
                                        logging: false,
                                        allowTaint: true,
                                        backgroundColor: 'white',
                                    });

                                    const { jsPDF } = window.jspdf;
                                    const pdf = new jsPDF('p', 'mm', 'a4');
                                    const pageWidth = pdf.internal.pageSize.getWidth();
                                    const pageHeight = pdf.internal.pageSize.getHeight();
                                    const margemMm = 30 * 0.264583;

                                    const imgData = canvas.toDataURL('image/png', 1.0);
                                    const props = pdf.getImageProperties(imgData);

                                    const pdfWidth = pageWidth - 2 * margemMm;
                                    const maxPdfHeight = pageHeight - 2 * margemMm;

                                    let pdfHeight = (props.height * pdfWidth) / props.width;
                                    if (pdfHeight > maxPdfHeight) {
                                        pdfHeight = maxPdfHeight;
                                    }

                                    pdf.addImage(imgData, 'PNG', margemMm, margemMm, pdfWidth, pdfHeight, undefined, 'FAST');
                                    pdf.save(`ordem-de-servico-${data.id}.pdf`);
                                } catch (err) {
                                    console.error('Erro ao gerar PDF:', err);
                                    DevExpress.ui.notify('Erro ao gerar PDF. Verifique o console para detalhes.', 'error', 4000);
                                } finally {
                                    if (spinnerPDF) spinnerPDF.style.display = 'none';
                                    if (spinnerGen) spinnerGen.style.display = 'block';
                                    if (loadingText) loadingText.textContent = 'Carregando Informações...';
                                    if (loading) loading.style.display = 'none';
                                }
                            }
                        }
                    }
                ],
                contentTemplate: function (contentElement) {
                    const scrollableContent = $("<div>").dxScrollView({
