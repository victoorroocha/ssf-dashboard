<style>
    #print-area {
        background: white;
        width: 100%;
        max-width: 100%; /* Alterado para ocupar toda a largura disponível */
        margin: 0 auto; /* Centralizado */
        padding: 15px; /* Reduzido para economizar espaço */
        border: 1px solid #ccc;
        box-sizing: border-box;
        font-size: 0.9em; /* Tamanho de fonte base reduzido */
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #0f172a;
        padding-bottom: 8px; /* Reduzido */
        margin-bottom: 15px; /* Reduzido */
        flex-wrap: wrap;
    }

    .header h1 {
        font-size: 1.25em; /* Usando em para escalabilidade */
        margin: 0;
        color: #0f172a;
        font-weight: 600; /* Mais semântico que bold */
    }

    .header .numero-os {
        font-size: 18px;
        color: #ef4444;
        font-weight: 500;
    }

    .section {
        margin-bottom: 15px; /* Reduzido */
    }

    .section-title {
        font-weight: 600;
        background: #0f172a;
        color: white;
        padding: 5px 8px; /* Reduzido */
        font-size: 0.95em; /* Reduzido */
        border-radius: 3px; /* Adicionado para suavizar */
        margin-bottom: 8px; /* Adicionado espaçamento */
    }

    .field-group {
        display: flex;
        flex-wrap: wrap;
        gap: 8px; /* Reduzido para economizar espaço */
    }

    .field {
        flex: 1 1 calc(50% - 8px); /* Ajustado para o novo gap */
        padding: 6px; /* Reduzido */
        border: 1px solid #e2e8f0; /* Cor mais suave */
        border-radius: 4px;
        box-sizing: border-box;
        background-color: #f8fafc; /* Fundo sutil para melhor legibilidade */
    }
    .field.third {
        flex: 1 1 calc(33.333% - 8px); /* para 3 colunas com gap de 8px */
    }

    .field.full {
        flex: 1 1 100%;
    }

    .label {
        font-weight: 500; /* Mais suave que bold */
        display: block;
        margin-bottom: 2px; /* Reduzido */
        font-size: 0.85em;
        color: #475569; /* Cor mais suave */
    }

    .value {
        font-size: 0.9em;
        min-height: 1.2em; /* Baseado em em para escalabilidade */
        word-break: break-word;
        color: #1e293b; /* Cor mais escura para melhor contraste */
        padding: 2px 0; /* Pequeno espaçamento interno */
        white-space: pre-wrap; /* mantém quebras de linha do texto */
        word-wrap: break-word; /* reforço para não estourar o layout */
    }

    .signature {
        margin-top: 30px; /* Reduzido */
        border-top: 1px dashed #cbd5e1; /* Cor mais suave */
        text-align: center;
        padding-top: 8px;
        font-size: 0.9em;
        color: #64748b; /* Cor mais suave */
    }

    /* #ordemServicoContent {
        max-height: 90vh;
        overflow-y: auto;
        overflow-x: hidden;
    } */

    /* Adicionando responsividade para telas menores */
    @media (max-width: 600px) {
        .field {
            flex: 1 1 100%; /* Em telas pequenas, campos ocupam linha inteira */
        }
        
        .header {
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }
        
        .header .numero-os {
            align-self: flex-end;
        }
    }


    @media print {
        body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        #print-area {
            page-break-inside: avoid;
        }

        /* Evita quebra dentro das seções */
        .section, .signature {
            page-break-inside: avoid;
            page-break-before: auto;
            page-break-after: auto;
        }

        /* Força a assinatura a ir para a próxima página se não couber */
        .signature {
            page-break-before: always;
        }
    }







    /* teste template equipamentos selectBox */
    .equipamento-template {
        padding: 8px;
        line-height: 1.4;
    }

    .equipamento-header {
        font-size: 14px;
        margin-bottom: 5px;
        border-bottom: 1px solid #eee;
        padding-bottom: 3px;
    }

    .equipamento-details {
        font-size: 12px;
        color: #020202ff;
    }

    .equipamento-details div {
        margin-bottom: 2px;
    }
</style>

<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Planejamento e Controle da Manutenção</h1>
    </div>

    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Ordens de Serviço</p>

                    <div id="gridControleManutencao"></div>
                    <div id="popupOS"></div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        var produtosLookup = []; 
        // getLookupProdutos();

        let controleManutencaoGrid = $('#gridControleManutencao').dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: 'id',
                load: function () {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/listar-controles-manutencao',
                        method: 'GET',
                        dataType: 'json'
                    }).then(response => {
                        if (response.success) {
                            return {
                                data: response.data,
                                totalCount: response.totalCount || response.data.length
                            };
                        } else {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                            return { data: [], totalCount: 0 };
                        }
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao carregar controles!', 'error', 3000);
                        return { data: [], totalCount: 0 };
                    });
                },
                insert: function (values) {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/salvar-controle-manutencao',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(values),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Controle salvo com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao salvar controle!', 'error', 3000);
                        return {};
                    });
                },
                update: function (key, values) {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/salvar-controle-manutencao',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key, ...values }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Controle atualizado com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao atualizar controle!', 'error', 3000);
                        return {};
                    });
                },
                remove: function (key) {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/excluir-controle-manutencao',
                        method: 'DELETE',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Controle excluído com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao excluir controle!', 'error', 3000);
                        return {};
                    });
                }
            }),
            keyExpr: 'id',
            columnAutoWidth: true,
            width: '100%',
            height: 'auto',
            showBorders: true,
            columnChooser: {
                enabled: true,
                mode: "dragAndDrop", // or "select"
                position: { 
                    my: "right", 
                    at: "right", 
                    of: ".dx-datagrid-column-chooser-button" 
                }
            },
            groupPanel: {
                visible: true,
            },
            toolbar: {
                items: [
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-expand", // ícone para expandir
                            text: "",
                            onClick: function () {
                                var grid = $("#gridControleManutencao").dxDataGrid("instance");
                                grid.expandAll(); // Expande todos os grupos
                            }
                        }
                    },
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-compress", // ícone para colapsar
                            text: "",
                            onClick: function () {
                                var grid = $("#gridControleManutencao").dxDataGrid("instance");
                                grid.collapseAll(); // Colapsa todos os grupos
                            }
                        }
                    },
                    {
                        name: "refresh", // Define o nome do botão
                        location: "after", // Coloca o botão após os outros itens na toolbar
                        widget: "dxButton",
                        options: {
                            icon: "refresh", // Ícone de refresh
                            onClick: function() {
                                // Lógica para atualizar/recarregar os dados da grid
                                $("#gridControleManutencao").dxDataGrid("instance").refresh(); // Atualiza a grid
                            },
                            text: "Atualizar" // Texto exibido no botão
                        }
                    }
                ]
            },
            paging: {
                pageSize: 500,
            },
            pager: {
                visible: true,
                allowedPageSizes: [5, 10, 100, 200, 500],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
            headerFilter: {
                visible: true,
            },
            filterRow: {
                visible: true,
                applyFilter: 'auto',
            },
            export: {
                enabled: true,
                fileName: "Controle Manutenções",
                allowExportSelectedData: false,
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: 'Procure...',
            },
            hoverStateEnabled: true,
            editing: {
                mode: 'popup',
                allowUpdating: true,
                allowAdding: true,
                allowDeleting: true,
                useIcons: true,
                popup: {
                    title: "Ordem de Serviço",
                    showTitle: true,
                    width: '800px',
                    resizeEnabled: true,
                    autoResizeEnabled: true,
                    height: '95%', 
                    // maxHeight: '95vh'
                },
                form: {
                    colCount: 2,
                    labelLocation: 'top',
                    items: [
                        { 
                            dataField: 'data_solicitacao', 
                            label: { text: 'Data Solicitação' }, 
                            editorType: 'dxDateBox', 
                            editorOptions: { 
                                type: 'date', 
                                value: new Date() // define a data atual como padrão
                            }, 
                            colSpan: 2 
                        },
                        { dataField: 'data_inicio', label: { text: 'Data Início' }, editorType: 'dxDateBox', editorOptions: { type: 'date' }, colSpan: 1, },
                        {
                            dataField: 'tempo_previsto',
                            editorType: 'dxTextBox',
                            label: { text: 'Tempo Previsto' },
                            colSpan: 1,
                            editorOptions: {
                                mask: "00:00",
                                maskRules: {
                                    "0": /[0-9]/
                                },
                                placeholder: "00:00",
                                useMaskedValue: true,
                                value: "00:00" // valor inicial
                            }
                        },
                        {
                            dataField: 'nome_solicitante',
                            label: { text: 'Nome do Solicitante' },
                            editorType: 'dxSelectBox',
                            colSpan: 2,
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-usuarios-senior-lookup', 'NOME_COLABORADOR', 'NOME_COLABORADOR', 'Selecione o solicitante'),
                            validationRules: [{ type: 'required', message: 'Solicitante é obrigatório' }]
                        },
                        {
                            dataField: 'tipo_ordem_servico',
                            editorType: 'dxSelectBox',
                            label: { text: 'Tipo Ordem de Serviço' },
                            colSpan: 2,
                            editorOptions: {
                                items: ['Equipamento', 'Centro de Custo'],
                                placeholder: 'Selecione o tipo',
                            },
                            validationRules: [{ type: 'required', message: 'Tipo Ordem de Serviço é obrigatório' }]
                        },
                        { 
                            dataField: 'equipamento_id', 
                            label: { text: 'Equipamento' }, 
                            editorType: 'dxSelectBox', 
                            colSpan: 2, 
                            visible: false,
                            editorOptions: {
                                dataSource: new DevExpress.data.DataSource({
                                    store: new DevExpress.data.CustomStore({
                                        key: 'id',
                                        load: function(loadOptions) {
                                            const deferred = $.Deferred();
                                            const searchValue = (loadOptions.searchValue || '').toUpperCase();
                                            const skip = loadOptions.skip || 0;
                                            const take = loadOptions.take || 30;
                                            
                                            return $.ajax({
                                                url: '/planejamento-controle-manutencao/get-lookup-equipamentos',
                                                dataType: 'json',
                                                data: { 
                                                    search: searchValue,
                                                    offset: skip,
                                                    limit: take
                                                }
                                            }).then(result => {
                                                const data = result.data || result;
                                                return {
                                                    data: data,
                                                    totalCount: result.totalCount || 1000 // Número estimado ou real
                                                };
                                            }).catch(() => {
                                                return { data: [], totalCount: 0 };
                                            });
                                        },
                                        byKey: function(key) {
                                            return $.ajax({
                                                url: '/planejamento-controle-manutencao/get-lookup-equipamentos', // Nova rota específica
                                                dataType: 'json',
                                                data: { key: key } // Envia como parâmetro GET
                                            }).then(result => result.data || result);
                                        }
                                    }),
                                    paginate: true,
                                    pageSize: 30 // Tamanho padrão da página
                                }),
                                valueExpr: 'id',
                                searchEnabled: true,
                                searchExpr: ['codigo', 'nome', 'setor_nome', 'centro_custo'],
                                searchTimeout: 500,
                                minSearchLength: 0,
                                itemTemplate: function(data) {
                                    return `
                                        <div class="equipamento-template">
                                            <div class="equipamento-header">
                                                <strong>${data.codigo || 'Sem código'}</strong> - ${data.nome || 'Sem nome'}
                                            </div>
                                            <div class="equipamento-details">
                                                <div><small><strong>Setor:</strong> ${data.setor_nome || 'Não informada'}</small></div>
                                                <div><small><strong>Centro de Custo:</strong> ${data.centro_custo || 'Não informado'}</small></div>
                                                <div><small><strong>Status:</strong> ${data.status || 'Não informado'}</small></div>
                                                <div><small><strong>Observação:</strong> ${data.observacoes || 'Nenhuma'}</small></div>
                                            </div>
                                        </div>
                                    `;
                                },
                                displayExpr: function(item) {
                                    return item ? `${item.codigo} - ${item.nome}` : '';
                                },
                                placeholder: 'Digite para buscar...',
                                showClearButton: true,
                                showDataBeforeSearch: true
                            } 
                        },
                        {
                            dataField: 'centro_custo_id',
                            colSpan: 2,
                            editorType: 'dxSelectBox',
                            label: { text: 'Centro de Custo' },
                            visible: false,
                            editorOptions: {
                                dataSource: new DevExpress.data.DataSource({
                                    store: new DevExpress.data.CustomStore({
                                        key: 'ID',
                                        load: function (loadOptions) {
                                            const deferred = $.Deferred();
                                            const searchValue = (loadOptions.searchValue || '').toUpperCase();
                                            const skip = loadOptions.skip || 0;
                                            const take = loadOptions.take || 30;

                                            return $.ajax({
                                                url: '/planejamento-controle-manutencao/get-centro-custo-lookup',
                                                dataType: 'json',
                                                data: {
                                                    search: searchValue,
                                                    offset: skip,
                                                    limit: take
                                                }
                                            }).then(result => {
                                                const data = result.data || [];
                                                return {
                                                    data: data,
                                                    totalCount: result.totalCount || data.length
                                                };
                                            }).catch(() => {
                                                return { data: [], totalCount: 0 };
                                            });
                                        },
                                        byKey: function (key) {
                                            return $.ajax({
                                                url: '/planejamento-controle-manutencao/get-centro-custo-lookup',
                                                dataType: 'json',
                                                data: { key: key }
                                            }).then(result => {
                                                const item = (result.data || []).find(d => d.ID == key);
                                                return item || null;
                                            });
                                        }
                                    }),
                                    paginate: true,
                                    pageSize: 30
                                }),
                                valueExpr: 'ID',
                                displayExpr: 'DSC',
                                searchEnabled: true,
                                searchExpr: ['DSC'],
                                searchTimeout: 500,
                                minSearchLength: 0,
                                placeholder: 'Digite para buscar...',
                                showClearButton: true,
                                showDataBeforeSearch: true
                            }
                        },

                        { 
                            dataField: 'setor_id', 
                            label: { text: 'Setor' }, 
                            editorType: 'dxSelectBox', 
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-setores', 'nome', 'id', 'Selecione o setor') 
                        },
                        {
                            dataField: 'prioridade',
                            editorType: 'dxSelectBox',
                            label: { text: 'Prioridade' },
                            editorOptions: {
                                items: ['Baixa', 'Média', 'Alta'],
                                placeholder: 'Selecione a prioridade',
                                width: '100%'
                            },
                            validationRules: [{ type: 'required' }]
                        },
                        { 
                            dataField: 'tecnico_id', 
                            label: { text: 'Técnico Responsável' }, 
                            editorType: 'dxSelectBox', 
                            colSpan: 2, 
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-tecnicos', 'nome', 'id', 'Selecione o técnico') 
                        },
                        { 
                            dataField: 'tipo_manutencao_id', 
                            label: { text: 'Tipo Manutenção' }, 
                            editorType: 'dxSelectBox', editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/listar-tipos-manutencao', 'nome', 'id', 'Selecione o tipo') 
                        },
                        { 
                            dataField: 'area_tecnica_id', 
                            label: { text: 'Área Técnica' }, 
                            editorType: 'dxSelectBox', 
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-areas', 'nome', 'id', 'Selecione a área técnica') 
                        },
                        { dataField: 'descricao_defeito', label: { text: 'Descrição do Defeito' }, editorType: 'dxTextArea', colSpan: 2, editorOptions: { height: 60 } },
                        { dataField: 'info_servico', label: { text: 'Check-List' }, editorType: 'dxTextArea', colSpan: 2, editorOptions: { height: 60 } },
                        { dataField: 'observacoes', label: { text: 'Observações Adicionais' }, editorType: 'dxTextArea', colSpan: 2, editorOptions: { height: 60 } },
                    ]
                }
            },
            columns: [
                { 
                    dataField: 'id', 
                    caption: 'OS', 
                    alignment: 'center', 
                    width: 110,
                    calculateDisplayValue: function(rowData) {
                        return String(rowData.id).padStart(5, '0');
                    }
                },
                { dataField: 'data_solicitacao', caption: 'Dt. Solicitação', dataType: 'date', alignment: 'center', width: 110 },
                {
                    dataField: 'data_programada',
                    caption: 'Data Programada',
                    dataType: 'date',
                    alignment: 'center', 
                    visible: false,
                    width: 110,
                },
                { 
                    dataField: 'data_inicio', 
                    caption: 'Dt. Início', 
                    dataType: 'date', 
                    alignment: 'center', 
                    width: 110,
                    sortIndex: 1, 
                    sortOrder: 'asc',
                    calculateSortValue: function (rowData) {
                        return rowData.data_inicio ? new Date(rowData.data_inicio) : new Date(8640000000000000); 
                    }
                },
                { 
                    dataField: 'tempo_previsto', 
                    caption: 'Tempo Previsto', 
                    visible: false
                },
                { 
                    dataField: 'data_final', 
                    caption: 'Dt. Finalização', 
                    dataType: 'date', 
                    alignment: 'center', 
                    width: 110,
                },
                { dataField: 'nome_solicitante', caption: 'Solicitante', visible: false },
                { dataField: 'tipo_ordem_servico', caption: 'Tipo Ordem Serviço', visible: false, width: 200 },
                { 
                    dataField: 'equipamento_id', 
                    caption: 'Equipamento', 
                    width: 300, 
                    lookup: { 
                        dataSource: new DevExpress.data.CustomStore({ load: () => $.getJSON('/planejamento-controle-manutencao/listar-equipamentos') }), 
                        displayExpr: 'dsc_equipamento', 
                        valueExpr: 'id' 
                    },
                    setCellValue: function(newData, value, currentRowData) {
                        newData.equipamento_id = value;

                        // Pega o item selecionado no lookup (que já tem centro_custo_id)
                        const selectedItem = this.lookup.items.find(item => item.id === value);

                        if (selectedItem) {
                            newData.centro_custo_id = selectedItem.centro_custo;
                        }
                    }
                },
                {
                    dataField: 'centro_custo_id',
                    caption: 'Centro de Custo',
                    width: 200,
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/listar-centros-custo')
                        }),
                        displayExpr: 'DSC',
                        valueExpr: 'ID'
                    }
                },
                { dataField: 'tecnico_id', caption: 'Técnico Responsável', visible: false, lookup: { dataSource: new DevExpress.data.CustomStore({ load: () => $.getJSON('/planejamento-controle-manutencao/listar-tecnicos') }), displayExpr: 'nome', valueExpr: 'id' } },
                { 
                    dataField: 'setor_id', 
                    caption: 'Setor', 
                    // groupIndex: 0,
                    lookup: { dataSource: new DevExpress.data.CustomStore({ load: () => $.getJSON('/planejamento-controle-manutencao/listar-setores') }), displayExpr: 'nome', valueExpr: 'id' }, 
                    width: 160
                },
                {
                    dataField: 'tipo_manutencao_id',
                    caption: 'Tipo Manutenção',
                    alignment: 'center',
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/listar-tipos-manutencao')
                        }),
                        displayExpr: 'nome',
                        valueExpr: 'id'
                    }, 
                    width: 'auto'
                },
                {
                    dataField: 'area_tecnica_id',
                    caption: 'Área Técnica',
                    visible: false,
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/listar-areas')
                        }),
                        displayExpr: 'nome',
                        valueExpr: 'id'
                    }
                },
                { dataField: 'descricao_defeito', caption: 'Descrição do Defeito', visible: false },
                { dataField: 'info_servico', caption: 'Check-List', visible: false },
                { dataField: 'observacoes', caption: 'Observações Adicionais', visible: false },
                { dataField: 'custo_total', caption: 'Custo (R$)', format: { type: 'fixedPoint', precision: 2 }, visible: false },
                { dataField: 'prioridade', caption: 'Prioridade', visible: false },
                {
                    dataField: 'status',
                    caption: 'Status',
                    sortIndex: 0,
                    alignment: 'center',
                    sortOrder: 'asc',
                    calculateSortValue: function(rowData) {
                        // Forçar a ordem: Pendente < Finalizada
                        const order = { 'pendente': 0, 'finalizada': 1 };
                        return order[(rowData.status || '').toLowerCase()] ?? 99;
                    }
                },
                {
                    type: 'buttons',
                    width: 120,
                    alignment: 'center',
                    buttons: [
                        {
                            name: 'edit',
                            visible: function (e) {
                                return e.row.data.status !== 'Finalizada';
                            }
                        },
                        {
                            name: 'delete',
                            visible: function (e) {
                                return e.row.data.qtd_apontamentos === 0;
