                                            <div class="field third"><span class="label">Data Final:</span><div class="value os-data-final"></div></div>
                                            <div class="field full"><span class="label">Descrição do Serviço Realizado:</span><div class="value os-descricao"></div></div>
                                            <div class="field"><span class="label">Técnico(s) Responsável(s):</span><div class="value os-tecnico"></div></div>
                                        </div>
                                    </div>

                                    <div class="section">
                                        <div class="section-title">Itens Utilizados</div>
                                        <div class="field-group">
                                            <table class="os-itens-utilizados" style="width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 10px;">
                                                <thead>
                                                    <tr>
                                                        <th style="border: 1px solid #ccc; padding: 2px;">Produto</th>
                                                        <th style="border: 1px solid #ccc; padding: 2px;">Depósito</th>
                                                        <th style="border: 1px solid #ccc; padding: 2px;">Quantidade</th>
                                                        <th style="border: 1px solid #ccc; padding: 2px;">Custo Unitário</th>
                                                        <th style="border: 1px solid #ccc; padding: 2px;">Custo Total</th>
                                                        <th style="border: 1px solid #ccc; padding: 2px; text-align: center;"">Retirado?</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <div class="section">
                                        <div class="section-title">Observações Finais</div>
                                        <div class="field-group">
                                            <div class="field full"><div class="value os-observacoes"></div></div>
                                        </div>
                                    </div>

                                    <br />
                                    <div class="signature">Assinatura do Responsável</div>
                                </div>
                            </section>
                        </div>
                    `);
                    contentElement.append(osContent);
                },
                onShown: function () {
                    $.ajax({
                        url: "/planejamento-controle-manutencao/get-info-ordem-servico",
                        method: 'GET',
                        data: { id: data.id },
                        success: function (response) {
                            try {
                                const dados = response.data.ordemServico;
                                const dadosItens = response.data.itens;
                                if (!dados) throw new Error("Dados não encontrados");

                                // Solicitação
                                $('.numero-os').text(dados?.nr_ordem_servico ? `Nº ${dados.nr_ordem_servico}` : 'Nº 000');
                                $('.os-data').text(dados?.data_solicitacao ? dados.data_solicitacao : '');
                                $('.os-prioridade').text(dados?.prioridade ? dados.prioridade : '');
                                $('.os-solicitante').text(dados?.nome_solicitante ? dados.nome_solicitante : '');
                                $('.os-setor').text(dados?.nome_setor ? dados.nome_setor : '');

                                // Dados do Equipamento
                                $('.os-tipo').text(dados?.tipo_manutencao ? dados.tipo_manutencao : '');
                                $('.os-equipamento').text(dados?.nome_equipamento ? dados.nome_equipamento : '');
                                $('.os-local').text(dados?.area_tecnica ? dados.area_tecnica : '');
                                $('.os-defeito').text(dados?.descricao_defeito ? dados.descricao_defeito : '');

                                // Execução do Serviço
                                $('.os-data-programada').text(dados?.data_programada ? dados.data_programada : '');
                                $('.os-data-inicio').text(dados?.data_inicio ? dados.data_inicio : '');
                                $('.os-data-final').text(dados?.data_final ? dados.data_final : '');
                                $('.os-descricao').text(dados?.info_servico ? dados.info_servico : '');
                                $('.os-tecnico').text(dados?.nome_tecnico ? dados.nome_tecnico : '');

                                // Itens utilizados
                                const tbody = document.querySelector('.os-itens-utilizados tbody');
                                tbody.innerHTML = ''; // limpa

                                dadosItens.forEach(item => {
                                    const row = document.createElement('tr');

                                    const qtdFormatada = Number(item.qtd_utilizada).toLocaleString('pt-BR', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
                                    const custoUnitarioFormatado = Number(item.custo_unitario).toLocaleString('pt-BR', { 
                                        style: 'currency', 
                                        currency: 'BRL', 
                                        minimumFractionDigits: 4, 
                                        maximumFractionDigits: 4 
                                    });
                                    const custoTotalFormatado = Number(item.custo_total).toLocaleString('pt-BR', { 
                                        style: 'currency', 
                                        currency: 'BRL', 
                                        minimumFractionDigits: 4, 
                                        maximumFractionDigits: 4 
                                    });

                                    // Ícone condicional
                                    const iconeRetirado = item.flg_retirado
                                        ? '<span style="color: green;">&#10003;</span>' // ✔ verde
                                        : '<span style="color: red;">&#10007;</span>';  // ✗ vermelho

                                    row.innerHTML = `
                                        <td style="border: 1px solid #ccc; padding: 2px;">${item.descricao_produto}</td>
                                        <td style="border: 1px solid #ccc; padding: 2px;">${item.descricao_deposito}</td>
                                        <td style="border: 1px solid #ccc; padding: 2px; text-align: right;">${qtdFormatada}</td>
                                        <td style="border: 1px solid #ccc; padding: 2px; text-align: right;">${custoUnitarioFormatado}</td>
                                        <td style="border: 1px solid #ccc; padding: 2px; text-align: right;">${custoTotalFormatado}</td>
                                        <td style="border: 1px solid #ccc; padding: 2px; text-align: center;">${iconeRetirado}</td>
                                    `;
                                    tbody.appendChild(row);
                                });

                                //Observações Finais
                                $('.os-observacoes').text(dados?.observacoes ? dados.observacoes : '');
                            } catch (err) {
                                DevExpress.ui.notify('Erro ao preencher OS: ' + err.message, 'error', 4000);
                            }
                        },
                        error: function (xhr, status, error) {
                            DevExpress.ui.notify('Erro na requisição da OS: ' + error, 'error', 4000);
                        }
                    });
                }
            }).dxPopup('instance');

            osPopup.show();
        }
        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: 'raw',
                    load: function () {
                        return $.ajax({
                            url: url,
                            method: 'GET',
                            dataType: 'json'
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, 'error', 3000);
                                return [];
                            }
                        }).catch(() => {
                            DevExpress.ui.notify('Erro ao buscar dados!', 'error', 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true
            };
        }
    });
</script>
