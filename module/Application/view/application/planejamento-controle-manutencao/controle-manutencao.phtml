            onRowPrepared: function (e) {
                if (e.rowType === 'data') {
                    const status = (e.data.status || '').toLowerCase();
                    const hoje = new Date();
                    const dataProgramada = e.data.data_programada ? new Date(e.data.data_programada) : null;
                    const dataInicio = e.data.data_inicio ? new Date(e.data.data_inicio) : null;
                    const dataFim = e.data.data_fim ? new Date(e.data.data_fim) : null;

                    if (status === 'finalizada') {
                        e.rowElement.css({ backgroundColor: '#DFF6DD', color: '#000' }); // Verde
                        return;
                    }

                    if (dataInicio) {
                        // Em Execução
                        e.rowElement.css({ backgroundColor: '#D6EAF8', color: '#000' }); // Azul (ajuste a cor se preferir)
