<style>
    #print-area {
        background: white;
        width: 100%;
        max-width: 100%; /* Alterado para ocupar toda a largura disponível */
        margin: 0 auto; /* Centralizado */
        padding: 15px; /* Reduzido para economizar espaço */
        border: 1px solid #ccc;
        box-sizing: border-box;
        font-size: 0.9em; /* Tamanho de fonte base reduzido */
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #0f172a;
        padding-bottom: 8px; /* Reduzido */
        margin-bottom: 15px; /* Reduzido */
        flex-wrap: wrap;
    }

    .header h1 {
        font-size: 1.25em; /* Usando em para escalabilidade */
        margin: 0;
        color: #0f172a;
        font-weight: 600; /* Mais semântico que bold */
    }

    .header .numero-os {
        font-size: 18px;
        color: #ef4444;
        font-weight: 500;
    }

    .section {
        margin-bottom: 15px; /* Reduzido */
    }

    .section-title {
        font-weight: 600;
        background: #0f172a;
        color: white;
        padding: 5px 8px; /* Reduzido */
        font-size: 0.95em; /* Reduzido */
        border-radius: 3px; /* Adicionado para suavizar */
        margin-bottom: 8px; /* Adicionado espaçamento */
    }

    .field-group {
        display: flex;
        flex-wrap: wrap;
        gap: 8px; /* Reduzido para economizar espaço */
    }

    .field {
        flex: 1 1 calc(50% - 8px); /* Ajustado para o novo gap */
        padding: 6px; /* Reduzido */
        border: 1px solid #e2e8f0; /* Cor mais suave */
        border-radius: 4px;
        box-sizing: border-box;
        background-color: #f8fafc; /* Fundo sutil para melhor legibilidade */
    }
    .field.third {
        flex: 1 1 calc(33.333% - 8px); /* para 3 colunas com gap de 8px */
    }

    .field.full {
        flex: 1 1 100%;
    }

    .label {
        font-weight: 500; /* Mais suave que bold */
        display: block;
        margin-bottom: 2px; /* Reduzido */
        font-size: 0.85em;
        color: #475569; /* Cor mais suave */
    }

    .value {
        font-size: 0.9em;
        min-height: 1.2em; /* Baseado em em para escalabilidade */
        word-break: break-word;
        color: #1e293b; /* Cor mais escura para melhor contraste */
        padding: 2px 0; /* Pequeno espaçamento interno */
    }

    .signature {
        margin-top: 30px; /* Reduzido */
        border-top: 1px dashed #cbd5e1; /* Cor mais suave */
        text-align: center;
        padding-top: 8px;
        font-size: 0.9em;
        color: #64748b; /* Cor mais suave */
    }

    #ordemServicoContent {
        max-height: 90vh;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Adicionando responsividade para telas menores */
    @media (max-width: 600px) {
        .field {
            flex: 1 1 100%; /* Em telas pequenas, campos ocupam linha inteira */
        }
        
        .header {
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }
        
        .header .numero-os {
            align-self: flex-end;
        }
    }

</style>

<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Planejamento e Controle da Manutenção</h1>
    </div>

    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Controle das Manutenções - Ordem de Serviço</p>

                    <div id="gridControleManutencao"></div>
                    <div id="popupOS"></div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        var produtosLookup = []; 
        getLookupProdutos();


        let controleManutencaoGrid = $('#gridControleManutencao').dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: 'id',
                load: function () {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/listar-controles-manutencao',
                        method: 'GET',
                        dataType: 'json'
                    }).then(response => {
                        if (response.success) {
                            return {
                                data: response.data,
                                totalCount: response.totalCount || response.data.length
                            };
                        } else {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                            return { data: [], totalCount: 0 };
                        }
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao carregar controles!', 'error', 3000);
                        return { data: [], totalCount: 0 };
                    });
                },
                insert: function (values) {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/salvar-controle-manutencao',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(values),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Controle salvo com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao salvar controle!', 'error', 3000);
                        return {};
                    });
                },
                update: function (key, values) {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/salvar-controle-manutencao',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key, ...values }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Controle atualizado com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao atualizar controle!', 'error', 3000);
                        return {};
                    });
                },
                remove: function (key) {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/excluir-controle-manutencao',
                        method: 'DELETE',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Controle excluído com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao excluir controle!', 'error', 3000);
                        return {};
                    });
                }
            }),
            keyExpr: 'id',
            columnAutoWidth: true,
            width: '100%',
            height: 600,
            showBorders: true,
            columnChooser: {
                enabled: true,
                mode: "dragAndDrop", // or "select"
                position: { 
                    my: "right", 
                    at: "right", 
                    of: ".dx-datagrid-column-chooser-button" 
                }
            },
            groupPanel: {
                visible: true,
            },
            toolbar: {
                items: [
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-expand", // ícone para expandir
                            text: "",
                            onClick: function () {
                                var grid = $("#gridControleManutencao").dxDataGrid("instance");
                                grid.expandAll(); // Expande todos os grupos
                            }
                        }
                    },
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-compress", // ícone para colapsar
                            text: "",
                            onClick: function () {
                                var grid = $("#gridControleManutencao").dxDataGrid("instance");
                                grid.collapseAll(); // Colapsa todos os grupos
                            }
                        }
                    },
                    {
                        name: "refresh", // Define o nome do botão
                        location: "after", // Coloca o botão após os outros itens na toolbar
                        widget: "dxButton",
                        options: {
                            icon: "refresh", // Ícone de refresh
                            onClick: function() {
                                // Lógica para atualizar/recarregar os dados da grid
                                $("#gridControleManutencao").dxDataGrid("instance").refresh(); // Atualiza a grid
                            },
                            text: "Atualizar" // Texto exibido no botão
                        }
                    }
                ]
            },
            pager: {
                visible: true
            },
            paging: {
                pageSize: 500
            },
            headerFilter: {
                visible: true,
            },
            filterRow: {
                visible: true,
                applyFilter: 'auto',
            },
            export: {
                enabled: true,
                fileName: "Controle Manutenções",
                allowExportSelectedData: false,
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: 'Procure...',
            },
            hoverStateEnabled: true,
            editing: {
                mode: 'popup',
                allowUpdating: true,
                allowAdding: true,
                allowDeleting: true,
                useIcons: true,
                popup: {
                    title: "Nova Ordem de Serviço",
                    showTitle: true,
                    width: '800px',
                    resizeEnabled: true,
                    autoResizeEnabled: true, 
                    maxHeight: '95vh'
                },
                form: {
                    colCount: 2,
                    labelLocation: 'top',
                    items: [
                        { 
                            dataField: 'data_solicitacao', 
                            label: { text: 'Data Solicitação' }, 
                            editorType: 'dxDateBox', 
                            editorOptions: { 
                                type: 'date', 
                                value: new Date() // define a data atual como padrão
                            }, 
                            colSpan: 2 
                        },
                        { dataField: 'data_inicio', label: { text: 'Data Início' }, editorType: 'dxDateBox', editorOptions: { type: 'date' }, colSpan: 1, },
                        {
                            dataField: 'tempo_previsto',
                            editorType: 'dxTextBox',
                            label: { text: 'Tempo Previsto' },
                            colSpan: 1,
                            editorOptions: {
                                mask: "00:00",
                                maskRules: {
                                    "0": /[0-9]/
                                },
                                placeholder: "00:00",
                                useMaskedValue: true
                            },
                            validationRules: [{ type: 'required', message: 'Tempo Previsto é obrigatório' }]
                        },
                        {
                            dataField: 'nome_solicitante',
                            label: { text: 'Nome do Solicitante' },
                            editorType: 'dxSelectBox',
                            colSpan: 2,
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-usuarios-senior-lookup', 'NOME_COLABORADOR', 'NOME_COLABORADOR', 'Selecione o solicitante'),
                            validationRules: [{ type: 'required', message: 'Solicitante é obrigatório' }]
                        },
                        { 
                            dataField: 'setor_id', 
                            label: { text: 'Setor' }, 
                            editorType: 'dxSelectBox', 
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-setores', 'nome', 'id', 'Selecione o setor') 
                        },
                        {
                            dataField: 'prioridade',
                            editorType: 'dxSelectBox',
                            label: { text: 'Prioridade' },
                            editorOptions: {
                                items: ['Baixa', 'Média', 'Alta'],
                                placeholder: 'Selecione a prioridade',
                                width: '100%'
                            },
                            validationRules: [{ type: 'required' }]
                        },
                        // Novo campo: Tipo Ordem Serviço
                        {
                            dataField: 'tipo_ordem_servico',
                            editorType: 'dxSelectBox',
                            label: { text: 'Tipo Ordem de Serviço' },
                            colSpan: 2,
                            editorOptions: {
                                items: ['Equipamento', 'Centro de Custo'],
                                placeholder: 'Selecione o tipo',
                            },
                            validationRules: [{ type: 'required', message: 'Tipo Ordem de Serviço é obrigatório' }]
                        },
                        { 
                            dataField: 'equipamento_id', 
                            label: { text: 'Equipamento' }, 
                            editorType: 'dxSelectBox', 
                            colSpan: 2, 
                            visible: false,
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-equipamentos', 'nome', 'id', 'Selecione o equipamento') 
                        },
                        { 
                            dataField: 'centro_custo_id', 
                            colSpan: 2,
                            editorType: 'dxSelectBox', 
                            label: { text: 'Centro de Custo' }, 
                            visible: false,
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-centro-custo-lookup', 'DSC', 'ID', 'Selecione o centro de custo') },
                        { 
                            dataField: 'tipo_manutencao_id', 
                            label: { text: 'Tipo Manutenção' }, 
                            editorType: 'dxSelectBox', editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/listar-tipos-manutencao', 'nome', 'id', 'Selecione o tipo') 
                        },
                        { 
                            dataField: 'area_tecnica_id', 
                            label: { text: 'Área Técnica' }, 
                            editorType: 'dxSelectBox', 
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-areas', 'nome', 'id', 'Selecione a área técnica') 
                        },
                        { dataField: 'descricao_defeito', label: { text: 'Descrição do Defeito' }, editorType: 'dxTextArea', colSpan: 2, editorOptions: { height: 60 } },
                        { dataField: 'info_servico', label: { text: 'Informações do Serviço Executado' }, editorType: 'dxTextArea', colSpan: 2, editorOptions: { height: 60 } },
                        { dataField: 'observacoes', label: { text: 'Observações Adicionais' }, editorType: 'dxTextArea', colSpan: 2, editorOptions: { height: 60 } },

                    ]
                }
            },
            columns: [
                { 
                    dataField: 'id', 
                    caption: 'OS', 
                    alignment: 'center', 
                    width: 110,
                    calculateDisplayValue: function(rowData) {
                        return String(rowData.id).padStart(5, '0');
                    }
                },
                { dataField: 'data_solicitacao', caption: 'Dt. Solicitação', dataType: 'date', alignment: 'center', width: 110 },
                {
                    dataField: 'data_programada',
                    caption: 'Data Programada',
                    dataType: 'date',
                    alignment: 'center', 
                    visible: false,
                    width: 110,
                },
                { 
                    dataField: 'data_inicio', 
                    caption: 'Dt. Início', 
                    dataType: 'date', 
                    alignment: 'center', 
                    width: 110,
                    sortIndex: 1, 
                    sortOrder: 'asc',
                    calculateSortValue: function (rowData) {
                        return rowData.data_inicio ? new Date(rowData.data_inicio) : new Date(8640000000000000); 
                    }
                },
                { 
                    dataField: 'tempo_previsto', 
                    caption: 'Tempo Previsto', 
                    visible: false
                },
                { 
                    dataField: 'data_final', 
                    caption: 'Dt. Finalização', 
                    dataType: 'date', 
                    alignment: 'center', 
                    width: 110,
                },
                { dataField: 'nome_solicitante', caption: 'Solicitante', visible: false },
                { dataField: 'tipo_ordem_servico', caption: 'Tipo Ordem Serviço', visible: false, width: 200 },
                { dataField: 'equipamento_id', caption: 'Equipamento', width: 300, lookup: { dataSource: new DevExpress.data.CustomStore({ load: () => $.getJSON('/planejamento-controle-manutencao/listar-equipamentos') }), displayExpr: 'dsc_equipamento', valueExpr: 'id' } },
                {
                    dataField: 'centro_custo_id',
                    caption: 'Centro de Custo',
                    width: 200,
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/get-centro-custo-lookup')
                        }),
                        displayExpr: 'DSC',
                        valueExpr: 'ID'
                    }
                },
                { 
                    dataField: 'setor_id', 
                    caption: 'Setor', 
                    lookup: { dataSource: new DevExpress.data.CustomStore({ load: () => $.getJSON('/planejamento-controle-manutencao/listar-setores') }), displayExpr: 'dsc_equipamento', valueExpr: 'id' }, 
                    width: 160
                },
                {
                    dataField: 'tipo_manutencao_id',
                    caption: 'Tipo Manutenção',
                    alignment: 'center',
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/listar-tipos-manutencao')
                        }),
                        displayExpr: 'nome',
                        valueExpr: 'id'
                    }, 
                    width: 'auto'
                },
                {
                    dataField: 'area_tecnica_id',
                    caption: 'Área Técnica',
                    visible: false,
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/listar-areas')
                        }),
                        displayExpr: 'nome',
                        valueExpr: 'id'
                    }
                },
                { dataField: 'descricao_defeito', caption: 'Descrição do Defeito', visible: false },
                { dataField: 'info_servico', caption: 'Informações do Serviço Executado', visible: false },
                { dataField: 'observacoes', caption: 'Observações Adicionais', visible: false },
                { dataField: 'custo_total', caption: 'Custo (R$)', format: { type: 'fixedPoint', precision: 2 }, visible: false },
                { dataField: 'prioridade', caption: 'Prioridade', visible: false },
                {
                    dataField: 'status',
                    caption: 'Status',
                    sortIndex: 0,
                    alignment: 'center',
                    sortOrder: 'asc',
                    calculateSortValue: function(rowData) {
                        // Forçar a ordem: Pendente < Finalizada
                        const order = { 'pendente': 0, 'finalizada': 1 };
                        return order[(rowData.status || '').toLowerCase()] ?? 99;
                    }
                },
                {
                    type: 'buttons',
                    width: 120,
                    alignment: 'center',
                    buttons: [
                        {
                            name: 'edit',
                            visible: function (e) {
                                return e.row.data.status !== 'Finalizada';
                            }
                        },
                        'delete',
                        {
                            hint: "Ordem de Serviço",
                            icon: "doc",
                            // visible: function (e) {
                            //     return e.row.data.status === 'Finalizada';
                            // },
                            onClick: function(e) {
                                const data = e.row.data;
                                openOrdemServicoPopup(data);
                            }
                        },
                        {
                            hint: 'Finalizar OS',
                            icon: 'check',
                            visible: function (e) {
                                return e.row.data.status !== 'Finalizada';
                            },
                            onClick: function (e) {
                                finalizarOS(e.row.data);
                            }
                        },
                    ]
                },
            ],
            onInitNewRow: function(e) {
                e.data.tipo_ordem_servico = '';
                e.data.data_solicitacao = new Date();
                
                setTimeout(() => {
                    const form = $(".dx-popup-content .dx-form").dxForm("instance");
                    if (form) {
                        form.updateData('data_solicitacao', new Date());
                    }
                }, 100);
            },
            onEditingStart: function(e) {
                // Determina o tipo_ordem_servico baseado nos campos preenchidos
                const tipo = e.data.equipamento_id ? 'Equipamento' :
                            e.data.centro_custo_id ? 'Centro de Custo' : null;

                setTimeout(() => {
                    const form = $(".dx-popup-content .dx-form").dxForm("instance");

                    if (form) {
                        // Atualiza o valor diretamente no formData do formulário
                        const formData = form.option('formData');
                        formData.tipo_ordem_servico = tipo;

                        form.option('formData', formData); // força atualização visual

                        atualizarVisibilidadeForm(form);
                    }
                }, 100);
            },
            onEditorPreparing: function(e) {
                // Mantém a lógica original de equipamento_id
                if (e.dataField === 'equipamento_id' || e.dataField === 'centro_custo_id' || e.dataField === 'tipo_ordem_servico') {
                    if (e.row && e.row.isNewRow !== true) {
                        e.editorOptions.readOnly = true;
                        if (e.editorName === 'dxSelectBox') {
                            e.editorOptions.disabled = true;
                        }
                    } else {
                        e.editorOptions.readOnly = false;
                        if (e.editorName === 'dxSelectBox') {
                            e.editorOptions.disabled = false;
                        }
                    }
                }

                // Adicione esta parte para o campo tipo_ordem_servico
                if (e.dataField === 'tipo_ordem_servico' && e.parentType === 'dataRow') {
                    e.editorOptions.onValueChanged = function(args) {
                        // Atualiza o valor da célula corretamente
                        e.setValue(args.value);

                        const form = $(".dx-popup-content .dx-form").dxForm("instance");
                        if (form) {
                            // Atualiza valor no formData
                            form.option('formData.tipo_ordem_servico', args.value);

                            // Atualiza visibilidade e obrigatoriedade
                            atualizarVisibilidadeForm(form);
                        }
                    };
                }
            },
            onRowPrepared: function (e) {
                if (e.rowType === 'data') {
                    const status = (e.data.status || '').toLowerCase();
                    const hoje = new Date();
                    const dataInicio = e.data.data_inicio ? new Date(e.data.data_inicio) : null;
                    const dataFim = e.data.data_fim ? new Date(e.data.data_fim) : null;

                    const emExecucao = dataInicio && dataInicio <= hoje && status !== 'finalizada';

                    if (emExecucao) {
                        e.rowElement.css({ backgroundColor: '#F4A261', color: '#000' }); 
                        return;
                    }

                    switch (status) {
                        case 'finalizada':
                            e.rowElement.css({ backgroundColor: '#D4EDDA', color: '#155724' });
                            break;
                    }
                }
            },
            onRowUpdating: function (e) {
                e.newData = { ...e.oldData, ...e.newData };
            },
            onToolbarPreparing: function (e) {
                // Aqui você pode personalizar ainda mais a barra de ferramentas
                var toolbarItems = e.toolbarOptions.items;

                e.toolbarOptions.items.push({
                    location: "after", // Coloca depois dos outros itens
                    widget: "dxButton",
                    options: {
                        // icon: "refresh", // Ícone do botão (ícone de atualização)
                        onClick: function() {
                            openApontamentosManutencaoPopup();
                        },
                        text: "Apontamentos OS" 
                    }
                });

                // Adicionar os botões de expandir/colapsar
                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-expand",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.expandAll(); // Expande todos os grupos
                        }
                    }
                });

                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-compress",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.collapseAll(); // Colapsa todos os grupos
                        }
                    }
                });

                e.toolbarOptions.items.push({
                    name: "refresh", // Adiciona o botão refresh na toolbar
                    location: "after", // Coloca depois dos outros itens
                    widget: "dxButton",
                    options: {
                        icon: "refresh", // Ícone do botão (ícone de atualização)
                        onClick: function() {
                            // Recarrega os dados da grid
                            e.component.refresh(); // Atualiza a grid
                        },
                        text: "Atualizar" 
                    }
                });
            },             
        });

        function getLookupProdutos() {
            // 1. Carregar produtos ANTES de exibir o popup
            $.getJSON('/planejamento-controle-manutencao/get-produtos-estoque-lookup')
            .done(function (response) {
                if (response.success && response.data.length > 0) {
                    produtosLookup = response.data;
                } else {
                    DevExpress.ui.notify('Nenhum produto encontrado.', 'warning', 3000);
                }
            })
            .fail(function () {
                DevExpress.ui.notify('Erro ao carregar produtos.', 'error', 3000);
            });
        }
        // Função para atualizar a visibilidade dos campos
        function atualizarVisibilidadeForm(form) {
            const tipoOrdemServico = form.option('formData').tipo_ordem_servico;

            console.log('form', form);
            console.log('tipoOrdemServico', tipoOrdemServico);

            
            // Esconde e remove obrigatoriedade de ambos os campos
