    function obterDadosControleManutencao(tipo) {
        $('#globalLoading').show();

        formSelections.tipo = tipo;

        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/planejamento-controle-manutencao/detalhes-cards-controle-manutencao',
                method: 'GET',
                dataType: 'json',
                data: formSelections,
                success: function(response) {
                    if (response.success) {
                        resolve(response.data || []);
                    } else {
                        reject(new Error("Resposta da API não foi bem-sucedida"));
                    }
                },
                error: function(error) {
                    DevExpress.ui.notify("Erro na requisição dos Detalhes", "error", 3000);
                    reject(error);
                },
                complete: function() {
                    $('#globalLoading').hide();
                }
            });
        });
    }
    async function abrirPopup(tipo) {
        try {
            const result = await obterDadosControleManutencao(tipo);

            const processedColumns = result.collumns.map(column => {
                if (column.dataField === 'DETALHES') {
                    return {
                        ...column,
                        cellTemplate: function(container, options) {
                            $('<a>')
                                .addClass('dx-link')
                                .text('Ver')
                                .on('click', function () {
                                    DevExpress.ui.notify('Abrir detalhes não implementado ainda.', 'info', 2000);
                                })
                                .appendTo(container);
                        }
                    };
                }
                return column;
            });

            $("#popup-container").dxPopup({
                width: '80%',
                height: 800,
                showTitle: true,
                title: `Detalhes - ${tipo}`,
                visible: true,
                dragEnabled: true,
                closeOnOutsideClick: true,
                contentTemplate: function () {
                    return $("<div>").dxDataGrid({
                        dataSource: result.dataSource,
                        height: '100%',
                        width: '100%',
                        columnAutoWidth: true,
                        elementAttr: {
                            class: "grid-personalizada"
                        },
                        showBorders: true,
                        columnChooser: {
                            enabled: true,
                            mode: "dragAndDrop",
                        },
                        groupPanel: {
                            visible: true,
                        },
                        editing: {
                            mode: 'batch',
                            allowUpdating: false,
                            allowDeleting: false,
                        },
                        selection: {
                            mode: 'multiple',
                            showCheckBoxesMode: 'none'
                        },
                        hoverStateEnabled: true,
                        pager: {
                            visible: true
                        },
                        paging: {
                            pageSize: 500
                        },
                        headerFilter: {
                            visible: true,
                        },
                        filterRow: {
                            visible: true,
                            applyFilter: 'auto',
                        },
                        export: {
                            enabled: true,
                            fileName: "Detalhes_" + tipo,
                            allowExportSelectedData: false,
                        },
                        searchPanel: {
                            visible: true,
                            width: 240,
                            placeholder: 'Procure...',
                        },
                        columns: processedColumns,
                        onToolbarPreparing: function (e) {
                            const toolbarItems = e.toolbarOptions.items;

                            toolbarItems.push({
                                location: "after",
                                widget: "dxButton",
                                options: {
                                    icon: "fa fa-expand",
                                    text: "Expandir",
                                    onClick: function () {
                                        e.component.expandAll();
                                    }
                                }
                            });

                            toolbarItems.push({
                                location: "after",
                                widget: "dxButton",
                                options: {
                                    icon: "fa fa-compress",
                                    text: "Colapsar",
                                    onClick: function () {
                                        e.component.collapseAll();
                                    }
                                }
                            });
                        }
                    });
                }
            });
        } catch (error) {
            console.error('Erro ao obter dados do detalhe:', error);
        }
    }


