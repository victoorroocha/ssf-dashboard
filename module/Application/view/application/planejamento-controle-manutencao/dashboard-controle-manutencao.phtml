<script>
    // Variáveis globais para armazenar os valores selecionados
    const formSelections = {
        dataInicio: null,
        dataFim: null
    };

    $(document).ready(function() {
        // BTN Exportar PDF - Versão corrigida
        document.getElementById('btnExportPDF').addEventListener('click', async function () {
            const loading = document.getElementById('globalLoading');
            const spinnerGen = document.getElementById('spinnerGeneric');
            const spinnerPDF = document.getElementById('spinnerPDF');
            const loadingText = document.getElementById('loadingText');

            loading.style.display = 'flex';
            spinnerGen.style.display = 'none';
            spinnerPDF.style.display = 'block';
            loadingText.textContent = 'Gerando PDF…';

            try {
                const printArea = document.getElementById('print-area');

                // Detecta o zoom do navegador para compensar a escala
                const zoom = window.devicePixelRatio || 1;
                const scale = 2 / zoom; // seu scale original 2 dividido pelo zoom atual

                const canvas = await html2canvas(printArea, {
                    scale: scale,
                    useCORS: true,
                    logging: true,
                    allowTaint: true,
                    backgroundColor: null,
                    onclone: (clonedDoc) => {
                        const cabecalho = clonedDoc.querySelector('.cabecalho-content');
                        if (cabecalho) {
                            cabecalho.classList.remove('hidden-print');
                            cabecalho.style.backgroundColor = '#006400';
                            cabecalho.style.color = 'white';
                            cabecalho.style.padding = '10px 20px';
                            cabecalho.style.textAlign = 'center';
                        }
                    }
                });

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4');
                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                const margemMm = 30 * 0.264583;

                const imgData = canvas.toDataURL('image/png', 1.0);
                const props = pdf.getImageProperties(imgData);

                const pdfWidth = pageWidth - 2 * margemMm;
                const maxPdfHeight = pageHeight - 2 * margemMm;

                // Ajusta a altura para caber na página, mantendo a proporção
                let pdfHeight = (props.height * pdfWidth) / props.width;
                if (pdfHeight > maxPdfHeight) {
                    pdfHeight = maxPdfHeight;
                }

                pdf.addImage(
                    imgData,
                    'PNG',
                    margemMm,
                    margemMm,
                    pdfWidth,
                    pdfHeight,
                    undefined,
                    'FAST'
                );

                pdf.save('dashboard-controle-manutencao.pdf');
            } catch (err) {
                console.error('Erro ao gerar PDF:', err);
                alert('Erro ao gerar PDF. Verifique o console para detalhes.');
            } finally {
                spinnerPDF.style.display = 'none';
                spinnerGen.style.display = 'block';
                loadingText.textContent = 'Carregando Informações...';
                loading.style.display = 'none';
            }
        });

        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: "raw",
                    load: function() {
                        return $.ajax({
                            url: url,
                            method: "GET",
                            dataType: "json"
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, "error", 3000);
                                return [];
                            }
                        }).catch(error => {
                            DevExpress.ui.notify("Erro ao buscar dados!", "error", 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true,
                onValueChanged: function(e) {
                    atualizarInfosDashboad();
                }
            };
        }

        // Inicializa o Range Selector
        const today = moment();
        const startYear = 2025; // definido para pegar historico de 2023 pra k.
        const startOfMonth = today.clone().startOf('month');  // Primeiro dia do mês atual
        const endOfMonth = today.clone().endOf('month');     // Último dia do mês atual

        // Define valores iniciais nas variáveis globais
        formSelections.dataInicio = moment(startOfMonth.toDate()).format("YYYY-MM-DD"); 
        formSelections.dataFim = moment(endOfMonth.toDate()).format("YYYY-MM-DD");

        const rangeSelectorInstance = $("#range-selector").dxRangeSelector({
            width: '100%',
            scale: {
                startValue: moment(`${startYear}-01-01`).toDate(),
                endValue: today.clone().endOf('year').toDate(),
                minorTickInterval: "month",
                tickInterval: "month",
                useTicks: true,
                label: { format: "MMM yyyy" }
            },
            value: [startOfMonth.toDate(), endOfMonth.toDate()],  // Intervalo: primeiro dia do mês até o último dia
            sliderMarker: { format: "monthAndYear" },
            behavior: { callValueChanged: "onMovingComplete" }, // Alterado para "onMovingComplete"
            applyValueMode: "onHandleRelease",
            onInitialized: function(e) {
                atualizarInfosDashboad();
            },
            onValueChanged: function(e) {
                const startDate = moment(e.value[0]);
                const endDate = moment(e.value[1]).subtract(1, 'days'); // quando faz o changed sempre pega dia 01 do proximo mes ao selecionado. Tratei pra subtrair um dia, pegando o ultimo dia do mes selecionado.

                formSelections.dataInicio = moment(startDate.toDate()).format("YYYY-MM-DD");
                formSelections.dataFim = moment(endDate.toDate()).format("YYYY-MM-DD");
                
                atualizarInfosDashboad();
            }
        }).dxRangeSelector("instance");

    });

    // Função para atualizar informações do dashboard
    function atualizarInfosDashboad() {
        // Mostra o loading
        $('#globalLoading').show();

        const dataInicio = moment(formSelections.dataInicio, 'YYYY-MM-DD');
        const dataFim = moment(formSelections.dataFim, 'YYYY-MM-DD');

        let textoPeriodo = '';

        if (dataInicio.isSame(dataFim, 'month')) {
            textoPeriodo = dataInicio.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase());
        } else {
            textoPeriodo = `${dataInicio.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase())} à ${dataFim.format('MMMM [de] YYYY').replace(/^\w/, c => c.toUpperCase())}`;
        }

        $('#periodo-apuracao').text(textoPeriodo);

        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/planejamento-controle-manutencao/listar-dados-dashboard-controle-manutencao',
                method: 'GET',
                dataType: 'json',
                data: formSelections,
                success: function(response) {
                    if (response.success) {
                        // INICIO CARDS
                            const resumo = response.data.resumoCards;

                            const formatadorMoeda = new Intl.NumberFormat('pt-BR', {
                                style: 'currency',
                                currency: 'BRL',
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });

                            // Atualiza os valores nos cards conforme o índice dos elementos
                            document.querySelector('.card-column:nth-child(1) .indicator-value').textContent = resumo.finalizadas ?? 0;
                            document.querySelector('.card-column:nth-child(2) .indicator-value').textContent = resumo.programadas ?? 0;
                            document.querySelector('.card-column:nth-child(3) .indicator-value').textContent = resumo.pendentes ?? 0;
                            document.querySelector('.card-column:nth-child(4) .indicator-value').textContent = resumo.total ?? 0;
                            document.querySelector('.card-column:nth-child(5) .indicator-value').textContent = formatadorMoeda.format(Number(resumo.custo_total ?? 0));

                        // FIM CARDS

                        // INICIO TIPO MANUTENÇÃO
                            const dadosManutencao = response.data.porTipo ?? [];

                            const paletaVerde = ["#2E7D32", "#66BB6A", "#A5D6A7"];

                            $("#graficoTipoManutencao").dxPieChart({
                                type: "doughnut",
                                palette: paletaVerde,
                                dataSource: dadosManutencao,
                                title: {
                                    text: "Tipos de Manutenção",
                                    font: {
                                        size: 16,
                                        weight: 600,
                                        color: "#1B5E20"
                                    },
                                    horizontalAlignment: "center"
                                },
                                tooltip: {
                                    enabled: true,
                                    customizeTooltip(arg) {
                                        return {
                                            text: `${arg.argumentText}: ${arg.valueText} solicitações`
                                        };
                                    }
                                },
                                legend: {
                                    horizontalAlignment: "center",
                                    verticalAlignment: "bottom",
                                    font: {
                                        size: 12,
                                        color: "#1B5E20"
                                    },
                                    itemTextPosition: "right"
                                },
                                series: [{
                                    argumentField: "tipo",
                                    valueField: "quantidade",
                                    label: {
                                        visible: true,
                                        backgroundColor: "#fff",
                                        font: {
                                            size: 12,
                                            weight: 600,
                                            color: "#1B5E20"
                                        },
                                        connector: {
                                            visible: true
                                        },
                                        customizeText(arg) {
                                            return `${arg.argumentText} (${arg.percentText})`;
                                        }
                                    }
                                }]
                            });
                        // FIM TIPO MANUTENÇÃO

                        // INICIO POR ÁREA DE DEFEITOS
                            const dadosPorArea = response.data.porAreaTecnica ?? [];

                            $("#graficoPorArea").dxChart({
                                dataSource: dadosPorArea,
                                rotated: false,
                                palette: paletaVerde,
                                title: {
                                    text: "Áreas de Defeitos",
                                    font: {
                                        size: 16,
                                        weight: 600,
                                        color: "#1B5E20"
                                    },
                                    horizontalAlignment: "center"
                                },
                                tooltip: {
                                    enabled: true,
                                    customizeTooltip(arg) {
                                        return {
                                            text: `${arg.argumentText}: ${arg.valueText} solicitações`
                                        };
                                    }
                                },
                                legend: {
                                    visible: false
                                },
                                commonSeriesSettings: {
                                    type: "bar",
                                    barPadding: 0.1,
                                    barWidth: 40,
                                    label: {
                                        visible: true,
                                        backgroundColor: "#fff",
                                        font: {
                                            size: 12,
                                            weight: 600,
                                            color: "#1B5E20"
                                        },
                                        position: "outside"
                                    }
                                },
                                series: [{
                                    argumentField: "area",
                                    valueField: "quantidade",
                                    name: "Solicitações"
                                }],
                                valueAxis: {
                                    title: {
                                        text: "Quantidade",
                                        font: { color: "#1B5E20" }
                                    },
                                    grid: { visible: false },
                                    label: {
                                        font: { color: "#1B5E20" }
                                    }
                                },
                                argumentAxis: {
                                    title: {
                                        text: "Área Técnica",
                                        font: { color: "#1B5E20" }
                                    },
                                    grid: { visible: false },
                                    label: {
                                        font: { color: "#1B5E20" }
                                    }
                                },
                                size: {
                                    height: 350
                                }
                            });
                        // FIM POR ÁREA DE DEFEITOS

                        // INICIO POR EQUIPAMENTO
                            const dadosPorEquipamento = response.data.porEquipamento ?? [];

                            const equipamentosMap = {};

                            dadosPorEquipamento.forEach(({ equipamento, tipo, quantidade }) => {
                                // Corrige nome "Corrretiva" para "Corretiva" (se for erro de digitação)
                                const tipoCorrigido = tipo === "Corrretiva" ? "Corretiva" : tipo;

                                if (!equipamentosMap[equipamento]) {
                                    equipamentosMap[equipamento] = {
                                        equipamento,
                                        Corretiva: 0,
                                        Preventiva: 0,
                                        Preditiva: 0
                                    };
                                }
                                equipamentosMap[equipamento][tipoCorrigido] = quantidade;
                            });

                            const equipamentosArray = Object.values(equipamentosMap);

                            // Ordena do maior para o menor total de solicitações (soma dos tipos)
                            equipamentosArray.sort((a, b) => (
                                (b.Corretiva + b.Preventiva + b.Preditiva) -
                                (a.Corretiva + a.Preventiva + a.Preditiva)
                            ));

                            // Pega os top 10 equipamentos com mais solicitações
