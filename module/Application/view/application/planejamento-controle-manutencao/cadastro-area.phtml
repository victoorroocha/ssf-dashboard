<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Planejamento e Controle da Manutenção</h1>
    </div>

    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Cadastro Áreas Técnicas</p>

                    <div id="gridAreas"></div>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- /.container-fluid -->

<script>
    $(document).ready(function() {
        let areasGrid = $('#gridAreas').dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: 'id',
                load: function() {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/listar-areas',
                        method: 'GET',
                        dataType: 'json'
                    }).then(response => {
                        if (response.success) {
                            return {
                                data: response.data,
                                totalCount: response.totalCount || response.data.length
                            };
                        } else {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                            return { data: [], totalCount: 0 };
                        }
                    }).catch(error => {
                        if (error.responseJSON && error.responseJSON.message) {
                            DevExpress.ui.notify(error.responseJSON.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify('Erro ao carregar áreas técnicas!', 'error', 3000);
                        }
                        return { data: [], totalCount: 0 };
                    });
                },
                insert: function(values) {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/salvar-area',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(values),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Área técnica salva com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(error => {
                        if (error.responseJSON && error.responseJSON.message) {
                            DevExpress.ui.notify(error.responseJSON.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify('Erro ao salvar área técnica!', 'error', 3000);
                        }
                        return {};
                    });
                },
                update: function(key, values) {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/salvar-area',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key, ...values }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Área técnica atualizada com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(error => {
                        if (error.responseJSON && error.responseJSON.message) {
                            DevExpress.ui.notify(error.responseJSON.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify('Erro ao atualizar área técnica!', 'error', 3000);
                        }
                        return {};
                    });
                },
                remove: function(key) {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/excluir-area',
                        method: 'DELETE',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Área técnica excluída com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(error => {
                        if (error.responseJSON && error.responseJSON.message) {
                            DevExpress.ui.notify(error.responseJSON.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify('Erro ao excluir área técnica!', 'error', 3000);
                        }
                        return {};
                    });
                }
            }),
            keyExpr: 'id',
            width: '100%',
            columnAutoWidth: true,
            showBorders: true,
            hoverStateEnabled: true,
            paging: {
                pageSize: 20
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [10, 20, 50],
                showInfo: true
            },
            filterRow: {
                visible: true,
                applyFilter: 'auto'
            },
            headerFilter: {
                visible: true
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: 'Pesquisar...'
            },
            grouping: {
                autoExpandAll: false
            },
            groupPanel: {
                visible: false,
                emptyPanelText: 'Arraste uma coluna aqui para agrupar'
            },
            export: {
                enabled: true,
                fileName: 'Áreas Técnicas',
                allowExportSelectedData: false
            },
            toolbar: {
                items: [
                    'groupPanel',
                    'searchPanel',
                    {
                        widget: 'dxButton',
                        location: 'after',
                        options: {
                            icon: 'refresh',
                            hint: 'Atualizar',
                            onClick: function () {
                                $('#gridAreas').dxDataGrid('instance').refresh();
                            }
                        }
                    },
                    {
                        widget: 'dxButton',
                        location: 'after',
                        options: {
                            icon: 'plus',
                            hint: 'Adicionar Área',
                            onClick: function () {
                                $('#gridAreas').dxDataGrid('instance').addRow();
                            }
                        }
                    }
                ]
            },
            editing: {
                mode: 'popup',
                allowUpdating: true,
                allowAdding: true,
                allowDeleting: false,
                useIcons: true,
                popup: {
                    title: 'Área Técnica',
                    showTitle: true,
                    width: 450,
                    height: 'auto',
                    position: {
                        my: 'center',
                        at: 'center',
                        of: window
                    }
                },
                form: {
                    colCount: 1, 
                    labelLocation: 'top',
                    items: [
                        {
                            dataField: 'nome',
                            editorType: 'dxTextBox',
                            label: { text: 'Área Técnica' },
                            editorOptions: {
                                width: '100%'
                            },
                            validationRules: [
                                { type: 'required', message: 'Nome é obrigatório' }
                            ]
                        },
                        {
                            dataField: 'descricao',
                            editorType: 'dxTextArea',
                            label: { text: 'Descrição' },
                            editorOptions: {
                                height: 100,
                                width: '100%'
                            }
                        },
                        {
                            dataField: 'flg_ativo',
                            editorType: 'dxSwitch',
                            label: { text: 'Ativo?' },
                            editorOptions: {
                                switchedOnText: 'Sim',
                                switchedOffText: 'Não'
                            }
                        }
                    ]
                },
                texts: {
                    confirmDeleteMessage: 'Tem certeza que deseja excluir esta área? Esta ação não pode ser desfeita.'
                }
            },
            columns: [
                {
                    dataField: 'nome',
                    caption: 'Área Técnica',
                    validationRules: [{ type: 'required', message: 'Área Técnica é obrigatório' }]
                },
                {
                    dataField: 'descricao',
                    caption: 'Descrição',
                },
                {
                    dataField: 'flg_ativo',
                    caption: 'Ativo?',
                    dataType: 'boolean',
                    alignment: 'center',
                    width: 120
                },
            ],
            onInitNewRow: function(e) {
                e.data.flg_ativo = true;
            },
            onRowUpdating: function(e) {
                e.newData = { ...e.oldData, ...e.newData };
            }
        });

    });
</script>
