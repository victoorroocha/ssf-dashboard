
<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Planejamento e Controle da Manutenção</h1>
    </div>

    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Programação das Manutenções Preventivas</p>

                    <div id="gridProgramacaoPreventiva"></div>
                    <div id="popupAprovacao"></div>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- /.container-fluid -->

<script>
    $(document).ready(function () {
        let aprovacaoPopup; // variavel global do popup

        let programacaoGrid = $('#gridProgramacaoPreventiva').dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: 'id',
                load: function () {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/listar-programacao-preventiva',
                        method: 'GET',
                        dataType: 'json'
                    }).then(response => {
                        if (response.success) {
                            return {
                                data: response.data,
                                totalCount: response.totalCount || response.data.length
                            };
                        } else {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                            return { data: [], totalCount: 0 };
                        }
                    }).catch(error => {
                        DevExpress.ui.notify('Erro ao carregar programações!', 'error', 3000);
                        return { data: [], totalCount: 0 };
                    });
                },
                insert: function (values) {
                    // salvar programação preventiva
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/salvar-programacao-preventiva',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(values),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Programação salva com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao salvar programação!', 'error', 3000);
                        return {};
                    });
                },
                update: function (key, values) {
                    // atualizar programação preventiva
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/salvar-programacao-preventiva',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key, ...values }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Programação atualizada com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao atualizar programação!', 'error', 3000);
                        return {};
                    });
                },
                remove: function (key) {
                    // excluir programação preventiva
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/excluir-programacao-preventiva',
                        method: 'DELETE',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Programação excluída com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao excluir programação!', 'error', 3000);
                        return {};
                    });
                }
            }),
            keyExpr: 'id',
            columnAutoWidth: true,
            width: '100%',
            height: 600,
            showBorders: true,
            columnChooser: {
                enabled: true,
                mode: "dragAndDrop", // or "select"
                position: { 
                    my: "right", 
                    at: "right", 
                    of: ".dx-datagrid-column-chooser-button" 
                }
            },
            groupPanel: {
                visible: true,
            },
            toolbar: {
                items: [
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-expand", // ícone para expandir
                            text: "",
                            onClick: function () {
                                var grid = $("#gridProgramacaoPreventiva").dxDataGrid("instance");
                                grid.expandAll(); // Expande todos os grupos
                            }
                        }
                    },
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-compress", // ícone para colapsar
                            text: "",
                            onClick: function () {
                                var grid = $("#gridProgramacaoPreventiva").dxDataGrid("instance");
                                grid.collapseAll(); // Colapsa todos os grupos
                            }
                        }
                    },
                    {
                        name: "refresh", // Define o nome do botão
                        location: "after", // Coloca o botão após os outros itens na toolbar
                        widget: "dxButton",
                        options: {
                            icon: "refresh", // Ícone de refresh
                            onClick: function() {
                                // Lógica para atualizar/recarregar os dados da grid
                                $("#gridProgramacaoPreventiva").dxDataGrid("instance").refresh(); // Atualiza a grid
                            },
                            text: "Atualizar" // Texto exibido no botão
                        }
                    }
                ]
            },
            pager: {
                visible: true
            },
            paging: {
                pageSize: 500
            },
            headerFilter: {
                visible: true,
            },
            filterRow: {
                visible: true,
                applyFilter: 'auto',
            },
            export: {
                enabled: true,
                fileName: "Programações Manutenção Preventivas",
                allowExportSelectedData: false,
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: 'Procure...',
            },
            hoverStateEnabled: true,
            editing: {
                mode: 'popup',
                allowUpdating: true,
                allowAdding: true,
                allowDeleting: true,
                useIcons: true,
                popup: {
                    title: 'Cadastro de Programação Preventiva',
                    showTitle: true,
                    width: 600,
                    height: 'auto',
                    position: { my: 'center', at: 'center', of: window }
                },
                form: {
                    colCount: 2,
                    labelLocation: 'top',
                    items: [
                        {
                            dataField: 'equipamento_id',
                            label: { text: 'Equipamento' },
                            editorType: 'dxSelectBox',
                            colSpan: 2,
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-equipamentos', 'nome', 'id', 'Selecione o equipamento'),
                            validationRules: [{ type: 'required', message: 'Equipamento é obrigatório' }]
                        },
                        {
                            dataField: 'area_tecnica_id',
                            label: { text: 'Área Técnica' },
                            editorType: 'dxSelectBox',
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-areas', 'nome', 'id', 'Selecione a área técnica'),
                            validationRules: [{ type: 'required', message: 'Área Técnica é obrigatória' }]
                        },
                        {
                            dataField: 'setor_id',
                            label: { text: 'Setor' },
                            editorType: 'dxSelectBox',
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-setores', 'nome', 'id', 'Selecione o setor'),
                            validationRules: [{ type: 'required', message: 'Setor é obrigatório' }]
                        },
                        {
                            dataField: 'data_programada',
                            editorType: 'dxDateBox',
                            label: { text: 'Data Programada' },
                            colSpan: 2,
                            editorOptions: { type: 'date', min: new Date() },
                            validationRules: [{ type: 'required', message: 'Data programada é obrigatória' }]
                        },
                        {
                            dataField: 'descricao_servico',
                            colSpan: 2,
                            editorType: 'dxTextArea',
                            label: { text: 'Descrição do Serviço' },
                            editorOptions: { height: 100, width: '100%' },
                            validationRules: [{ type: 'required', message: 'Descrição do serviço é obrigatória' }]
                        }
                    ]
                },
                texts: {
                    confirmDeleteMessage: 'Deseja excluir esta programação?'
                }
            },
            columns: [
                {
                    dataField: 'equipamento_id',
                    caption: 'Equipamento',
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/listar-equipamentos')
                        }),
                        displayExpr: 'nome',
                        valueExpr: 'id'
                    }
                },
                {
                    dataField: 'area_tecnica_id',
                    caption: 'Área Técnica',
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/listar-areas')
                        }),
                        displayExpr: 'nome',
                        valueExpr: 'id'
                    }
                },
                {
                    dataField: 'setor_id',
                    caption: 'Setor',
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/listar-setores')
                        }),
                        displayExpr: 'nome',
                        valueExpr: 'id'
                    }
                },
                {
                    dataField: 'data_programada',
                    caption: 'Data Programada',
                    dataType: 'date',
                    sortIndex: 1, 
                    sortOrder: 'asc'
                },
                { dataField: 'descricao_servico', caption: 'Descrição', width: 300 },
                {
                    dataField: 'status',
                    caption: 'Status',
                    sortIndex: 0, 
                    sortOrder: 'asc',
                    calculateSortValue: function(rowData) {
                        // Forçar a ordem: Programada < Pendente < Finalizada
                        const order = { 'programada': 0, 'pendente': 1, 'finalizada': 2 };
                        return order[(rowData.status || '').toLowerCase()] ?? 99;
                    }
                },

                // Botões de ação na última coluna
                {
                    type: 'buttons',
                    width: 120,
                    buttons: [
                        'edit',
                        {
                            hint: 'Aprovar Programação',
                            icon: 'check',
                            visible: function (e) {
                                return e.row.data.status === 'Programada';
                            },
                            onClick: function (e) {
                                openAprovacaoPopup(e.row.data);
                            }
                        },
                        {
                            hint: 'Reprovar Programação',
                            icon: 'close',  // ou algum ícone que queira
                            visible: function (e) {
                                return e.row.data.status === 'Programada';
                            },
                            onClick: function (e) {
                                reprovarProgramacao(e.row.data);
                            }
                        }
                    ]
                }
            ],
            onRowUpdating: function (e) {
                e.newData = { ...e.oldData, ...e.newData };
            },
            onRowPrepared: function (e) {
                if (e.rowType === 'data') {
                    const status = (e.data.status || '').toLowerCase();

                    switch (status) {
                        case 'pendente':
                            e.rowElement.css({ backgroundColor: '#FFF3CD', color: '#856404' });
                            break;
                        case 'programada':
                            e.rowElement.css({ backgroundColor: '#D1ECF1', color: '#0C5460' });
                            break;
                        case 'finalizada':
                            e.rowElement.css({ backgroundColor: '#D4EDDA', color: '#155724' });
                            break;
                    }
                }
            },
            onToolbarPreparing: function (e) {
                // Aqui você pode personalizar ainda mais a barra de ferramentas
                var toolbarItems = e.toolbarOptions.items;
                // Adicionar os botões de expandir/colapsar
                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-expand",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.expandAll(); // Expande todos os grupos
                        }
                    }
                });

                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-compress",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.collapseAll(); // Colapsa todos os grupos
                        }
                    }
                });

                e.toolbarOptions.items.push({
                    name: "refresh", // Adiciona o botão refresh na toolbar
                    location: "after", // Coloca depois dos outros itens
                    widget: "dxButton",
                    options: {
                        icon: "refresh", // Ícone do botão (ícone de atualização)
                        onClick: function() {
                            // Recarrega os dados da grid
                            e.component.refresh(); // Atualiza a grid
                        },
                        text: "Atualizar" 
                    }
                });
            },   
        });

        // Função para abrir o popup de aprovação, passando os dados da programação
        function openAprovacaoPopup(data) {
            if (!aprovacaoPopup) {
                aprovacaoPopup = $('#popupAprovacao').dxPopup({
                    width: 600,
                    height: 'auto',
                    title: 'Aprovar Programação Preventiva',
                    visible: false,
                    showTitle: true,
                    dragEnabled: true,
                    closeOnOutsideClick: false,
                    onInitialized: function(e) {
                        // Criar o formulário uma única vez aqui
                        const contentElement = e.component.content();
                        const formElement = $('<div>').attr('id', 'formAprovacao');
                        contentElement.append(formElement);

                        formElement.dxForm({
                            formData: {}, // vazio inicial, vai atualizar no onShowing
                            labelLocation: 'top',
                            showColonAfterLabel: false,
                            minColWidth: 300,
                            colCount: 2,
                            items: [
                                {
                                    dataField: 'data_solicitacao',
                                    editorType: 'dxDateBox',
                                    label: { text: 'Data da Solicitação' },
                                    colSpan: 2,
                                    editorOptions: { width: '100%', readOnly: true, },
                                    validationRules: [{ type: 'required' }]
                                },
                                {
                                    dataField: 'data_inicio',
                                    editorType: 'dxDateBox',
                                    label: { text: 'Data Início' },
                                    colSpan: 2,
                                    editorOptions: { width: '100%' },
                                    validationRules: [
                                        { type: 'required' }
                                    ]
                                },
                                {
                                    dataField: 'nome_solicitante',
                                    label: { text: 'Nome do Solicitante' },
                                    editorType: 'dxSelectBox',
                                    colSpan: 2,
                                    editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-usuarios-senior-lookup', 'NOME_COLABORADOR', 'NOME_COLABORADOR', 'Selecione o solicitante'),
                                    validationRules: [{ type: 'required', message: 'Solicitante é obrigatório' }]
                                },
                                {
                                    dataField: 'prioridade',
                                    editorType: 'dxSelectBox',
                                    label: { text: 'Prioridade' },
                                    colSpan: 1,
                                    editorOptions: {
                                        items: ['Baixa', 'Média', 'Alta'],
                                        placeholder: 'Selecione a prioridade',
                                        width: '100%'
                                    },
                                    validationRules: [{ type: 'required' }]
                                },
                                { 
                                    dataField: 'tipo_manutencao_id', 
                                    label: { text: 'Tipo Manutenção' }, 
                                    colSpan: 1,
                                    editorType: 'dxSelectBox', 
                                    editorOptions: {
                                        ...getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-tipos-manutencao', 'nome', 'id', 'Selecione o tipo'),
                                        readOnly: true
                                    }
                                },
                                {
                                    dataField: 'tecnico_id',
                                    editorType: 'dxSelectBox',
                                    label: { text: 'Técnico' },
                                    colSpan: 2,
                                    editorOptions: {
                                        dataSource: new DevExpress.data.CustomStore({
                                            load: () => $.getJSON('/planejamento-controle-manutencao/listar-tecnicos')
                                        }),
                                        displayExpr: 'nome',
                                        valueExpr: 'id',
                                        placeholder: 'Selecione o técnico',
                                        width: '100%'
                                    },
                                    validationRules: [{ type: 'required' }]
                                },
                                {
                                    dataField: 'descricao_defeito',
                                    editorType: 'dxTextArea',
                                    label: { text: 'Descrição do Defeito' },
                                    colSpan: 2,
                                    editorOptions: { height: 80, width: '100%' },
                                    validationRules: [{ type: 'required' }]
                                },
                                {
                                    itemType: 'button',
                                    colSpan: 2,
                                    horizontalAlignment: 'right',
                                    buttonOptions: {
                                        text: 'Aprovar',
                                        type: 'success',
                                        useSubmitBehavior: true,
                                        onClick: function () {
                                            const formInstance = $('#formAprovacao').dxForm('instance');
                                            if (!formInstance.validate().isValid) {
                                                DevExpress.ui.notify('Preencha os campos obrigatórios', 'error', 3000);
                                                return;
                                            }

                                            const formData = formInstance.option('formData');
                                            const dadosEnvio = {
                                                equipamento_id: data.equipamento_id,
                                                area_tecnica_id: data.area_tecnica_id,
                                                setor_id: data.setor_id,
                                                data_programada: data.data_programada,
                                                descricao_servico: data.descricao_servico,
                                                status: 'Programada',
                                                ...formData
                                            };

                                            $.ajax({
                                                url: '/planejamento-controle-manutencao/aprovar-programacao-preventiva',
                                                method: 'POST',
                                                contentType: 'application/json',
                                                data: JSON.stringify(dadosEnvio),
                                                dataType: 'json'
                                            }).done(function (response) {
                                                if (response.success) {
                                                    DevExpress.ui.notify(response.message || 'Programação aprovada com sucesso!', 'success', 3000);
                                                    aprovacaoPopup.hide();
                                                    $('#gridProgramacaoPreventiva').dxDataGrid('instance').refresh();
                                                } else {
                                                    DevExpress.ui.notify(response.message || 'Erro ao aprovar programação!', 'error', 3000);
                                                }
                                            }).fail(function () {
                                                DevExpress.ui.notify('Erro ao aprovar programação!', 'error', 3000);
                                            });
                                        }
                                    }
                                }
                            ]
                        });
                    },
                    onShowing: function () {
                        const formInstance = $('#formAprovacao').dxForm('instance');

                        // Carregar tipos de manutenção e buscar a opção "Preventiva"
                        $.getJSON('/planejamento-controle-manutencao/get-lookup-tipos-manutencao')
                            .done(function (tipos) {
                                const preventiva = tipos.data.find(item => item.nome.toLowerCase() === 'preventiva');
                                const tipoId = preventiva ? preventiva.id : null;

                                formInstance.option('formData', {
                                    equipamento_id: data.equipamento_id,
                                    area_tecnica_id: data.area_tecnica_id,
                                    setor_id: data.setor_id,
                                    data_programada: data.data_programada,
                                    descricao_servico: data.descricao_servico,
                                    status: data.status,
                                    data_solicitacao: new Date(),
                                    data_inicio: null,
                                    tipo_manutencao_id: tipoId
                                });
                            })
                            .fail(function () {
                                DevExpress.ui.notify('Erro ao carregar tipos de manutenção', 'error', 3000);
                            });
                    }
                }).dxPopup('instance');
            }

            aprovacaoPopup.show();
        }
        function reprovarProgramacao(data) {
            DevExpress.ui.dialog.confirm("Deseja realmente reprovar esta programação Preventiva?", "Confirmação")
                .done(function (result) {
                    if (result) {
                        $.ajax({
                            url: '/planejamento-controle-manutencao/reprovar-programacao-preventiva',
                            method: 'POST', // ou PUT conforme sua API
                            contentType: 'application/json',
                            data: JSON.stringify({ id: data.id, status: 'Reprovada' }),
                            dataType: 'json'
                        }).done(function (response) {
                            if (response.success) {
                                DevExpress.ui.notify(response.message || 'Programação reprovada com sucesso!', 'success', 3000);
                                $('#gridProgramacaoPreventiva').dxDataGrid('instance').refresh();
                            } else {
                                DevExpress.ui.notify(response.message || 'Erro ao reprovar programação!', 'error', 3000);
                            }
                        }).fail(function () {
                            DevExpress.ui.notify('Erro na comunicação com o servidor!', 'error', 3000);
                        });
                    }
                });
        }

        // Função para SelectBox usada no editor de área técnica
        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: 'raw',
                    load: function () {
                        return $.ajax({
                            url: url,
                            method: 'GET',
                            dataType: 'json'
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, 'error', 3000);
                                return [];
                            }
                        }).catch(() => {
                            DevExpress.ui.notify('Erro ao buscar dados!', 'error', 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true,
                onInitialized: function(e) {
                    const val = e.component.option('value');
                    e.component.option('value', val);
                }
            };
        }
    });
</script>
