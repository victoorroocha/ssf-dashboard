
<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Planejamento e Controle da Manutenção</h1>
    </div>

    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Programação das Manutenções Preventivas</p>

                    <div id="gridProgramacaoPreventiva"></div>
                    <div id="popupCancelarProgramacao"></div>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- /.container-fluid -->

<script>
    $(document).ready(function () {
        let aprovacaoPopup; // variavel global do popup

        let programacaoGrid = $('#gridProgramacaoPreventiva').dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: 'id',
                load: function () {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/listar-programacao-preventiva',
                        method: 'GET',
                        dataType: 'json'
                    }).then(response => {
                        if (response.success) {
                            return {
                                data: response.data,
                                totalCount: response.totalCount || response.data.length
                            };
                        } else {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                            return { data: [], totalCount: 0 };
                        }
                    }).catch(error => {
                        DevExpress.ui.notify('Erro ao carregar programações!', 'error', 3000);
                        return { data: [], totalCount: 0 };
                    });
                },
                insert: function (values) {
                    // salvar programação preventiva
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/salvar-programacao-preventiva',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(values),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Programação salva com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao salvar programação!', 'error', 3000);
                        return {};
                    });
                },
                update: function (key, values) {
                    // atualizar programação preventiva
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/salvar-programacao-preventiva',
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: key, ...values }),
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                        } else {
                            DevExpress.ui.notify(response.message || 'Programação atualizada com sucesso!', 'success', 2000);
                        }
                        return response;
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao atualizar programação!', 'error', 3000);
                        return {};
                    });
                },
            }),
            keyExpr: 'id',
            columnAutoWidth: true,
            width: '100%',
            height: 600,
            showBorders: true,
            columnChooser: {
                enabled: true,
                mode: "dragAndDrop", // or "select"
                position: { 
                    my: "right", 
                    at: "right", 
                    of: ".dx-datagrid-column-chooser-button" 
                }
            },
            groupPanel: {
                visible: true,
            },
            toolbar: {
                items: [
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-expand", // ícone para expandir
                            text: "",
                            onClick: function () {
                                var grid = $("#gridProgramacaoPreventiva").dxDataGrid("instance");
                                grid.expandAll(); // Expande todos os grupos
                            }
                        }
                    },
                    {
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "fa fa-compress", // ícone para colapsar
                            text: "",
                            onClick: function () {
                                var grid = $("#gridProgramacaoPreventiva").dxDataGrid("instance");
                                grid.collapseAll(); // Colapsa todos os grupos
                            }
                        }
                    },
                    {
                        name: "refresh", // Define o nome do botão
                        location: "after", // Coloca o botão após os outros itens na toolbar
                        widget: "dxButton",
                        options: {
                            icon: "refresh", // Ícone de refresh
                            onClick: function() {
                                // Lógica para atualizar/recarregar os dados da grid
                                $("#gridProgramacaoPreventiva").dxDataGrid("instance").refresh(); // Atualiza a grid
                            },
                            text: "Atualizar" // Texto exibido no botão
                        }
                    }
                ]
            },
            pager: {
                visible: true
            },
            paging: {
                pageSize: 500
            },
            headerFilter: {
                visible: true,
            },
            filterRow: {
                visible: true,
                applyFilter: 'auto',
            },
            export: {
                enabled: true,
                fileName: "Programações Manutenção Preventivas",
                allowExportSelectedData: false,
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: 'Procure...',
            },
            hoverStateEnabled: true,
            editing: {
                mode: 'popup',
                allowUpdating: true,
                allowAdding: true,
                allowDeleting: false,
                useIcons: true,
                popup: {
                    title: 'Cadastro de Programação Preventiva',
                    showTitle: true,
                    width: 600,
                    height: 'auto',
                    position: { my: 'center', at: 'center', of: window }
                },
                form: {
                    colCount: 3,
                    labelLocation: 'top',
                    items: [
                        {
                            dataField: 'tipo_ordem_servico',
                            editorType: 'dxSelectBox',
                            label: { text: 'Tipo Ordem de Serviço' },
                            colSpan: 3,
                            editorOptions: {
                                items: ['Equipamento', 'Centro de Custo'],
                                placeholder: 'Selecione o tipo',
                            },
                            validationRules: [{ type: 'required', message: 'Tipo Ordem de Serviço é obrigatório' }]
                        },
                        { 
                            dataField: 'equipamento_id', 
                            label: { text: 'Equipamento' }, 
                            editorType: 'dxSelectBox', 
                            colSpan: 3, 
                            visible: false,
                            editorOptions: {
                                dataSource: new DevExpress.data.DataSource({
                                    store: new DevExpress.data.CustomStore({
                                        key: 'id',
                                        load: function(loadOptions) {
                                            const deferred = $.Deferred();
                                            const searchValue = (loadOptions.searchValue || '').toUpperCase();
                                            const skip = loadOptions.skip || 0;
                                            const take = loadOptions.take || 30;
                                            
                                            return $.ajax({
                                                url: '/planejamento-controle-manutencao/get-lookup-equipamentos',
                                                dataType: 'json',
                                                data: { 
                                                    search: searchValue,
                                                    offset: skip,
                                                    limit: take
                                                }
                                            }).then(result => {
                                                const data = result.data || result;
                                                return {
                                                    data: data,
                                                    totalCount: result.totalCount || 1000 // Número estimado ou real
                                                };
                                            }).catch(() => {
                                                return { data: [], totalCount: 0 };
                                            });
                                        },
                                        byKey: function(key) {
                                            return $.ajax({
                                                url: '/planejamento-controle-manutencao/get-lookup-equipamentos', // Nova rota específica
                                                dataType: 'json',
                                                data: { key: key } // Envia como parâmetro GET
                                            }).then(result => result.data || result);
                                        }
                                    }),
                                    paginate: true,
                                    pageSize: 30 // Tamanho padrão da página
                                }),
                                valueExpr: 'id',
                                searchEnabled: true,
                                searchExpr: ['codigo', 'nome', 'setor_nome', 'centro_custo'],
                                searchTimeout: 500,
                                minSearchLength: 0,
                                itemTemplate: function(data) {
                                    return `
                                        <div class="equipamento-template">
                                            <div class="equipamento-header">
                                                <strong>${data.codigo || 'Sem código'}</strong> - ${data.nome || 'Sem nome'}
                                            </div>
                                            <div class="equipamento-details">
                                                <div><small><strong>Setor:</strong> ${data.setor_nome || 'Não informada'}</small></div>
                                                <div><small><strong>Centro de Custo:</strong> ${data.centro_custo || 'Não informado'}</small></div>
                                                <div><small><strong>Status:</strong> ${data.status || 'Não informado'}</small></div>
                                                <div><small><strong>Observação:</strong> ${data.observacoes || 'Nenhuma'}</small></div>
                                            </div>
                                        </div>
                                    `;
                                },
                                displayExpr: function(item) {
                                    return item ? `${item.codigo} - ${item.nome}` : '';
                                },
                                placeholder: 'Digite para buscar...',
                                showClearButton: true,
                                showDataBeforeSearch: true
                            } 
                        },
                        { 
                            dataField: 'centro_custo_id', 
                            colSpan: 3,
                            editorType: 'dxSelectBox', 
                            label: { text: 'Centro de Custo' }, 
                            visible: false,
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-centro-custo-lookup', 'DSC', 'ID', 'Selecione o centro de custo') 
                        },
                        {
                            dataField: 'nome_solicitante',
                            label: { text: 'Nome do Solicitante' },
                            editorType: 'dxSelectBox',
                            colSpan: 3,
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-usuarios-senior-lookup', 'NOME_COLABORADOR', 'NOME_COLABORADOR', 'Selecione o solicitante'),
                            validationRules: [{ type: 'required', message: 'Solicitante é obrigatório' }]
                        },
                        {
                            dataField: 'area_tecnica_id',
                            label: { text: 'Área Técnica' },
                            editorType: 'dxSelectBox',
                            colSpan: 3,
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-areas', 'nome', 'id', 'Selecione a área técnica'),
                            validationRules: [{ type: 'required', message: 'Área Técnica é obrigatória' }]
                        },
                        {
                            dataField: 'setor_id',
                            label: { text: 'Setor' },
                            editorType: 'dxSelectBox',
                            colSpan: 3,
                            editorOptions: getSelectBoxOptions('/planejamento-controle-manutencao/get-lookup-setores', 'nome', 'id', 'Selecione o setor'),
                            validationRules: [{ type: 'required', message: 'Setor é obrigatório' }]
                        },
                        {
                            dataField: 'data_programada',
                            editorType: 'dxDateBox',
                            label: { text: 'Data Programada' },
                            colSpan: 1,
                            editorOptions: { type: 'date', min: new Date() },
                            validationRules: [{ type: 'required', message: 'Data programada é obrigatória' }]
                        },
                        {
                            dataField: 'periodicidade_dias',
                            label: { text: 'Periodicidade (dias)' },
                            editorType: 'dxNumberBox',
                            colSpan: 1,
                            editorOptions: { min: 1, showSpinButtons: true },
                            validationRules: [{ type: 'required', message: 'Periodicidade é obrigatória' }]
                        },
                        {
                            dataField: 'dias_aviso',
                            label: { text: 'Dias Aviso' },
                            editorType: 'dxNumberBox',
                            colSpan: 1,
                            editorOptions: { min: 1, showSpinButtons: true },
                            // validationRules: [{ type: 'required', message: 'Periodicidade é obrigatória' }]
                        },
                        { dataField: 'info_servico', label: { text: 'Check-List' }, editorType: 'dxTextArea', colSpan: 3, editorOptions: { height: 60 } },
                        { dataField: 'observacoes', label: { text: 'Observações Adicionais' }, editorType: 'dxTextArea', colSpan: 3, editorOptions: { height: 60 } },
                    ]
                },
                texts: {
                    confirmDeleteMessage: 'Deseja excluir esta programação?'
                }
            },
            columns: [
                { dataField: 'tipo_ordem_servico', caption: 'Tipo Ordem Serviço', visible: false, width: 200 },
                { dataField: 'equipamento_id', caption: 'Equipamento', width: 300, lookup: { dataSource: new DevExpress.data.CustomStore({ load: () => $.getJSON('/planejamento-controle-manutencao/listar-equipamentos') }), displayExpr: 'dsc_equipamento', valueExpr: 'id' } },
                {
                    dataField: 'centro_custo_id',
                    caption: 'Centro de Custo',
                    width: 200,
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/get-centro-custo-lookup')
                        }),
                        displayExpr: 'DSC',
                        valueExpr: 'ID'
                    }
                },
                { dataField: 'nome_solicitante', caption: 'Solicitante', visible: false },
                {
                    dataField: 'area_tecnica_id',
                    caption: 'Área Técnica',
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/listar-areas')
                        }),
                        displayExpr: 'nome',
                        valueExpr: 'id'
                    }
                },
                {
                    dataField: 'setor_id',
                    caption: 'Setor',
                    lookup: {
                        dataSource: new DevExpress.data.CustomStore({
                            load: () => $.getJSON('/planejamento-controle-manutencao/listar-setores')
                        }),
                        displayExpr: 'nome',
                        valueExpr: 'id'
                    },
                    groupIndex: 0, // Agrupa por setor
                },
                {
                    dataField: 'data_programada',
                    caption: 'Data Programada',
                    dataType: 'date',
                    alignment: 'center',
                },
                {
                    dataField: 'proxima_execucao',
                    caption: 'Proxima Execução',
                    sortIndex: 0, 
                    sortOrder: 'asc',
                    dataType: 'date',
                    alignment: 'center',
                },
                { 
                    dataField: 'periodicidade_dias', 
                    caption: 'Periodicidade (dias)', 
                    alignment: 'center',
                },
                { 
                    dataField: 'dias_aviso', 
                    caption: 'Dias Aviso', 
                    alignment: 'center',
                    visible: false
                },
                { dataField: 'info_servico', caption: 'Check-List', visible: false },
                { dataField: 'observacoes', caption: 'Observações Adicionais', visible: false },
                {
                    dataField: 'status_programacao',
                    caption: 'Status Programação',
                    alignment: 'center',
                },
                // Botões de ação na última coluna
                {
                    type: 'buttons',
                    width: 120,
                    buttons: [
                        'edit',
                        {
                            hint: 'Pausar Programação',
                            icon: 'fa fa-pause',
                            visible: function(e) {
                                return e.row.data.status_programacao === 'Ativa';
                            },
                            onClick: function(e) {
                                pausarProgramacao(e.row.data.id);
                            }
                        },
                        {
                            hint: 'Retomar Programação',
                            icon: 'fa fa-play',
                            visible: function(e) {
                                return e.row.data.status_programacao === 'Pausada'; // Só mostra se estiver Pausada
                            },
                            onClick: function(e) {
                                retomarProgramacao(e.row.data.id);
                            }
                        },
                        {
                            hint: 'Cancelar Programação',
                            icon: 'close',
                            onClick: function(e) {
                                cancelarProgramacao(e.row.data.id);
                            }
                        }
                    ]
                }
            ],
            onInitNewRow: function(e) {
                e.data.tipo_ordem_servico = null;
                // e.data.data_solicitacao = new Date();
                
                setTimeout(() => {
                    const form = $(".dx-popup-content .dx-form").dxForm("instance");
                    if (form) {
                        // form.updateData('data_solicitacao', new Date());
                        atualizarVisibilidadeForm(form);
                    }
                }, 100);
            },
            onEditingStart: function(e) {
                // Determina o tipo_ordem_servico baseado nos campos preenchidos
                const tipo = e.data.equipamento_id ? 'Equipamento' :
                            e.data.centro_custo_id ? 'Centro de Custo' : null;

                setTimeout(() => {
                    const form = $(".dx-popup-content .dx-form").dxForm("instance");

                    if (form) {
                        // Atualiza o valor diretamente no formData do formulário
                        const formData = form.option('formData');
                        formData.tipo_ordem_servico = tipo;

                        form.option('formData', formData); // força atualização visual

                        atualizarVisibilidadeForm(form);
                    }
                }, 100);
            },
            onEditorPreparing: function(e) {
                // Mantém a lógica original de equipamento_id
                if (e.dataField === 'equipamento_id' || e.dataField === 'centro_custo_id' || e.dataField === 'tipo_ordem_servico') {
                    if (e.row && e.row.isNewRow !== true) {
                        e.editorOptions.readOnly = true;
                        if (e.editorName === 'dxSelectBox') {
                            e.editorOptions.disabled = true;
                        }
                    } else {
                        e.editorOptions.readOnly = false;
                        if (e.editorName === 'dxSelectBox') {
                            e.editorOptions.disabled = false;
                        }
                    }
                }

                // Adicione esta parte para o campo tipo_ordem_servico
                if (e.dataField === 'tipo_ordem_servico' && e.parentType === 'dataRow') {
                    e.editorOptions.onValueChanged = function(args) {
                        // Atualiza o valor da célula corretamente
                        e.setValue(args.value);

                        const form = $(".dx-popup-content .dx-form").dxForm("instance");
                        if (form) {
                            // Atualiza valor no formData
                            form.option('formData.tipo_ordem_servico', args.value);

                            // Atualiza visibilidade e obrigatoriedade
                            atualizarVisibilidadeForm(form);
                        }
                    };
                }
            },
            onRowUpdating: function (e) {
                e.newData = { ...e.oldData, ...e.newData };
            },
            onRowPrepared: function (e) {
                if (e.rowType === 'data') {
                    const diasAviso = e.data.dias_aviso ? parseInt(e.data.dias_aviso) : 0;
                    const proximaExecucao = e.data.proxima_execucao ? new Date(e.data.proxima_execucao) : null;
                    const hoje = new Date();

                    if (diasAviso > 0 && proximaExecucao) {
                        const diffTime = proximaExecucao.getTime() - hoje.getTime();
                        const diffDias = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                        // Dentro do período de aviso (entre hoje e a data programada)
                        if (diffDias >= 0 && diffDias <= diasAviso) {
                            e.rowElement.css({ backgroundColor: '#F8D7DA', color: '#000' }); // Vermelho claro
                        }
                    }
                }
            },
            onToolbarPreparing: function (e) {
                // Aqui você pode personalizar ainda mais a barra de ferramentas
                var toolbarItems = e.toolbarOptions.items;
                // Adicionar os botões de expandir/colapsar
                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-expand",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.expandAll(); // Expande todos os grupos
                        }
                    }
                });

                toolbarItems.push({
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-compress",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.collapseAll(); // Colapsa todos os grupos
                        }
                    }
                });

                e.toolbarOptions.items.push({
                    name: "refresh", // Adiciona o botão refresh na toolbar
                    location: "after", // Coloca depois dos outros itens
                    widget: "dxButton",
                    options: {
                        icon: "refresh", // Ícone do botão (ícone de atualização)
                        onClick: function() {
                            // Recarrega os dados da grid
                            e.component.refresh(); // Atualiza a grid
                        },
                        text: "Atualizar" 
                    }
                });
            },   
        });
        
        // Função para atualizar a visibilidade dos campos
        function atualizarVisibilidadeForm(form) {
            const tipoOrdemServico = form.option('formData').tipo_ordem_servico;

            // Esconde e remove obrigatoriedade de ambos os campos
            form.itemOption('equipamento_id', {
                visible: false,
                validationRules: []
            });

            form.itemOption('centro_custo_id', {
                visible: false,
                validationRules: []
            });
            form.itemOption('setor_id', {
                visible: false,
            });

            // Mostra e adiciona obrigatoriedade ao campo correto
            if (tipoOrdemServico === 'Equipamento') {
                form.itemOption('equipamento_id', {
                    visible: true,
                    validationRules: [{ type: 'required', message: 'Campo obrigatório' }]
                });
            } else if (tipoOrdemServico === 'Centro de Custo') {
                form.itemOption('centro_custo_id', {
                    visible: true,
                    validationRules: [{ type: 'required', message: 'Campo obrigatório' }]
                });
                form.itemOption('setor_id', {
                    visible: true
                });
            }
        }
        function pausarProgramacao(id) {
            DevExpress.ui.dialog.confirm(
                "Deseja pausar esta programação? Enquanto pausada, não serão geradas novas OS.",
                "Confirmar Pausa"
            ).then(function(result) {
                if (result) {
                    $.ajax({
                        url: '/planejamento-controle-manutencao/pausar-programacao',
                        method: 'POST',
                        data: { id: id },
                        dataType: 'json'
                    }).then(function(response) {
                        if (response.success) {
                            DevExpress.ui.notify("Programação pausada com sucesso!", "success", 2000);
                            $("#gridProgramacaoPreventiva").dxDataGrid("instance").refresh();
                        } else {
                            DevExpress.ui.notify(response.message || "Erro ao pausar programação", "error", 3000);
                        }
                    });
                }
            });
        }
        function retomarProgramacao(id) {
            $.ajax({
                url: '/planejamento-controle-manutencao/retomar-programacao',
                method: 'POST',
                data: { id: id },
                dataType: 'json'
            }).then(function(response) {
                if (response.success) {
                    DevExpress.ui.notify("Programação retomada com sucesso!", "success", 2000);
                    $("#gridProgramacaoPreventiva").dxDataGrid("instance").refresh();
                } else {
                    DevExpress.ui.notify(response.message || "Erro ao retomar programação", "error", 3000);
                }
            });
        }
        function cancelarProgramacao(id) {
            const popupInstance = $("#popupCancelarProgramacao").dxPopup({
                title: "Cancelar Programação",
                visible: true,
                width: 400,
                height: 250,
                showCloseButton: true,
                dragEnabled: true,
                contentTemplate: function(contentElement) {
                    // Cria o textarea para o motivo
                    $("<textarea>")
                        .attr("id", "motivoCancelamento")
                        .attr("placeholder", "Digite o motivo do cancelamento...")
                        .css({
                            width: "100%",
                            height: "120px",
                            padding: "8px",
                            resize: "none",
                            boxSizing: "border-box"
                        })
                        .appendTo(contentElement);
                },
                toolbarItems: [
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Confirmar",
                            type: "default",
                            onClick: function() {
                                const motivo = $("#motivoCancelamento").val().trim();
                                if (!motivo) {
                                    DevExpress.ui.notify("Informe o motivo do cancelamento", "error", 2000);
                                    return;
                                }
                                
                                // Faz a requisição AJAX
                                $.ajax({
                                    url: '/planejamento-controle-manutencao/cancelar-programacao',
                                    method: 'POST',
                                    contentType: 'application/json',
                                    data: JSON.stringify({
                                        id: id,
                                        motivo_cancelamento: motivo
                                    }),
                                    dataType: 'json'
                                }).done(function(response) {
                                    if (response.success) {
                                        DevExpress.ui.notify("Programação cancelada!", "success", 2000);
                                        $("#gridProgramacaoPreventiva").dxDataGrid("instance").refresh();
                                        popupInstance.hide(); // Changed this line
                                    } else {
                                        DevExpress.ui.notify(response.message || "Erro no cancelamento", "error", 3000);
                                    }
                                }).fail(function() {
                                    DevExpress.ui.notify("Falha na requisição", "error", 3000);
                                });
                            }
                        }
                    },
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Cancelar",
                            onClick: function() {
                                popupInstance.hide(); // Changed this line
                            }
                        }
                    }
                ]
            }).dxPopup("instance");
        }

        // Função para SelectBox usada no editor de área técnica
        function getSelectBoxOptions(url, displayExpr, valueExpr, placeholder) {
            return {
                dataSource: new DevExpress.data.CustomStore({
                    loadMode: 'raw',
                    load: function () {
                        return $.ajax({
                            url: url,
                            method: 'GET',
                            dataType: 'json'
                        }).then(response => {
                            if (response.success) {
                                return response.data;
                            } else {
                                DevExpress.ui.notify(response.message, 'error', 3000);
                                return [];
                            }
                        }).catch(() => {
                            DevExpress.ui.notify('Erro ao buscar dados!', 'error', 3000);
                            return [];
                        });
                    }
                }),
                displayExpr: displayExpr,
                valueExpr: valueExpr,
                placeholder: placeholder,
                searchEnabled: true,
                showClearButton: true,
                onInitialized: function(e) {
                    const val = e.component.option('value');
                    e.component.option('value', val);
                }
            };
        }
    });
</script>
