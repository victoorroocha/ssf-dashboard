<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Planejamento e Controle da Manutenção</h1>
    </div>

    <!-- Content Row -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Approach -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <p>Controle de Retiradas Estoque</p>

                    <div id="gridRetiradaItens"></div>
                    <div id="popupTermoRetirada"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /.container-fluid -->

<script>
    $(document).ready(function() {
        let marcarRetiradaButton = null;

        let retiradasItensGrid = $('#gridRetiradaItens').dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: 'id',
                load: function(loadOptions) {
                    return $.ajax({
                        url: '/planejamento-controle-manutencao/listar-itens-pendentes',
                        method: 'GET',
                        dataType: 'json'
                    }).then(response => {
                        if (response.success) {
                            return {
                                data: response.data,
                                totalCount: response.totalCount || response.data.length
                            };
                        } else {
                            DevExpress.ui.notify(response.message, 'error', 3000);
                            return { data: [], totalCount: 0 };
                        }
                    }).catch(() => {
                        DevExpress.ui.notify('Erro ao carregar itens!', 'error', 3000);
                        return { data: [], totalCount: 0 };
                    });
                }
            }),
            keyExpr: 'id',
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "always",
                allowSelectAll: true
            },
            columnAutoWidth: true,
            width: '100%',
            height: 600,
            showBorders: true,
            groupPanel: { visible: true },
            grouping: {
                autoExpandAll: true // deixa todos os grupos fechados inicialmente
            },
            pager: { visible: true },
            paging: { pageSize: 500 },
            headerFilter: { visible: true },
            filterRow: { visible: true, applyFilter: 'auto' },
            export: {
                enabled: true,
                fileName: "Controle Retirada Estoque",
                allowExportSelectedData: false,
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: 'Procure...',
            },
            hoverStateEnabled: true,
            editing: {
                mode: 'batch',
                allowUpdating: false,
                allowAdding: false,
                allowDeleting: false,
                useIcons: true,
            },
            columns: [
                { dataField: 'nr_ordem_servico', caption: 'Ordem Serviço', groupIndex: 0 },
                { dataField: 'id', caption: 'Item ID', width: 100, alignment: 'center' },
                { dataField: 'cod_produto', caption: 'Código Produto', width: 120, alignment: 'center' },
                { dataField: 'descricao_produto', caption: 'Produto' },
                { dataField: 'cod_deposito', caption: 'Código Depósito', width: 120, alignment: 'center' },
                { dataField: 'descricao_deposito', caption: 'Depósito', alignment: 'center' },
                {
                    dataField: 'qtd_utilizada',
                    caption: 'Quantidade',
                    allowEditing: false,
                    alignment: 'center',
                    width: 120,
                    dataType: 'number',
                    format: { type: 'fixedPoint', precision: 4 },
                },
                {
                    dataField: 'custo_unitario',
                    caption: 'Custo Unitário',
                    allowEditing: false,
                    alignment: 'right',
                    width: 120,
                    dataType: 'number',
                    format: { type: 'currency', currency: 'BRL', precision: 4 },
                },
                {
                    dataField: 'custo_total',
                    caption: 'Custo Total',
                    allowEditing: false,
                    alignment: 'right',
                    width: 120,
                    dataType: 'number',
                    format: { type: 'currency', currency: 'BRL', precision: 4 },
                },
                {
                    dataField: 'flg_retirado',
                    caption: 'Retirado?',
                    alignment: 'center',
                    width: 120,
                },
            ],
            summary: {
                groupItems: [
                    {
                        column: 'custo_unitario',
                        summaryType: 'sum',
                        valueFormat: 'currency',
                        displayFormat: 'Total: {0}',
                        showInGroupFooter: true,
                        valueFormat: {
                            type: "currency",  
                            currency: "BRL" 
                        },
                        customizeText: function(cellInfo) {
                            // Verifica se o valor é válido antes de formatar
                            if (cellInfo.value !== undefined && cellInfo.value !== null) {
                                // Exibe o valor formatado como moeda brasileira
                                return 'R$ ' + cellInfo.value.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                            }
                            return '';
                        }
                    },
                    {
                        column: 'custo_total',
                        summaryType: 'sum',
                        valueFormat: 'currency',
                        displayFormat: 'Total: {0}',
                        showInGroupFooter: true,
                        valueFormat: {
                            type: "currency",  
                            currency: "BRL" 
                        },
                        customizeText: function(cellInfo) {
                            // Verifica se o valor é válido antes de formatar
                            if (cellInfo.value !== undefined && cellInfo.value !== null) {
                                // Exibe o valor formatado como moeda brasileira
                                return 'R$ ' + cellInfo.value.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                            }
                            return '';
                        }
                    },
                ],
            },
            // Atualiza estado do botão quando seleção muda
            onSelectionChanged: function(e) {
                const selectedKeys = e.component.getSelectedRowKeys() || [];
                if (marcarRetiradaButton) {
                    marcarRetiradaButton.option('disabled', selectedKeys.length === 0);
                }
            },
            // Prepara a toolbar e captura a instância do botão (onInitialized)
            onToolbarPreparing: function(e) {
                // Evita duplicar os botões caso onToolbarPreparing seja chamado novamente
                e.toolbarOptions.items = e.toolbarOptions.items.filter(function(item) {
                    return item.name !== 'marcarRetirada' && 
                        item.name !== 'expandAll' && 
                        item.name !== 'collapseAll' && 
                        item.name !== 'refresh';
                });
                
                // Botão Marcar Retirada
                e.toolbarOptions.items.unshift({
                    name: 'marcarRetirada',
                    location: "after",
                    widget: "dxButton",
                    options: {
                        text: "Marcar Retirada",
                        icon: "check",
                        type: "success",
                        disabled: true,
                        onInitialized: function(evt) {
                            marcarRetiradaButton = evt.component;
                            try {
                                const gridInstance = $('#gridRetiradaItens').dxDataGrid('instance');
                                const keys = gridInstance ? gridInstance.getSelectedRowKeys() : [];
                                marcarRetiradaButton.option('disabled', !keys || keys.length === 0);
                            } catch (err) {
                                // ignore
                            }
                        },
                        onClick: function() {
                            const grid = $('#gridRetiradaItens').dxDataGrid('instance');
                            const selectedRows = grid.getSelectedRowsData() || [];
                            const selectedIds = grid.getSelectedRowKeys() || [];

                            if (!selectedIds.length) {
                                DevExpress.ui.notify("Nenhum item selecionado!", "warning", 2000);
                                return;
                            }

                            DevExpress.ui.dialog.confirm(
                                `Deseja gerar o termo de retirada para ${selectedIds.length} item(ns)?`,
                                "Confirmação"
                            ).done(function(confirmed) {
                                if (!confirmed) return;
                                
                                openTermoRetiradaPopup(selectedRows);
                            });
                        }
                    }
                });

                // Botão Expandir Todos (mantido igual ao original)
                e.toolbarOptions.items.push({
                    name: 'expandAll',
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-expand",
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.expandAll(); // Expande todos os grupos
                        }
                    }
                });

                // Botão Colapsar Todos (mantido igual ao original)
                e.toolbarOptions.items.push({
                    name: 'collapseAll',
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "fa fa-compress", // Corrigi o nome do ícone de "compress"
                        text: "",
                        onClick: function () {
                            var grid = e.component;
                            grid.collapseAll(); // Colapsa todos os grupos
                        }
                    }
                });

                // Botão Atualizar
                e.toolbarOptions.items.push({
                    name: 'refresh',
                    location: "after",
                    widget: "dxButton",
                    options: {
                        icon: "refresh",
                        text: "Atualizar",
                        onClick: function() {
                            e.component.refresh(); // Atualiza a grid
                        }
                    }
                });
            },
            // garante estado inicial do botão quando o conteúdo estiver pronto
            onContentReady: function(e) {
                const keys = e.component.getSelectedRowKeys() || [];
                if (marcarRetiradaButton) {
                    marcarRetiradaButton.option('disabled', keys.length === 0);
                }
            }
        });


        // Adicione esta função para gerar o termo de retirada
        function openTermoRetiradaPopup(selectedItems) {
            // Agrupar itens por OS
            const itensPorOS = {};
            selectedItems.forEach(item => {
                if (!itensPorOS[item.nr_ordem_servico]) {
                    itensPorOS[item.nr_ordem_servico] = [];
                }
                itensPorOS[item.nr_ordem_servico].push(item);
            });

            let termoPopup = $('#popupTermoRetirada').dxPopup({
                width: 900,
                height: 'auto',
                title: 'Termo de Retirada de Materiais',
                dragEnabled: true,
                closeOnOutsideClick: false,
                position: {
                    of: window,
                    at: 'center',
                    my: 'center',
                },
                toolbarItems: [
                    {
                        widget: 'dxButton',
                        location: 'after',
                        toolbar: 'top',
                        options: {
                            icon: 'print',
                            hint: 'Imprimir',
                            type: 'default',
                            onClick: function() {
                                printTermoRetirada();
                            }
                        }
                    },
                    {
                        widget: 'dxButton',
                        location: 'after',
                        toolbar: 'top',
                        options: {
                            text: "Confirmar Retirada",
                            icon: "check",
                            type: "success",
                            onClick: function() {
                                confirmarRetirada(selectedItems);
                                termoPopup.hide();
                            }
                        }
                    },
                    {
                        widget: 'dxButton',
                        location: 'after',
                        toolbar: 'top',
                        options: {
                            text: "Cancelar",
                            icon: "close",
                            type: "danger",
                            onClick: function() {
                                termoPopup.hide();
                            }
                        }
                    }
                ],
                contentTemplate: function(contentElement) {
                    const scrollableContent = $("<div>").dxScrollView({
                        height: 'calc(80vh - 100px)',
                        showScrollbar: "onHover",
                        direction: "vertical",
                        scrollByContent: true
                    });

                    const termoContent = $('<div id="termoRetiradaContent" style="font-family: Arial, sans-serif;"></div>');

                    // Criar uma página separada para cada OS
                    Object.keys(itensPorOS).forEach((osNumber) => {
                        const itensOS = itensPorOS[osNumber];
                        
                        const osPage = $(`
                            <div class="os-page" style="padding: 20px; page-break-after: always;">
                                <div style="text-align: center; margin-bottom: 20px;">
                                    <h2>TERMO DE RETIRADA DE MATERIAIS - OS: ${osNumber}</h2>
                                    <p>Data: ${new Date().toLocaleDateString('pt-BR')}</p>
                                </div>
                                
                                <div style="margin-bottom: 20px;">
                                    <p><strong>Responsável por gerar Requisição: </strong> <?php echo $this->usuarioSessaoNome ?></p>
                                </div>
                                
                                <div style="margin-bottom: 20px;">
                                    <h3>Itens Retirados:</h3>
                                    <table style="width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px;">
                                        <thead>
                                            <tr style="background-color: #f8f9fa;">
                                                <th style="border: 1px solid #000; padding: 8px;">Código</th>
                                                <th style="border: 1px solid #000; padding: 8px;">Descrição</th>
                                                <th style="border: 1px solid #000; padding: 8px;">Quantidade</th>
                                            </tr>
                                        </thead>
                                        <tbody id="termo-os-${osNumber}-body"></tbody>
                                    </table>
                                </div>
                                
                                <div style="margin-top: 40px;">
                                    <div style="display: flex; justify-content: space-between;">
                                        <div style="width: 45%; text-align: center;">
                                            <p>_________________________________________</p>
                                            <p><strong>Responsável pelo Almoxarifado</strong></p>
                                        </div>
                                        <div style="width: 45%; text-align: center;">
                                            <p>_________________________________________</p>
                                            <p><strong>Responsável pela Retirada</strong></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `);

                        // Preencher itens desta OS
                        const tbody = osPage.find(`#termo-os-${osNumber}-body`);
                        itensOS.forEach(item => {
                            const row = `
                                <tr>
                                    <td style="border: 1px solid #000; padding: 6px;">${item.cod_produto}</td>
                                    <td style="border: 1px solid #000; padding: 6px;">${item.descricao_produto}</td>
                                    <td style="border: 1px solid #000; padding: 6px; text-align: right;">${parseFloat(item.qtd_utilizada).toFixed(4)}</td>
                                </tr>
                            `;
                            tbody.append(row);
                        });

                        termoContent.append(osPage);
                    });

                    scrollableContent.find('.dx-scrollview-content').append(termoContent);
                    contentElement.append(scrollableContent);
                }
            }).dxPopup('instance');

            termoPopup.show();
        }

        // Função para imprimir o termo
        function printTermoRetirada() {
            const printArea = document.getElementById('termoRetiradaContent');
            if (!printArea) return;

            const iframe = document.createElement('iframe');
            iframe.style.position = 'fixed';
            iframe.style.right = '0';
            iframe.style.bottom = '0';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = '0';
            document.body.appendChild(iframe);

            const doc = iframe.contentWindow.document;
            
            doc.open();
            doc.write(`
                <html>
                    <head>
                        <title>Termo de Retirada</title>
                        <style>
                            body { 
                                font-family: Arial, sans-serif; 
                                margin: 0;
                                padding: 0;
                            }
                            .os-page {
                                padding: 20px;
                                page-break-after: always;
                                height: 100vh;
                                box-sizing: border-box;
                            }
                            table { 
                                width: 100%; 
                                border-collapse: collapse; 
                            }
                            th, td { 
                                border: 1px solid #000; 
                                padding: 8px; 
                            }
                            th {
                                background-color: #f8f9fa;
                            }
                            @media print {
                                body { 
                                    margin: 0; 
                                    padding: 0;
                                }
                                .os-page {
                                    padding: 15mm;
                                    page-break-after: always;
                                }
                            }
                        </style>
                    </head>
                    <body>${printArea.innerHTML}</body>
                </html>
            `);
            doc.close();

            iframe.onload = function() {
                iframe.contentWindow.focus();
                iframe.contentWindow.print();
                setTimeout(() => document.body.removeChild(iframe), 1000);
            };
        }

        // Função para confirmar a retirada após impressão do termo
        function confirmarRetirada(selectedItems) {
            const selectedIds = selectedItems.map(item => item.id);
            
            $.ajax({
                url: '/planejamento-controle-manutencao/marcar-retirada',
                method: 'POST',
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: JSON.stringify({ ids: selectedIds })
            }).done(function(resp) {
                if (resp && resp.success) {
                    DevExpress.ui.notify("Itens marcados como retirados!", "success", 2000);
                    const grid = $('#gridRetiradaItens').dxDataGrid('instance');
                    grid.clearSelection();
                    grid.refresh();
                    if (marcarRetiradaButton) marcarRetiradaButton.option('disabled', true);
                } else {
                    DevExpress.ui.notify((resp && resp.message) || "Erro ao marcar retirada!", "error", 3000);
                }
            }).fail(function() {
                DevExpress.ui.notify("Erro na requisição!", "error", 3000);
            });
        }
    });
</script>
